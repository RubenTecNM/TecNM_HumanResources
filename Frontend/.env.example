# REST (CRUD /api/*) is protected by X-API-KEY in the backend (ApiKeyAuthorizeAttribute).
# Create a key in the system (Menu Administración -> API Keys) and set it here.
# The key is sent as the X-API-KEY header on every request.
VITE_API_KEY=your_api_key_here

# (Optional) Backend base when not using the vite proxy.
# VITE_API_BASE=/