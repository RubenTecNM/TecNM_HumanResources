@using HumanResourcesProduction.Models.DTOs
@using HumanResourcesProduction.Models.ViewModels
@using X.PagedList
@using X.PagedList.Mvc.Core

@model SearchPermissionsViewModel

@{
    ViewData["Title"] = "Gestión de Permisos";
}

@section Styles {

}

<div class="permisos-container">
    <!-- Header Section -->
    <div class="page-header fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-calendar-alt"></i>
                Gestión de Permisos
            </h1>
            <p class="page-subtitle">Administra y supervisa los permisos del personal</p>
        </div>
        <authorize-section policy="!AutorizadorOnly">
            <div class="header-actions">
                <a asp-action="Create" class="btn btn-primary btn-create">
                    <i class="fas fa-plus"></i>
                    Nuevo Permiso
                </a>
            </div>
        </authorize-section>
    </div>

    <!-- Filters Section -->
    <div class="filters-section slide-in-left">
        <div class="card filter-card-premium">
            <div class="filter-header-premium">
                <i class="fas fa-filter fa-lg"></i>
                <h5 class="m-0 fw-bold" style="letter-spacing: 0.5px;">Panel de Búsqueda</h5>
            </div>
            <div class="filter-body-premium">
                <form id="searchForm" method="get" asp-action="GetPermisos">
                    @Html.AntiForgeryToken()
                    <div class="row g-4">
                        <!-- Date Filters -->
                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-success small text-uppercase mb-2 ms-2">Desde el</label>
                                <input type="date" id="toDay" name="toDay" class="form-control filter-input-pill" value="@ViewBag.Today" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-danger small text-uppercase mb-2 ms-2">Hasta el</label>
                                <input type="date" id="fromDay" name="fromDay" class="form-control filter-input-pill" value="@ViewBag.FromDay" />
                            </div>
                        </div>

                        <authorize-section policy="AutorizadorOrAbove">
                            <!-- User Filter -->
                            <div class="col-md-3" id="userFilterContainer">
                                <div class="filter-group">
                                    <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Usuario</label>
                                    <select id="userName" name="userName" class="form-control user-autocomplete w-100" data-user-value="text">
                                        <option value="">-- Seleccionar Usuario --</option>
                                        @foreach (var user in Model.Users)
                                        {
                                            <option value="@(user.Name ?? "")" data-area-id="@user.AreaId" selected="@(user.Name == Model.SelectedUser ? "selected" : null)">@(user.Name ?? "")</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </authorize-section>

                        <authorize-section policy="RHOrAdmin">
                            <!-- Area Filter -->
                            <div class="col-md-3" id="areaFilterContainer">
                                <div class="filter-group">
                                    <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Área</label>
                                    <select id="areaId" name="areaId" class="form-control filter-input-pill form-select">
                                        <option value="">-- Seleccionar Área --</option>
                                        @foreach (var area in Model.Areas)
                                        {
                                            <option value="@area.Id" selected="@(area.Id == Model.SelectedArea ? "selected" : null)">@area.Description</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </authorize-section>
                    </div>

                    <!-- Permission Type Filters -->
                    <div class="row mt-4 pt-3 border-top">
                        <div class="col-md-8">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-3 ms-2 d-block">Tipo de Permiso</label>
                                <div class="d-flex flex-wrap gap-2">
                                    <div class="form-check-premium">
                                        <input type="radio" id="rbNone" name="permissionTypeId" value="" @(string.IsNullOrEmpty(ViewBag.SelectedType) ? "checked" : "") class="btn-check" />
                                        <label class="btn btn-outline-primary rounded-pill px-3" for="rbNinguno">Todos</label>
                                    </div>
                                    <div class="form-check-premium">
                                        <input type="radio" id="rbAbsence" name="permissionTypeId" value="2" @(ViewBag.SelectedType == "2" ? "checked" : "") class="btn-check" />
                                        <label class="btn btn-outline-primary rounded-pill px-3" for="rbFalta">Falta</label>
                                    </div>
                                    <div class="form-check-premium">
                                        <input type="radio" id="rbLate" name="permissionTypeId" value="3" @(ViewBag.SelectedType == "3" ? "checked" : "") class="btn-check" />
                                        <label class="btn btn-outline-primary rounded-pill px-3" for="rbRetardo">Retardo</label>
                                    </div>
                                    <div class="form-check-premium">
                                        <input type="radio" id="rbScheduleChange" name="permissionTypeId" value="4" @(ViewBag.SelectedType == "4" ? "checked" : "") class="btn-check" />
                                        <label class="btn btn-outline-primary rounded-pill px-3" for="rbCambioDeTurno">Cambio de Turno</label>
                                    </div>
                                    <div class="form-check-premium">
                                        <input type="radio" id="rbShiftByShift" name="permissionTypeId" value="5" @(ViewBag.SelectedType == "5" ? "checked" : "") class="btn-check" />
                                        <label class="btn btn-outline-primary rounded-pill px-3" for="rbTurnoPorTurno">Turno por Turno</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Search and Clear Buttons -->
                        <div class="col-md-4 d-flex align-items-end justify-content-end gap-3 mt-3 mt-md-0">
                            <button type="button" id="btnClear" class="btn btn-light rounded-pill px-4 fw-bold text-secondary border hover-shadow" style="transition: all 0.2s;">
                                <i class="fas fa-undo me-2"></i> Limpiar
                            </button>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" 
                                    style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); border: none;">
                                <i class="fas fa-search me-2"></i> Buscar
                            </button>
                        </div>
                    </div>

                    <!-- Hidden Inputs for Pagination -->
                    <input type="hidden" id="pageNumber" name="pageNumber" value="1" />
                    <input type="hidden" id="pageSize" name="pageSize" value="5" />
                </form>
            </div>
        </div>
    </div>

                <!-- Error Message Display -->
                @if (ViewData["ErrorMessage"] != null)
                {
                    <div class="error-message text-danger">@ViewData["ErrorMessage"]</div>
                }

    <!-- Stats Cards -->
    <div class="stats-grid fade-in">
        <div class="stat-card stat-total">
            <div class="stat-icon">
                <i class="fas fa-file-alt"></i>
            </div>
            <div class="stat-content">
                <h3 id="totalPermisos">@Model.Permissions?.Count()</h3>
                <p>Total</p>
            </div>
        </div>
        <div class="stat-card stat-pending">
            <div class="stat-icon">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
                <h3 id="pendingPermisos">@Model.Permissions?.Count(p => p.Status && p.AuthorizedAt == null)</h3>
                <p>Pendientes</p>
            </div>
        </div>
        <div class="stat-card stat-approved">
            <div class="stat-icon">
                <i class="fas fa-check"></i>
            </div>
            <div class="stat-content">
                <h3 id="approvedPermisos">@Model.Permissions?.Count(p => p.AuthorizedAt != null)</h3>
                <p>Aprobados</p>
            </div>
        </div>
        <div class="stat-card stat-rejected">
            <div class="stat-icon">
                <i class="fas fa-times"></i>
            </div>
            <div class="stat-content">
                <h3 id="rejectedPermisos">@Model.Permissions?.Count(p => !p.Status)</h3>
                <p>Rechazados</p>
            </div>
        </div>
    </div>

    <!-- Permisos Grid -->
    <div class="permisos-grid" id="permisosGrid">
        @foreach (var item in Model.Permissions ?? Enumerable.Empty<PermissionsDTO>())
        {
            var status = item.Status ? (item.AuthorizedAt == null ? "Pendiente" : "Aprobado") : "Rechazado";
            var statusClass = status switch
            {
                "Pendiente" => "status-pending",
                "Aprobado" => "status-approved",
                "Rechazado" => "status-rejected",
                _ => ""
            };
            var permissionType = item.PermissionTypeId switch
            {
                2 => ("Falta", "fa-user-clock"),
                3 => ("Retardo", "fa-clock"),
                4 => ("Cambio de Horario", "fa-exchange-alt"),
                5 => ("Turno por Turno", "fa-exchange-alt"),
                _ => ("Desconocido", "fa-question")
            };

            var config = new Dictionary<int, (bool showFecha1, string labelFecha1, bool showFecha2, string labelFecha2, bool showHora1, string labelHora1, bool showHora2, string labelHora2)>
            {
                [2] = (true, "Del día", true, "Al día", false, "Hora entrada", false, "Hora salida"),
                [3] = (true, "En el día", false, "Al día", true, "Hora de entrada", false, "Hora salida"),
                [4] = (true, "Del día", true, "Al día", true, "Hora entrada", true, "Hora salida"),
                [5] = (true, "Del día", true, "Por el día", true, "Hora entrada", true, "Hora salida")
            };

            var (showFecha1, labelFecha1, showFecha2, labelFecha2, showHora1, labelHora1, showHora2, labelHora2) = config[item.PermissionTypeId];

            // Cloudflare-inspired varied palette for avatars
            var nameForAvatar = item.Name ?? "Usuario";
            var colorIndex = item.Id % 5;
            var boxGradient = "";
            
            switch (colorIndex) {
                case 0: boxGradient = "linear-gradient(135deg, #6366f1, #4338ca)"; break; // Indigo
                case 1: boxGradient = "linear-gradient(135deg, #10b981, #059669)"; break; // Emerald
                case 2: boxGradient = "linear-gradient(135deg, #f59e0b, #d97706)"; break; // Amber
                case 3: boxGradient = "linear-gradient(135deg, #f43f5e, #e11d48)"; break; // Rose
                case 4: boxGradient = "linear-gradient(135deg, #0ea5e9, #0284c7)"; break; // Sky
            }
            <div class="permiso-card" data-status="@status" data-type="@item.PermissionTypeId">
                <!-- Card Header -->
                <div class="card-header">
                    <div class="employee-info">
                        <div class="employee-avatar shadow-sm" style="background: @boxGradient; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.25rem;">
                            @(nameForAvatar.Length > 0 ? nameForAvatar.Substring(0, 1).ToUpper() : "U")
                        </div>
                        <div class="employee-details">
                            <h3>@(item.Name ?? "Sin Nombre")</h3>
                            <div class="employee-id">ID: @(item.RequestingUserId.ToString() ?? "Sin ID")</div>
                        </div>
                    </div>
                    <div class="header-badges">
                        <div class="status-badge @statusClass">
                            <i class="fas @(status == "Pendiente" ? "fa-clock" : status == "Aprobado" ? "fa-check-circle" : "fa-times-circle")"></i>
                            @status
                        </div>
                        @if (!string.IsNullOrEmpty(item.Evidence))
                        {
                            <a href="@Url.Action("GetEvidence", "Permission", new { id = item.Id })" target="_blank" class="pdf-attachment has-pdf">
                                <i class="fas fa-file-pdf pdf-icon"></i>
                                PDF
                            </a>
                        }
                        else
                        {
                            <div class="pdf-attachment no-pdf">
                                <i class="fas fa-file-pdf pdf-icon"></i>
                                Sin PDF
                            </div>
                        }
                    </div>
                </div>
                <!-- Card Body -->
                <div class="card-body">
                    <div class="permission-type-header">
                        <div class="type-icon">
                            <i class="fas @permissionType.Item2"></i>
                        </div>
                        <div class="type-details">
                            <h4>@permissionType.Item1</h4>
                        </div>
                    </div>
                    <div class="permission-details">
                        <!-- Fechas -->
                        <div class="detail-row">
                            @if (showFecha1 && item.StartDate.HasValue)
                            {
                                <div class="detail-item">
                                    <label>@labelFecha1:</label>
                                    <span class="date-value">@item.StartDate.Value.ToString("dddd dd \\de MMMM \\del yyyy")</span>
                                    @if (showHora1 && item.StartDate.Value.TimeOfDay != TimeSpan.Zero)
                                    {
                                        <div class="time-display">
                                            @{
                                                var hours = item.StartDate.Value.Hour.ToString("D2");
                                                var minutos = item.StartDate.Value.Minute.ToString("D2");
                                                var periodo = item.StartDate.Value.Hour < 12 ? "AM" : "PM";
                                            }
                                            <span class="time-digit">@hours[0]</span>
                                            <span class="time-digit">@hours[1]</span>
                                            <span class="time-separator">:</span>
                                            <span class="time-digit">@minutos[0]</span>
                                            <span class="time-digit">@minutos[1]</span>
                                            <span class="time-period">@periodo</span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (showFecha2 && item.EndDate != null)
                            {
                                <div class="detail-item">
                                    <label>@labelFecha2:</label>
                                    <span class="date-value">@(item.EndDate.Value.ToString("dddd dd \\de MMMM \\del yyyy"))</span>
                                    @if (showHora2 && item.EndDate.Value.TimeOfDay != TimeSpan.Zero)
                                    {
                                        <div class="time-display">
                                            @{
                                                var endHours = item.EndDate.Value.Hour.ToString("D2");
                                                var minutos2 = item.EndDate.Value.Minute.ToString("D2");
                                                var periodo2 = item.EndDate.Value.Hour < 12 ? "AM" : "PM";
                                            }
                                            <span class="time-digit">@endHours[0]</span>
                                            <span class="time-digit">@endHours[1]</span>
                                            <span class="time-separator">:</span>
                                            <span class="time-digit">@minutos2[0]</span>
                                            <span class="time-digit">@minutos2[1]</span>
                                            <span class="time-period">@periodo2</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <!-- Días y Goce -->
                        <div class="detail-row">
                            <div class="detail-item">
                                <label>Días solicitados:</label>
                                <span class="days-badge">@(item.Days ?? 0)</span>
                            </div>
                            <div class="detail-item">
                                <label>Goce de pago:</label>
                                <span class="goce-badge goce-@(item.WithPay ? "si" : "no")">
                                    @(item.WithPay ? "Con goce" : "Sin goce")
                                </span>
                            </div>
                        </div>
                        <!-- Motivo -->
                        @if (!string.IsNullOrEmpty(item.Reason))
                        {
                            <div class="detail-row full-width">
                                <div class="detail-item">
                                    <label>Motivo de incidencia:</label>
                                    <p class="motivo-text">@item.Reason</p>
                                </div>
                            </div>
                        }
                        <!-- Fechas del Sistema -->
                        <div class="system-dates">
                            <strong>Creado:</strong> @item.CreatedAt.ToString("dddd dd \\de MMMM \\del yyyy \\a \\las HH:mm")
                            @if (item.AuthorizedAt != null)
                            {
                                <br>
                                <strong>Autorizado:</strong>
                                @item.AuthorizedAt?.ToString("dddd dd \\de MMMM \\del yyyy \\a \\las HH:mm")
                            }
                            @if (item.UpdatedAt != null)
                            {
                                <br>
                                <strong>Modificado:</strong>
                                @item.UpdatedAt?.ToString("dddd dd \\de MMMM \\del yyyy \\a \\las HH:mm")
                            }
                        </div>
                    </div>
                </div>
                <!-- Card Footer -->
                <div class="card-footer">
                    <div class="action-buttons">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">
                            <i class="fas fa-eye"></i> Ver
                        </a>
                        <authorize-section policy="!AutorizadorOnly">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                        </authorize-section>
                    </div>
                </div>
            </div>
        }
    </div>


    <!-- Empty State -->
    @if (!(Model.Permissions?.Any() ?? false))
    {
        <div class="empty-state fade-in">
            <div class="empty-icon">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <h3>No hay permisos registrados</h3>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/dist/sweetalert2.min.js"></script>
    <script>
        $(document).ready(function() {
            // Initialize Select2 for User Filter
            $('#userName').select2({
                placeholder: '-- Seleccionar Usuario --',
                minimumInputLength: 2,
                allowClear: true,
                ajax: {
                    url: '/User/SearchUsers',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { term: params.term }; },
                    processResults: function (data) { return { results: data }; },
                    cache: true
                }
            });

            // Initialize Select2 for Area Filter
            $('#areaId').select2({
                placeholder: '-- Seleccionar Área --',
                width: '100%',
                allowClear: true,
                minimumResultsForSearch: Infinity
            });

            // Handle Clear Filters button
            $('#btnClear').on('click', function() {
                $('#userName').val(null).trigger('change');
                $('#areaId').val(null).trigger('change');
                $('input[name="permissionTypeId"]').prop('checked', false);
                $('#rbNone').prop('checked', true);
                $('#toDay').val('');
                $('#fromDay').val('');
                $('#searchForm').submit();
            });
        });
    </script>
}