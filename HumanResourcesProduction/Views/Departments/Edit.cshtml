@model HumanResourcesProduction.Models.ViewModels.Departments.DepartmentUpdateViewModel
@{ ViewData["Title"] = "Editar Departamento"; }

<div class="index-container fade-in">
    <div class="page-header-v2"><div class="header-content"><h1 class="page-title text-gradient"><i class="fas fa-edit"></i>Editar Departamento</h1><p class="page-subtitle">Actualiza el nombre del departamento</p></div></div>
    <div class="card details-card shadow-lg rounded-3 overflow-hidden mb-5"><div class="card-body p-0 bg-white">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
            <div class="form-section"><div class="section-header"><h3><i class="fas fa-building"></i>Información del Departamento</h3><span class="section-indicator">1</span></div>
                <div class="row g-4"><div class="col-md-8 form-group"><label asp-for="Description" class="form-label">Nombre del departamento</label><div class="input-wrapper"><i class="fas fa-sitemap input-icon"></i><input asp-for="Description" class="form-control-v2" maxlength="50" /></div><span asp-validation-for="Description" class="text-danger small"></span></div></div>
            </div>
            <div class="form-actions"><a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold text-secondary border"><i class="fas fa-arrow-left me-2"></i>Cancelar</a><button type="submit" class="btn btn-primary px-5 py-2 rounded-pill shadow-sm fw-bold"><i class="fas fa-save me-2"></i>Guardar Cambios</button></div>
        </form>
    </div></div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
