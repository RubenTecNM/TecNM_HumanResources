@model HumanResourcesProduction.Models.ViewModels.ResetPassword.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contrase&ntilde;a";
}

<div class="index-container">
    <!-- Page Header (Premium Style) -->
    <div class="permission-header fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-lock"></i>
                Restablecer Contrase&ntilde;a
            </h1>
            <p class="page-subtitle">Define tu nueva clave de acceso al sistema institucional</p>
        </div>
    </div>

    <!-- Formulario (Cloudflare-Inspired Card) -->
    <div class="filters-section slide-in-left">
        <div class="card filter-card-premium shadow-lg border-0">
            <div class="filter-header-premium d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 overflow-hidden">
                    <i class="fas fa-key fa-lg"></i>
                    <h5 class="m-0 fw-bold text-truncate" style="letter-spacing: 0.5px; text-transform: uppercase;">Seguridad</h5>
                </div>
                <!-- Icono animado -->
                <div class="status-glass rounded-pill d-flex align-items-center gap-2 px-2 px-sm-3 py-1 flex-shrink-0" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(4px);">
                    <span class="status-dot dot-active" style="animation: icon-pulse-soft 2s infinite ease-in-out;"></span>
                    <span class="small uppercase tracking-wide fw-bold d-none d-sm-inline" style="font-size: 0.7rem;">Actualizando</span>
                    <span class="small fw-bold d-inline d-sm-none" style="font-size: 0.6rem;">SSL</span>
                </div>
            </div>

            <div class="filter-body-premium p-3 p-sm-4">
                <form asp-action="ResetPassword" method="post" class="ajax-form" id="resetPasswordForm" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Selector" />
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div class="row g-3">
                        <!-- Nueva Contrasena -->
                        <div class="col-12 col-md-6">
                            <div class="filter-group">
                                <label asp-for="NewPassword" class="fw-bold text-muted small text-uppercase mb-2 ms-2 d-block">
                                    &#128274; Nueva Contrase&ntilde;a
                                </label>
                                <div class="position-relative">
                                    <input asp-for="NewPassword" 
                                           type="password" 
                                           class="form-control rounded-pill pe-5 shadow-sm" 
                                           id="password-input" 
                                           placeholder="Nueva contrase&ntilde;a" 
                                           minlength="6" maxlength="12" 
                                           style="height: 52px; border: 2px solid #ced4da;" />
                                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="toggle-password-1">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <div class="progress mt-2 rounded-pill" style="height: 6px; background: #e2e8f0;">
                                    <div id="password-strength" class="progress-bar transition-all" role="progressbar" style="width: 0%; border-radius: 50px;"></div>
                                </div>
                                <small class="text-muted d-block mt-1 ms-2" style="font-size: 0.75rem;">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Entre 6 y 12 caracteres.
                                </small>
                                <span asp-validation-for="NewPassword" class="text-danger small ms-2 fw-semibold"></span>
                            </div>
                        </div>

                        <!-- Confirmar Contrasena -->
                        <div class="col-12 col-md-6">
                            <div class="filter-group">
                                <label asp-for="ConfirmPassword" class="fw-bold text-muted small text-uppercase mb-2 ms-2 d-block">
                                    &#9989; Confirmar Contrase&ntilde;a
                                </label>
                                <div class="position-relative">
                                    <input asp-for="ConfirmPassword" 
                                           type="password" 
                                           class="form-control rounded-pill pe-5 shadow-sm" 
                                           id="confirm-input" 
                                           placeholder="Confirma la contrase&ntilde;a" 
                                           minlength="6" maxlength="12" 
                                           style="height: 52px; border: 2px solid #ced4da;" />
                                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="toggle-password-2">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small ms-2 fw-semibold"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Acciones -->
                    <div class="d-flex flex-column gap-3 mt-4 mt-sm-5">
                        <button type="submit" class="btn btn-primary rounded-pill w-100 fw-bold shadow-sm" id="submitBtn"
                                style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); border: none; height: 52px;">
                            <i class="fas fa-save me-2"></i>
                            Establecer Contrase&ntilde;a
                        </button>
                        <div class="text-center">
                            <a asp-action="RequestToken" class="text-primary fw-bold text-decoration-none small hover-link d-inline-flex align-items-center">
                                <i class="fas fa-times me-2"></i>
                                Cancelar
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes icon-pulse-soft {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.7; }
    }
    .hover-link:hover {
        text-decoration: underline !important;
        opacity: 0.8;
    }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/lib/sweetalert2/dist/sweetalert2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const togglePassword1 = document.getElementById('toggle-password-1');
            const togglePassword2 = document.getElementById('toggle-password-2');
            const passwordInput = document.getElementById('password-input');
            const confirmInput = document.getElementById('confirm-input');
            const passwordStrength = document.getElementById('password-strength');
            
            function togglePassword(btn, input) {
                const icon = btn.querySelector('i');
                const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                input.setAttribute('type', type);
                icon.classList.toggle('fa-eye');
                icon.classList.toggle('fa-eye-slash');
            }

            if (togglePassword1) togglePassword1.addEventListener('click', () => togglePassword(togglePassword1, passwordInput));
            if (togglePassword2) togglePassword2.addEventListener('click', () => togglePassword(togglePassword2, confirmInput));

            if (passwordInput && passwordStrength) {
                passwordInput.addEventListener('input', function() {
                    const val = this.value;
                    let strength = 0;
                    if (val.length >= 6) strength += 33;
                    if (val.length >= 9) strength += 33;
                    if (/[A-Z]/.test(val) && /[0-9]/.test(val)) strength += 34;
                    
                    passwordStrength.style.width = strength + '%';
                    if (strength < 40) passwordStrength.style.backgroundColor = '#ef4444';
                    else if (strength < 80) passwordStrength.style.backgroundColor = '#f59e0b';
                    else passwordStrength.style.backgroundColor = '#10b981';
                });
            }

            const form = document.getElementById('resetPasswordForm');
            if (form) {
                form.addEventListener('submit', function(e) {
                    if (passwordInput.value !== confirmInput.value) {
                        e.preventDefault();
                        Swal.fire({
                            icon: 'error',
                            title: 'Error de Coincidencia',
                            text: 'Las contraseñas no coinciden.',
                            confirmButtonColor: '#3B82F6',
                            customClass: {
                                popup: 'rounded-4 shadow-lg'
                            }
                        });
                        return false;
                    }
                });
            }

            // Animacion
            const elements = document.querySelectorAll('.fade-in, .slide-in-left');
            elements.forEach(element => {
                element.style.opacity = '0';
                element.style.transform = 'translateY(20px)';
            });
            setTimeout(() => {
                elements.forEach((element, index) => {
                    setTimeout(() => {
                        element.style.transition = 'all 0.6s ease-out';
                        element.style.opacity = '1';
                        element.style.transform = 'translate(0, 0)';
                    }, index * 100);
                });
            }, 100);
        });
    </script>
}
