@model RecursosHumanosWeb.Models.ViewModels.PermissionsCreateViewModel
@{
    ViewData["Title"] = "Modificar Permiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/cssv2/views/permisos/create.css" asp-append-version="true" />
}

<div class="permission-request-container">
    <div class="page-header-v2 fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-edit"></i>
                Modificar Permiso
            </h1>
            <p class="page-subtitle">Actualice los detalles de su solicitud</p>
        </div>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="permission-form ajax-form" id="editPermissionForm"
          data-permission-type="@Model.PermissionTypeId">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="RequestingUserId" />
        <input type="hidden" asp-for="PermissionTypeId" />
        <input type="hidden" asp-for="StartDate" />
        <input type="hidden" asp-for="EndDate" />

        <div class="form-sections">
            <!-- Sección: Tipo de Permiso (Ahora EDITABLE) -->
            <div class="form-section">
                <div class="section-header">
                    <h3><i class="fas fa-list-ul"></i> Tipo de Permiso</h3>
                    <span class="section-indicator">1</span>
                </div>
                <div class="permission-types readonly-mode">
                    @{
                        var typeList = ViewBag.PermissionTypeList as IEnumerable<RecursosHumanosWeb.Models.PermissionType> ?? new List<RecursosHumanosWeb.Models.PermissionType>();
                        var typeConfigs = ViewBag.PermissionTypeConfigs as Dictionary<int, RecursosHumanosWeb.Controllers.PermissionController.PermissionTypeCardConfig> ?? new Dictionary<int, RecursosHumanosWeb.Controllers.PermissionController.PermissionTypeCardConfig>();
                        var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
                    }
                    @foreach (var type in typeList)
                    {
                        if (type.Id != Model.PermissionTypeId) { continue; }
                        var typeConfig = typeConfigs.TryGetValue(type.Id, out var cfg) ? cfg : null;
                        <div class="permission-type-card selected" data-type="@type.Id"
                             data-config="@(typeConfig != null ? System.Text.Json.JsonSerializer.Serialize((object)typeConfig, jsonOptions) : null)">
                            <input type="radio" id="pt-@type.Id" name="PermissionTypeId" value="@type.Id" asp-for="PermissionTypeId" disabled checked>
                            <label for="pt-@type.Id" class="type-label">
                                <div class="type-icon">
                                    <i class="fas @(typeConfig?.Icon ?? "fa-file-alt")"></i>
                                </div>
                                <h4>@type.Description</h4>
                                <p>@(typeConfig?.Subtitle ?? "Permiso de tipo " + type.Description)</p>
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="PermissionTypeId" class="text-danger validation-message"></span>
            </div>

            <!-- Sección: Fechas y Horarios -->
            <div class="form-section" id="datetime-section">
                <div class="section-header">
                    <h3><i class="fas fa-calendar-alt"></i> Fechas y Horarios</h3>
                    <span class="section-indicator">2</span>
                </div>
                <div class="datetime-grid">
                    <div class="form-group" id="date1-group">
                        <label asp-for="StartDateOnly" class="form-label">
                            <span id="date1-label">Fecha de inicio</span>
                            <span class="required">*</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-calendar input-icon"></i>
                            <input asp-for="StartDateOnly" type="date" class="form-control" placeholder="DD/MM/YYYY" asp-format="{0:yyyy-MM-dd}" />
                        </div>
                        <span asp-validation-for="StartDateOnly" class="text-danger validation-message"></span>
                    </div>
                    <div class="form-group" id="date2-group">
                        <label asp-for="EndDateOnly" class="form-label">
                            <span id="date2-label">Fecha de fin</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-calendar input-icon"></i>
                            <input asp-for="EndDateOnly" type="date" class="form-control" placeholder="DD/MM/YYYY" asp-format="{0:yyyy-MM-dd}" />
                        </div>
                        <span asp-validation-for="EndDateOnly" class="text-danger validation-message"></span>
                    </div>
                    <div class="form-group" id="time1-group">
                        <label asp-for="StartTime" class="form-label">
                            <span id="time1-label">Hora de entrada</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-clock input-icon"></i>
                            <input asp-for="StartTime" type="time" class="form-control" placeholder="HH:MM AM/PM" />
                        </div>
                        <span asp-validation-for="StartTime" class="text-danger validation-message"></span>
                    </div>
                    <div class="form-group" id="time2-group">
                        <label asp-for="EndTime" class="form-label">
                            <span id="time2-label">Hora de salida</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-clock input-icon"></i>
                            <input asp-for="EndTime" type="time" class="form-control" placeholder="HH:MM AM/PM" />
                        </div>
                        <span asp-validation-for="EndTime" class="text-danger validation-message"></span>
                    </div>
                </div>
            </div>

            <!-- Sección: Motivo -->
            <div class="form-section" id="reason-section">
                <div class="section-header">
                    <h3><i class="fas fa-comment-alt"></i> Motivo del Permiso</h3>
                    <span class="section-indicator">3</span>
                </div>
                <div class="form-group">
                    <label asp-for="Reason" class="form-label">
                        Explique detalladamente el motivo de su solicitud
                        <span class="required">*</span>
                    </label>
                    <div class="textarea-wrapper">
                        <textarea asp-for="Reason" class="form-control-v2" rows="4" placeholder="Ej: Cita médica en el IMSS o Trámite personal..." maxlength="255"></textarea>
                        <div class="char-counter">
                            <span id="char-count">0</span>/255 caracteres
                        </div>
                    </div>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>
            </div>

            <!-- Sección: Evidencia -->
            <div class="form-section" id="evidence-section">
                <div class="section-header">
                    <h3><i class="fas fa-paperclip"></i> Documentación de Soporte</h3>
                    <span class="section-indicator">4</span>
                </div>
                <div class="form-group">
                    <label asp-for="EvidenceFile" class="form-label">
                        Adjuntar documento PDF (opcional)
                    </label>
                    <div class="file-upload-area" id="fileUploadArea">
                        <input asp-for="EvidenceFile" type="file" accept=".pdf" class="file-input" id="evidenceFile">
                        <div class="file-upload-content" id="fileUploadContent" style="@(!string.IsNullOrEmpty(Model.Evidence) ? "display:none;" : "")">
                            <div class="file-upload-icon"><i class="fas fa-cloud-upload-alt"></i></div>
                            <p class="file-upload-text">Subir PDF</p>
                            <p class="file-upload-hint">Haz clic o arrastra un archivo PDF aquí</p>
                        </div>
                        <div class="file-preview" id="filePreview" style="@(string.IsNullOrEmpty(Model.Evidence) ? "display:none;" : "")">
                            <div class="file-info">
                                <i class="fas fa-file-pdf file-icon"></i>
                                <span class="file-name" id="fileName">@(string.IsNullOrEmpty(Model.Evidence) ? "" : System.IO.Path.GetFileName(Model.Evidence))</span>
                            </div>
                            <button type="button" class="remove-file" id="removeFile" title="Eliminar archivo">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <input asp-for="Evidence" type="hidden" />
                    @if (!string.IsNullOrEmpty(Model.Evidence))
                    {
                        <div class="mt-3 p-3 bg-light rounded-4 border-start border-success border-4 d-flex align-items-center gap-3">
                            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold text-success small">Documento Existente</div>
                                <a href="@Url.Action("GetEvidence", "Permission", new { id = Model.Id })" target="_blank" class="text-decoration-none small fw-semibold">
                                    <i class="fas fa-external-link-alt me-1"></i> Ver documento actual
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Botones de Acción -->
        <div class="form-actions">
            <div class="actions-content justify-content-end">
                <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm" id="submitBtn">
                    <i class="fas fa-save me-2"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/Permissions/edit.js" asp-append-version="true"></script>
}