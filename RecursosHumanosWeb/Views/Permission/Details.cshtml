@model RecursosHumanosWeb.Models.Permission
@using System.IO
@using System.Globalization
@using RecursosHumanosWeb.Models.Enums
@{
    ViewData["Title"] = "Detalles del Permiso";

    var culture = new CultureInfo("es-MX");

    string FormatHour12(DateTime date)
    {
        return date.ToString("hh:mm tt", culture).ToUpper();
    }

    string FormatFullDate(DateTime date)
    {
        return date.ToString("dd/MM/yyyy", culture);
    }

    // Mapeo corregido segun base de datos: 1: Retardo, 2: Turno, 3: Falta, 4: Horario
    var typeConfigurations = new Dictionary<int, Dictionary<string, (bool show, string label)>>
    {
        [1] = new Dictionary<string, (bool, string)> // Retardo
        {
            ["Date1"] = (true, "En el d&iacute;a"),
            ["Date2"] = (false, "Al d&iacute;a"),
            ["Time1"] = (true, "Hora de llegada"),
            ["Time2"] = (false, "Hora salida")
        },
        [2] = new Dictionary<string, (bool, string)> // Turno por Turno
        {
            ["Date1"] = (true, "Del d&iacute;a"),
            ["Date2"] = (true, "Por el d&iacute;a"),
            ["Time1"] = (true, "Hora entrada"),
            ["Time2"] = (true, "Hora salida")
        },
        [3] = new Dictionary<string, (bool, string)> // Falta
        {
            ["Date1"] = (true, "Del d&iacute;a"),
            ["Date2"] = (true, "Al d&iacute;a"),
            ["Time1"] = (false, "Hora entrada"),
            ["Time2"] = (false, "Hora salida")
        },
        [4] = new Dictionary<string, (bool, string)> // Cambio de Horario
        {
            ["Date1"] = (true, "Del d&iacute;a"),
            ["Date2"] = (true, "Al d&iacute;a"),
            ["Time1"] = (true, "Hora entrada"),
            ["Time2"] = (true, "Hora salida")
        }
    };

    var config = typeConfigurations.ContainsKey(Model.PermissionTypeId) ? typeConfigurations[Model.PermissionTypeId] : null;
    bool showDays = config != null && config["Date2"].show && Model.EndDate.HasValue && Model.Days.HasValue && Model.Days.Value > 1;

    string time1 = config != null && config["Time1"].show && Model.StartDate != null ? FormatHour12(Model.StartDate.Value) : null!;
    string time2 = config != null && config["Time2"].show && Model.EndDate.HasValue ? FormatHour12(Model.EndDate.Value) : null!;

    // Evidencia: se sirve únicamente mediante la acción autorizada GetEvidence
    bool evidenceExists = ViewBag.EvidenceExists ?? false;
    string? evidenceUrl = Url.Action("GetEvidence", "Permission", new { id = Model.Id });

    // Authorization logic for review
    int currentUserType = ViewBag.CurrentUserType ?? 0;
    bool isRHOrAdmin = currentUserType == (int)UserTypeEnum.Administrator;
    bool isApprover = ViewBag.IsApprover ?? false;
    
    // RH/Admin can review any pending, Approvers only current court
    bool canReview = (Model.PermissionStatusTypeId == 1) && (isRHOrAdmin || (isApprover && Model.CutoffId == (int?)ViewBag.CurrentCutoffId));
    
    string requesterName = Model.RequestingUser?.Name ?? "Usuario";
    string initial = !string.IsNullOrEmpty(requesterName) ? requesterName.Substring(0, 1).ToUpper() : "U";
}

@section Styles {
    <link rel="stylesheet" href="~/cssv2/views/permisos/details.css" asp-append-version="true" />
}

<div class="details-container">
    <div class="card details-card shadow-lg rounded-3 overflow-hidden border">
        
        <div class="details-header-v2 p-4 p-md-5 w-100">
            <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-4 w-100">
                <div class="d-flex align-items-center gap-4 text-start">
                    <div class="details-avatar rounded-circle d-flex align-items-center justify-content-center text-white fs-3 shadow-sm flex-shrink-0">
                        <i class="fas fa-file-signature"></i>
                    </div>
                    <div>
                        <h2 class="h3 fw-bold mb-1 text-white">ID #@Model.Id</h2>
                        <div class="ms-1 d-flex align-items-center gap-2 opacity-90 text-white small">
                             <i class="fas fa-user-circle"></i> 
                             <span class="opacity-75">Solicitante:</span> 
                             <span class="fw-bold">@requesterName</span>
                        </div>
                    </div>
                </div>
                <div class="status-glass rounded-pill px-4 py-2 d-flex align-items-center shadow-sm border-white-20 ms-auto">
                    @if (Model.PermissionStatusTypeId == 1) { <span class="status-dot dot-closed"></span> <span class="small text-uppercase fw-bold text-white">PENDIENTE</span> }
                    else if (Model.PermissionStatusTypeId == 2) { <span class="status-dot dot-active"></span> <span class="small text-uppercase fw-bold text-white">APROBADO</span> }
                    else if (Model.PermissionStatusTypeId == 3) { <span class="status-dot dot-invalid"></span> <span class="small text-uppercase fw-bold text-white text-muted">INVALIDADO</span> }
                    else { <span class="status-dot dot-danger"></span> <span class="small text-uppercase fw-bold text-white">RECHAZADO</span> }
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5 bg-white">
            <div class="row g-5">
                
                <!-- COLUMNA IZQUIERDA: INFORMACION DEL PERMISO -->
                <div class="col-12 col-lg-6">
                    <h3 class="section-title h5 text-dark d-flex align-items-center gap-2 mb-4">
                        <i class="fas fa-info-circle text-primary"></i>
                        Informaci&oacute;n del Permiso
                    </h3>

                    <div class="mb-4">
                        <div class="info-card p-4 rounded-4 shadow-sm border">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="icon-circle bg-primary-subtle text-primary">
                                    <i class="fas fa-tag"></i>
                                </div>
                                <span class="small fw-bold text-dark text-uppercase">Tipo de Permiso</span>
                            </div>
                            <div class="ms-1">
                                <div class="permission-types d-flex gap-2">
                                    @foreach(var item in new[] { (ID:3, Icon:"fa-calendar-times", Label:"Falta"), (ID:1, Icon:"fa-clock", Label:"Retardo"), (ID:4, Icon:"fa-exchange-alt", Label:"Horario"), (ID:2, Icon:"fa-sync-alt", Label:"Turno") })
                                    {
                                        <div class="permission-type-card p-2 text-center rounded-3 flex-grow-1 @(Model.PermissionTypeId == item.ID ? "active border-primary bg-primary-50" : "opacity-50 grayscale border")" style="max-width: 80px;">
                                            <i class="fas @item.Icon type-icon @(Model.PermissionTypeId == item.ID ? "text-primary" : "") mb-1"></i>
                                            <p class="mb-0 fw-bold" style="font-size: 0.65rem;">@item.Label</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="info-card p-4 rounded-4 shadow-sm border @(Model.WithPay ? "border-success-subtle" : "border-danger-subtle")">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <div class="icon-circle @(Model.WithPay ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                    <i class="fas fa-money-bill-wave"></i>
                                </div>
                                <span class="small fw-bold text-dark text-uppercase">Estatus de Pago</span>
                            </div>
                            <p class="h6 fw-bold mb-0 ms-5 @(Model.WithPay ? "text-success" : "text-danger")">
                                @(Model.WithPay ? "✓ Con Goce de Sueldo" : "✗ Sin Goce de Sueldo")
                            </p>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="info-card p-4 rounded-4 shadow-sm border border-soft">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="icon-circle bg-gray-100 text-gray-500">
                                    <i class="fas fa-comment-dots"></i>
                                </div>
                                <span class="small fw-bold text-dark text-uppercase">Motivo de Ausencia</span>
                            </div>
                            <div class="bg-light p-4 rounded-3 ms-1 motivo-box border">
                                <p class="text-dark mb-0 fw-medium" style="white-space: pre-wrap; line-height: 1.8; font-size: 0.95rem;">@Model.Reason</p>
                            </div>
                            <div class="d-flex justify-content-end mt-2 opacity-50">
                                <small class="fw-bold">@((Model.Reason?.Length ?? 0)) / 255 caracteres</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- COLUMNA DERECHA: FECHAS Y AUDITORIA -->
                <div class="col-12 col-lg-6">
                    <h3 class="section-title h5 text-dark d-flex align-items-center gap-2 mb-4">
                        <i class="fas fa-calendar-alt text-primary"></i>
                        Fechas y Horarios
                    </h3>
                    
                    <div class="detail-grid d-flex flex-column gap-3 mb-5">
                        <div class="row g-3">
                            @if (config != null && config["Date1"].show && Model.StartDate != null)
                            {
                                <div class="col-md-6">
                                    <div class="p-3 border-start border-primary border-4 bg-light rounded-end h-100 shadow-sm">
                                        <p class="small text-secondary text-uppercase fw-bold mb-1" style="font-size: 0.65rem;">@Html.Raw(config["Date1"].label)</p>
                                        <p class="small fw-bold text-dark mb-0">
                                            @FormatFullDate(Model.StartDate.Value)
                                        </p>
                                    </div>
                                </div>
                            }
                            @if (config != null && config["Time1"].show && !string.IsNullOrEmpty(time1))
                            {
                                <div class="col-md-6">
                                    <div class="p-3 border-start border-info border-4 bg-light rounded-end h-100 shadow-sm">
                                        <p class="small text-secondary text-uppercase fw-bold mb-1" style="font-size: 0.65rem;">@Html.Raw(config["Time1"].label)</p>
                                        <p class="small fw-bold text-dark mb-0">
                                            <i class="fas fa-clock text-info me-2"></i> @time1
                                        </p>
                                    </div>
                                </div>
                            }
                            @if (config != null && config["Date2"].show && Model.EndDate.HasValue)
                            {
                                <div class="col-md-6">
                                    <div class="p-3 border-start border-primary border-4 bg-light rounded-end h-100 shadow-sm">
                                        <p class="small text-secondary text-uppercase fw-bold mb-1" style="font-size: 0.65rem;">@Html.Raw(config["Date2"].label)</p>
                                        <p class="small fw-bold text-dark mb-0">
                                            @FormatFullDate(Model.EndDate.Value)
                                        </p>
                                    </div>
                                </div>
                            }
                            @if (config != null && config["Time2"].show && !string.IsNullOrEmpty(time2))
                            {
                                <div class="col-md-6">
                                    <div class="p-3 border-start border-info border-4 bg-light rounded-end h-100 shadow-sm">
                                        <p class="small text-secondary text-uppercase fw-bold mb-1" style="font-size: 0.65rem;">@Html.Raw(config["Time2"].label)</p>
                                        <p class="small fw-bold text-dark mb-0">
                                            <i class="fas fa-clock text-info me-2"></i> @time2
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (showDays)
                        {
                            <div class="p-3 border-start border-success border-4 bg-light rounded-end shadow-sm">
                                <p class="small text-secondary text-uppercase fw-bold mb-1" style="font-size: 0.65rem;">D&iacute;as Totales</p>
                                <p class="small fw-bold text-dark mb-0">
                                    <i class="fas fa-calendar-check text-success me-2"></i> @Model.Days @(Model.Days == 1 ? "d&iacute;a" : "d&iacute;as") solicitados
                                </p>
                            </div>
                        }
                    </div>

                    <h3 class="h6 fw-bold text-dark text-uppercase mb-4 d-flex align-items-center gap-2">
                        <i class="fas fa-shield-alt text-primary"></i> Seguimiento Administrativo
                    </h3>
                    
                    <div class="mb-3">
                        <div class="info-card p-4 rounded-4 shadow-sm border border-start-4 border-start-indigo">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <div class="icon-circle bg-indigo-50 text-indigo-600">
                                    <i class="fas fa-hashtag"></i>
                                </div>
                                <span class="small fw-bold text-dark text-uppercase">Periodo de Corte</span>
                            </div>
                            <div class="ms-5 d-flex align-items-center gap-2">
                                <span class="fw-bold text-dark">#@Model.CutoffId</span>
                                <div class="v2-badge @(Model.Cutoff?.CutoffStatusTypeId == 1 ? "v2-badge-success" : "v2-badge-secondary")">
                                    <span class="v2-badge-dot"></span>
                                    @(Model.Cutoff?.CutoffStatusTypeId == 1 ? "Corte Abierto" : "Corte Cerrado")
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.AuthorizationComment))
                    {
                        <div class="mb-3">
                            <div class="info-card p-4 rounded-4 shadow-sm border border-start-4 border-start-warning">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="icon-circle bg-warning-subtle text-warning">
                                        <i class="fas fa-comment-dots"></i>
                                    </div>
                                    <span class="small fw-bold text-dark text-uppercase">Comentario de la Revisión</span>
                                </div>
                                <div class="ms-5 mt-2">
                                    <p class="small text-dark fw-medium mb-0" style="white-space: pre-wrap;">@Model.AuthorizationComment</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- SECCIÓN DE EVIDENCIA (ANCHO COMPLETO) -->
                @if (!string.IsNullOrEmpty(Model.Evidence))
                {
                    <div class="col-12 mt-4 pt-5 border-top">
                        <h3 class="h5 fw-bold text-dark mb-4 d-flex align-items-center gap-2">
                            <i class="fas fa-paperclip text-primary"></i> Evidencia Documental
                        </h3>
                        <div class="audit-card bg-light rounded-4 overflow-hidden border shadow-sm">
                            @if (evidenceExists)
                            {
                                <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold text-dark"><i class="fas fa-file-pdf me-2 text-danger"></i> @System.IO.Path.GetFileName(Model.Evidence.Replace('\\', '/'))</span>
                                    <a href="@evidenceUrl" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                                        <i class="fas fa-external-link-alt me-1"></i> Abrir PDF
                                    </a>
                                </div>
                                <iframe src="@evidenceUrl" class="w-100 border-0" style="height: 600px;"></iframe>
                            }
                            else
                            {
                                <div class="p-5 text-center bg-white">
                                    <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px;">
                                        <i class="fas fa-exclamation-triangle fs-2"></i>
                                    </div>
                                    <h5 class="fw-bold text-dark">Archivo no encontrado</h5>
                                    <p class="text-muted small mb-0">No se pudo localizar el archivo: @System.IO.Path.GetFileName(Model.Evidence)</p>
                                </div>
                            }
                        </div>
                    </div>
                }


                <!-- AUDITORÍA (PIE DE PÁGINA) -->
                <div class="col-12 mt-5 pt-5 border-top">
                    <h3 class="h6 fw-bold text-secondary text-uppercase mb-4">Bit&aacute;cora de Registro</h3>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="audit-card bg-light p-3 rounded-4 border border-soft h-100">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="icon-circle bg-success text-white">
                                        <i class="fas fa-calendar-plus"></i>
                                    </div>
                                    <div>
                                        <p class="small text-muted mb-0 fw-bold">Fecha Solicitud</p>
                                        <p class="small fw-bold text-dark mb-0">@Model.CreatedAt.ToString("dd/MM/yyyy hh:mm tt", culture).ToUpper()</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="audit-card bg-light p-3 rounded-4 border border-soft h-100">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="icon-circle bg-primary text-white">
                                        <i class="fas fa-user-tag"></i>
                                    </div>
                                    <div>
                                        <p class="small text-muted mb-0 fw-bold">Creado por</p>
                                        <p class="small fw-bold text-dark mb-0 truncate-1">@(Model.CreatedByUser?.Name ?? "Sistema")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (Model.PermissionStatusTypeId == 2)
                        {
                            <div class="col-md-4">
                                <div class="audit-card bg-white p-3 rounded-4 border-success border-1 shadow-sm h-100" style="background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="icon-circle bg-success text-white">
                                            <i class="fas fa-user-check"></i>
                                        </div>
                                        <div>
                                            <p class="small text-success mb-0 fw-bold">Autorizado por</p>
                                            <p class="small fw-bold text-dark mb-0 truncate-1">@(Model.AuthorizingUser?.Name ?? "N/A")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer py-4 px-5 bg-light border-top d-flex justify-content-between align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                <i class="fas fa-arrow-left me-2"></i> Volver al Listado
            </a>
            
            <div class="d-flex gap-3">
                @if (canReview == false && Model.CutoffId == (int?)ViewBag.CurrentCutoffId && (Model.PermissionStatusTypeId == 1) && (int?)ViewBag.CurrentUserId == Model.RequestingUserId)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="v2-btn btn-primary shadow-sm">
                        <i class="fas fa-edit"></i> Editar Solicitud
                    </a>
                }

                @if (canReview)
                {
                    <button type="button" class="v2-btn btn-success shadow-sm" onclick="document.getElementById('reviewFormInline')?.scrollIntoView({behavior:'smooth'})">
                        <i class="fas fa-check-double"></i> Revisar Ahora
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Logica para autorizacion inline (si existiera el formulario)
            const reviewForm = document.getElementById('reviewFormInline');
            const goceOptions = document.querySelectorAll('.goce-option');
            
            if (reviewForm) {
                function updateUi() {
                    const selected = document.querySelector('input[name="Goce"]:checked');
                    goceOptions.forEach(opt => opt.classList.remove('active'));
                    if (selected) {
                        selected.closest('.goce-option').classList.add('active');
                    }
                }
                
                goceOptions.forEach(opt => {
                    opt.addEventListener('click', () => {
                        const val = opt.dataset.value;
                        const radio = document.getElementById(val === 'true' ? 'goceTrue' : 'goceFalse');
                        if (radio) { 
                            radio.checked = true; 
                            updateUi(); 
                        }
                    });
                });
                
                updateUi();

                reviewForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const selected = document.querySelector('input[name="Goce"]:checked');
                    if (!selected) { Swal.fire('Atenci&oacute;n', 'Determine el goce de sueldo antes de autorizar.', 'warning'); return; }
                    
                    const goceVal = selected.value === 'true';
                    const confirm = await Swal.fire({
                        title: '&iquest;Confirmar Autorizaci&oacute;n?',
                        html: `La solicitud ser&aacute; marcada como autorizada <strong>${goceVal ? 'CON GOCE' : 'SIN GOCE'}</strong> de sueldo.`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'S&iacute;, Autorizar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: goceVal ? '#10b981' : '#f59e0b'
                    });
                    
                    if (!confirm.isConfirmed) return;
                    
                    const btn = document.getElementById('submitReviewBtn');
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Procesando...';
                    
                    try {
                        const formData = new FormData(reviewForm);
                        const response = await fetch(reviewForm.action, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                            body: formData
                        });
                        const data = await response.json();
                        if (typeof handleAlertResponse === 'function') { 
                            await handleAlertResponse(data); 
                        } else {
                            window.location.href = data.redirectUrl || '/Permission/Index';
                        }
                    } catch (err) {
                        Swal.fire('Error', err.message, 'error');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-check-double me-2"></i> Finalizar y Autorizar Permiso';
                    }
                });
            }
        });
    </script>
}
