@model RecursosHumanosWeb.Models.Permission
@using System.IO
@using System.Globalization
@using RecursosHumanosWeb.Models.Enums
@{
    ViewData["Title"] = "Autorizar Permiso";
    var culture = new CultureInfo("es-MX");

    string FormatHour12(DateTime date) => date.ToString("hh:mm tt", culture).ToUpper();
    string FormatFullDate(DateTime date) => date.ToString("dd 'de' MMMM 'del' yyyy", culture);

    var typeConfigurations = new Dictionary<int, Dictionary<string, (bool show, string label)>>
    {
        [1] = new Dictionary<string, (bool, string)> { ["Date1"] = (true, "En el día"), ["Date2"] = (false, "Al día"), ["Time1"] = (true, "Hora de llegada"), ["Time2"] = (false, "Hora salida") },
        [2] = new Dictionary<string, (bool, string)> { ["Date1"] = (true, "Del día"), ["Date2"] = (true, "Por el día"), ["Time1"] = (true, "Hora entrada"), ["Time2"] = (true, "Hora salida") },
        [3] = new Dictionary<string, (bool, string)> { ["Date1"] = (true, "Del día"), ["Date2"] = (true, "Al día"), ["Time1"] = (false, "Hora entrada"), ["Time2"] = (false, "Hora salida") },
        [4] = new Dictionary<string, (bool, string)> { ["Date1"] = (true, "Del día"), ["Date2"] = (true, "Al día"), ["Time1"] = (true, "Hora entrada"), ["Time2"] = (true, "Hora salida") }
    };

    var config = typeConfigurations.ContainsKey(Model.PermissionTypeId) ? typeConfigurations[Model.PermissionTypeId] : null;
    bool showDays = config != null && config["Date2"].show && Model.EndDate.HasValue && Model.Days.HasValue && Model.Days.Value > 1;

    // Evidencia: se sirve únicamente mediante la acción autorizada GetEvidence
    string? evidenceUrl = !string.IsNullOrEmpty(Model.Evidence) ? Url.Action("GetEvidence", "Permission", new { id = Model.Id }) : null;

    bool isRHOrAdmin = (ViewBag.CurrentUserType ?? 0) == (int)UserTypeEnum.Administrator;
    bool isApprover = ViewBag.IsApprover ?? false;
    bool canReview = (Model.PermissionStatusTypeId == 1) && (isRHOrAdmin || (isApprover && Model.CutoffId == (int?)ViewBag.CurrentCutoffId));

    string requesterName = Model.RequestingUser?.Name ?? "Usuario";
    string initial = !string.IsNullOrEmpty(requesterName) ? requesterName.Substring(0, 1).ToUpper() : "U";
}

@section Styles {
    <link rel="stylesheet" href="~/cssv2/views/permisos/authorize.css" asp-append-version="true" />
}

        <div class="details-header-v2 text-white p-4 p-md-5">
            <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-4">
                <div class="d-flex align-items-center gap-4">
                    <div class="details-avatar rounded-circle d-flex align-items-center justify-content-center text-white fs-2 fw-bold shadow-sm">
                        @initial
                    </div>
                    <div>
                        <h2 class="h3 fw-bold mb-1">Autorizaci&oacute;n de Permiso #@Model.Id</h2>
                        <div class="ms-1 d-flex align-items-center gap-2 opacity-75 small">
                             <i class="fas fa-user-check"></i> Revisando solicitud de: @requesterName
                        </div>
                    </div>
                </div>
                <div class="status-glass rounded-pill px-4 py-2 d-flex align-items-center shadow-sm">
                    <span class="status-dot bg-warning shadow-warning me-2"></span> 
                    <span class="small text-uppercase fw-bold">PENDIENTE</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5 bg-white">
            <div class="row g-5">
                <div class="col-12 col-lg-6">
                    <h3 class="section-title h5 text-dark border-bottom pb-2 mb-4">
                        <i class="fas fa-file-alt text-primary me-2"></i>Resumen de Solicitud
                    </h3>
                    <div class="p-4 bg-light rounded-4 mb-4 border-start border-primary border-4">
                        <p class="small text-secondary text-uppercase fw-bold mb-2" style="font-size: 0.65rem;">Motivo</p>
                        <p class="text-dark mb-0 small" style="white-space: pre-wrap; line-height: 1.6;">@Model.Reason</p>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 border rounded-3 shadow-sm bg-white h-100 border-start border-4 border-primary">
                                <p class="small text-secondary text-uppercase fw-bold mb-1" style="font-size: 0.65rem;">Tipo</p>
                                <p class="small fw-bold mb-0 text-dark"><i class="fas fa-tag text-primary me-2"></i>@Model.PermissionType?.Description</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 border rounded-3 shadow-sm bg-white h-100 border-start border-4 border-info">
                                <p class="small text-secondary text-uppercase fw-bold mb-1" style="font-size: 0.65rem;">Área</p>
                                <p class="small fw-bold mb-0 text-dark"><i class="fas fa-building text-info me-2"></i>@(Model.RequestingUser?.Area?.Description ?? "N/A")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <h3 class="section-title h5 text-dark border-bottom pb-2 mb-4">
                        <i class="fas fa-calendar-check text-primary me-2"></i>Vigencia
                    </h3>
                    <div class="detail-grid d-flex flex-column gap-3">
                        <div class="p-3 border-start border-primary border-4 bg-light rounded-end shadow-sm">
                            <p class="small text-secondary text-uppercase fw-bold mb-1" style="font-size: 0.65rem;">Desde</p>
                            <p class="fw-bold text-dark mb-0 small">@FormatFullDate(Model.StartDate.Value) @(config != null && config["Time1"].show ? "- " + FormatHour12(Model.StartDate.Value) : "")</p>
                        </div>
                        @if (Model.EndDate.HasValue)
                        {
                            <div class="p-3 border-start border-primary border-4 bg-light rounded-end shadow-sm">
                                <p class="small text-secondary text-uppercase fw-bold mb-1" style="font-size: 0.65rem;">Hasta</p>
                                <p class="fw-bold text-dark mb-0 small">@FormatFullDate(Model.EndDate.Value) @(config != null && config["Time2"].show ? "- " + FormatHour12(Model.EndDate.Value) : "")</p>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(evidenceUrl))
                {
                    <div class="col-12 mt-4">
                        <h3 class="h5 fw-bold text-dark mb-4 border-bottom pb-2">
                            <i class="fas fa-paperclip text-primary me-2"></i>Evidencia
                        </h3>
                        <div class="audit-card bg-light rounded-4 overflow-hidden border shadow-sm">
                            <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                                <span class="small fw-bold text-dark"><i class="fas fa-file-pdf me-2 text-danger"></i> @System.IO.Path.GetFileName(Model.Evidence.Replace('\\', '/'))</span>
                                <a href="@evidenceUrl" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                                    <i class="fas fa-external-link-alt me-1"></i> Abrir
                                </a>
                            </div>
                            <iframe src="@evidenceUrl" class="w-100 border-0" style="height: 500px;"></iframe>
                        </div>
                    </div>
                }

                @if (canReview)
                {
                    <div class="col-12 mt-5 p-4 p-md-5 bg-light rounded-4 shadow-sm border">
                        <div class="text-center mb-5">
                            <h3 class="fw-bold h4"><i class="fas fa-user-shield me-2 text-primary"></i> M&oacute;dulo de Autorizaci&oacute;n</h3>
                            <p class="text-muted small">Determine el goce de sueldo para autorizar formalmente esta solicitud.</p>
                        </div>
                        
                        <form asp-action="Review" method="post" id="reviewFormInline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="@Model.Id" />
                            
                            <div class="goce-options">
                                <div class="goce-option active" data-value="true">
                                    <input type="radio" name="WithPay" id="goceTrue" value="true" checked class="d-none">
                                    <div class="option-content shadow-sm">
                                        <div class="option-icon bg-success">
                                            <i class="fas fa-check"></i>
                                        </div>
                                        <h5 class="fw-bold mb-1">CON GOCE</h5>
                                        <p class="small text-muted mb-0">El tiempo se pagar&aacute; normal</p>
                                    </div>
                                </div>

                                <div class="goce-option" data-value="false">
                                    <input type="radio" name="WithPay" id="goceFalse" value="false" class="d-none">
                                    <div class="option-content shadow-sm">
                                        <div class="option-icon bg-warning">
                                            <i class="fas fa-times"></i>
                                        </div>
                                        <h5 class="fw-bold mb-1">SIN GOCE</h5>
                                        <p class="small text-muted mb-0">Se descontar&aacute; del salario</p>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4">
                                <label for="AuthorizationComment" class="form-label fw-bold text-dark">Comentario (opcional)</label>
                                <textarea id="AuthorizationComment" name="AuthorizationComment" class="form-control" rows="2" maxlength="500" placeholder="Comentario de la revisión (visible para el solicitante)..."></textarea>
                            </div>

                            <div class="text-center mt-5">
                                <button type="submit" id="submitReviewBtn" class="btn btn-success btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg">
                                    <i class="fas fa-check-double me-2"></i> Finalizar y Autorizar Permiso
                                </button>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="col-12 mt-4">
                        <div class="bg-warning-subtle text-warning-emphasis p-4 rounded-4 border border-warning-subtle d-flex align-items-center gap-3">
                            <i class="fas fa-exclamation-triangle fs-3"></i>
                            <p class="mb-0 fw-semibold">No tiene los permisos necesarios o el periodo est&aacute; cerrado para realizar esta acci&oacute;n.</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card-footer py-4 px-5 bg-light d-flex justify-content-between border-top">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                <i class="fas fa-arrow-left me-2"></i> Cancelar
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/dist/sweetalert2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const goceOptions = document.querySelectorAll('.goce-option');
            
            function updateUi() {
                const selected = document.querySelector('input[name="WithPay"]:checked');
                goceOptions.forEach(opt => opt.classList.remove('active'));
                if (selected) {
                    selected.closest('.goce-option').classList.add('active');
                }
            }
            
            goceOptions.forEach(opt => {
                opt.addEventListener('click', () => {
                    const val = opt.dataset.value;
                    const radio = document.getElementById(val === 'true' ? 'goceTrue' : 'goceFalse');
                    if (radio) { 
                        radio.checked = true; 
                        updateUi(); 
                    }
                });
            });
            
            updateUi();

            const reviewForm = document.getElementById('reviewFormInline');
            if (reviewForm) {
                reviewForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const selected = document.querySelector('input[name="WithPay"]:checked');
                    if (!selected) return;
                    
                    const goceVal = selected.value === 'true';
                    const confirm = await Swal.fire({
                        title: '¿Confirmar Autorización?',
                        html: `La solicitud será marcada como autorizada <strong>${goceVal ? 'CON GOCE' : 'SIN GOCE'}</strong> de sueldo.`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Sí, Autorizar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: goceVal ? '#10b981' : '#f59e0b'
                    });
                    
                    if (!confirm.isConfirmed) return;
                    
                    const btn = document.getElementById('submitReviewBtn');
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Procesando...';
                    
                    try {
                        const formData = new FormData(reviewForm);
                        const response = await fetch(reviewForm.action, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                            body: formData
                        });
                        const data = await response.json();
                        if (typeof handleAlertResponse === 'function') { 
                            await handleAlertResponse(data); 
                        } else {
                            window.location.href = data.redirectUrl || '/Permission/Index';
                        }
                    } catch (err) {
                        Swal.fire('Error', err.message, 'error');
                        btn.disabled = false;
                        btn.innerHTML = 'Finalizar y Autorizar Permiso';
                    }
                });
            }
        });
    </script>
}
