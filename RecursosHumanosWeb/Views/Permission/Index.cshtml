@using X.PagedList.Mvc.Core
@model RecursosHumanosWeb.Models.ViewModels.SearchPermissionsViewModel

@{
    ViewData["Title"] = "Gestión de Permisos";
    int currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
    bool isRH = User.HasClaim("UserType", "3");
    bool isAdministrator = User.HasClaim("UserType", "1");
    bool isAuthorizer = User.HasClaim("UserType", "2");
    int currentCutoffId = ViewBag.CurrentCutoffId ?? 0;
}

@section Styles {
    @* Usando estilos globales de v2-site.css *@
}

<div class="index-container">
    @Html.AntiForgeryToken()
    <div class="page-header-v2 fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-file-alt"></i>
                Gestión de Permisos
            </h1>
            <p class="page-subtitle">Administra los permisos solicitados</p>
        </div>
        <div class="header-actions">
            <authorize-section policy="!AutorizadorOnly">
                <a asp-action="Create" class="btn btn-create" aria-label="Crear nuevo permiso">
                    <i class="fas fa-plus"></i>
                    Crear Permiso
                </a>
            </authorize-section>
        </div>
    </div>
    
     <div class="filters-section slide-in-left">
        <div class="card filter-card-premium">
            <div class="filter-header-premium">
                <i class="fas fa-filter fa-lg"></i>
                <h5 class="m-0 fw-bold" style="letter-spacing: 0.5px;">Panel de Búsqueda</h5>
            </div>
            <div class="filter-body-premium">
                <form id="searchForm" method="get" asp-action="Index">
                    <div class="row g-3">
                        <div class="col-md-2">
                            <div class="filter-group">
                                <label class="fw-bold text-success small text-uppercase mb-2 ms-2">Vigencia Desde</label>
                                <input type="date" id="toDay" name="toDay" class="form-control filter-input-pill" value="@ViewBag.Today" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="filter-group">
                                <label class="fw-bold text-danger small text-uppercase mb-2 ms-2">Vigencia Hasta</label>
                                <input type="date" id="fromDay" name="fromDay" class="form-control filter-input-pill" value="@ViewBag.FromDay" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Estado</label>
                                <select id="statusId" name="statusId" class="form-control filter-input-pill select2-simple">
                                    <option value="">Cualquiera</option>
                                    @foreach (var st in (IEnumerable<RecursosHumanosWeb.Models.PermissionStatusType>)ViewBag.Statuses)
                                    {
                                        <option value="@st.Id" selected="@(Model.StatusId == st.Id ? "selected" : null)">@st.Description</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <authorize-section policy="AutorizadorOrAbove">
                            <div class="col-md-3">
                                <div class="filter-group">
                                    <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Creado por</label>
                                    <select id="userName" name="userName" class="form-control user-autocomplete w-100">
                                        <option value="">Todos los empleados</option>
                                    </select>
                                </div>
                            </div>
                        </authorize-section>
                        <authorize-section policy="RHOrAdmin">
                            <div class="col-md-3">
                                <div class="filter-group">
                                    <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Área Operativa</label>
                                    <select id="areaId" name="areaId" class="form-control filter-input-pill form-select">
                                        <option value="">Todas las áreas</option>
                                        @foreach (var area in Model.Areas)
                                        {
                                            <option value="@area.Id" selected="@(Model.SelectedArea == area.Id ? "selected" : null)">
                                                @area.Description
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </authorize-section>
                    </div>
                    <div class="d-flex justify-content-end mt-4 pt-3 border-top gap-3">
                        <button type="button" onclick="clearAllFilters()" class="btn btn-light rounded-pill px-4 fw-bold text-secondary border hover-shadow" style="transition: all 0.2s;">
                            <i class="fas fa-undo me-2"></i> Limpiar
                        </button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" 
                                style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); border: none;">
                            <i class="fas fa-search me-2"></i> Aplicar Filtros
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.Permissions.Any())
    {

        <div class="legend-bar fade-in d-flex align-items-center flex-wrap gap-3"
             style="margin-top: calc(1.25rem - var(--section-gap)); margin-bottom: 1.25rem; padding: 0.7rem 1.25rem; background: var(--surface-alt); border: 1px solid var(--border-soft); border-radius: var(--radius-lg);">
            <div class="d-flex align-items-center gap-2 fw-bold text-secondary" style="font-size: 0.8rem; letter-spacing: 0.02em;">
                <i class="fas fa-info-circle text-primary"></i>
                <span>Estados del permiso</span>
            </div>
            <div class="vr d-none d-lg-block align-self-stretch" style="opacity: 0.2;"></div>
            @foreach (var st in (IEnumerable<RecursosHumanosWeb.Models.PermissionStatusType>)ViewBag.Statuses)
            {
                var legendColor = string.IsNullOrWhiteSpace(st.Color) ? "secondary" : st.Color;
                <div class="d-flex align-items-center gap-2" title="@st.Description">
                    <span class="v2-badge v2-badge-@legendColor"><span class="v2-badge-dot"></span>@st.Description</span>
                </div>
            }
        </div>

        <div class="table-container fade-in">
            <div class="table-inner">
                <div class="overflow-x-auto">
                    <table id="permisosTable" class="data-table" style="width:100%; border: none; overflow: hidden; padding: 0;" aria-label="Tabla de permisos">
                            <thead>
                                <tr>
                                    <th class="text-center">ID</th>
                                    <th class="text-center">Solicitante</th>
                                    <th class="text-center">Revisado</th>
                                    <th class="text-center">Creación</th>
                                    <th class="text-center">Modificación</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Permissions)
                                {
                                    <tr>
                                        <td class="text-center" data-label="ID">@item.Id</td>
                                        <td data-label="Solicitante"><strong>@(item.Name ?? "-")</strong></td>
                                        <td class="text-center" data-label="Estado">
                                            <div class="v2-badge v2-badge-@item.StatusColor">
                                                <span class="v2-badge-dot"></span>
                                                @item.StatusDescription
                                            </div>
                                        </td>
                                        <td class="text-center" data-label="Creación">
                                            @if (item.CreatedAt != default)
                                            {
                                                <div style="color: var(--text-medium); font-weight: 500;">
                                                    <div style="font-size: 0.875rem;">@item.CreatedAt.ToString("dd/MM/yyyy")</div>
                                                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem;">@item.CreatedAt.ToString("h:mm tt")</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="font-style: italic; color: var(--text-muted);">Sin crear</div>
                                            }
                                        </td>
                                        <td class="text-center" data-label="Modificación">
                                            @if (item.UpdatedAt != default)
                                            {
                                                <div style="color: var(--text-medium); font-weight: 500;">
                                                    <div style="font-size: 0.875rem;">@item.UpdatedAt?.ToString("dd/MM/yyyy")</div>
                                                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem;">@item.UpdatedAt?.ToString("h:mm tt")</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="font-style: italic; color: var(--text-muted);">Sin modificar</div>
                                            }
                                        </td>
                                        <!-- Dentro del <td> de Acciones -->
                                        <td class="text-center" data-label="Acciones">
                                            <div class="flex justify-center gap-2">
                                                @* LÓGICA DE BOTONES SEGÚN ROL Y ESTADO *@
                                                
                                                <authorize-section policy="AutorizadorOnly">
                                                    @if (item.PermissionStatusTypeId == 1)
                                                    {
                                                        <a asp-action="Review" asp-route-id="@item.Id" class="action-btn btn-approve" title="Revisar y autorizar permiso" aria-label="Revisar permiso" style="background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);">
                                                            <i class="fas fa-user-check"></i>
                                                        </a>
                                                    }
                                                </authorize-section>
                                                 <authorize-section policy="!AutorizadorOnly">
                                                    @{
                                                         bool isOwnerDesktop = item.RequestingUserId == currentUserId;
                                                         bool inActiveCutoffDesktop = item.CutoffId == currentCutoffId;
                                                         bool isPendingDesktop = item.PermissionStatusTypeId == 1;
                                                         bool canEditDesktop = (isAdministrator || isRH || isOwnerDesktop) && inActiveCutoffDesktop && isPendingDesktop && !isAuthorizer;
                                                         bool canDeleteDesktop = (isAdministrator || isRH || isOwnerDesktop) && inActiveCutoffDesktop && !isAuthorizer;
                                                     }

                                                    @if (canEditDesktop)
                                                    {
                                                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Editar permiso" aria-label="Editar permiso">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button class="action-btn opacity-50" disabled title="No se puede editar fuera del periodo vigente" style="cursor: not-allowed;">
                                                            <i class="fas fa-lock"></i>
                                                        </button>
                                                    }

                                                    @if (canDeleteDesktop)
                                                    {
                                                        <a href="#" class="action-btn btn-delete" data-action="DeleteAjax" data-controller="Permission" data-id="@item.Id" title="Eliminar permiso" aria-label="Eliminar permiso">
                                                            <i class="fas fa-trash"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button class="action-btn opacity-50" disabled title="No se puede eliminar un permiso revisado de un periodo cerrado" style="cursor: not-allowed;">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    }
                                                </authorize-section>

                                                @* 4. VER DETALLES: Solo visible para no-autorizadores *@
                                                <authorize-section policy="!AutorizadorOnly">
                                                    <a asp-action="Details" asp-route-id="@item.Id" class="action-btn btn-view" title="Ver detalles" aria-label="Ver detalles del permiso">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </authorize-section>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="text-center">ID</th>
                                    <th class="text-center">Solicitante</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Creación</th>
                                    <th class="text-center">Modificación</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- SHARED PAGINATION (Visible in both views) -->
    @if (Model.Permissions.Any())
    {
        <div class="pagination-container-v2 fade-in">
            <div class="pagination-info-v2">
                <i class="fas fa-list-ol me-2 opacity-50"></i>
                Mostrando <span class="fw-bold">@Model.Permissions.FirstItemOnPage</span> - <span class="fw-bold">@Model.Permissions.LastItemOnPage</span> de <span class="fw-bold">@Model.Permissions.TotalItemCount</span> permisos
            </div>
            <div class="v2-pagination">
                @Html.PagedListPager(Model.Permissions, page => Url.Action("Index", 
                    new { page, pageSize = Model.Permissions.PageSize, userName = ViewBag.UserName, areaId = Model.SelectedArea, statusId = ViewBag.StatusId, toDay = ViewBag.Today, fromDay = ViewBag.FromDay }), 
                    new PagedListRenderOptions {
                        DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                        DisplayLinkToLastPage = PagedListDisplayMode.Always,
                        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                        DisplayLinkToNextPage = PagedListDisplayMode.Always,
                        MaximumPageNumbersToDisplay = 5,
                        UlElementClasses = new[] { "pagination" },
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
            </div>
        </div>
    }

    @if (!Model.Permissions.Any())
    {
        <div class="empty-state fade-in">
            <div class="empty-icon">
                <i class="fas fa-file-alt"></i>
            </div>
            <h3>No hay permisos registrados</h3>
            <p class="text-muted">Intenta ajustar los filtros de búsqueda</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function(){
            // Inicializar select2 para filtro de usuarios en Permisos Index
            (function(){
                var $select = $('#userName');
                var valueMode = $select.data('user-value') || 'text';
                $select.select2({
                    placeholder: '-- Seleccionar Usuario --',
                    minimumInputLength: 2,
                    allowClear: true,
                    ajax: {
                        url: '@Url.Action("SearchUsers", "User")',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) { return { term: params.term }; },
                        processResults: function (data) {
                            var results = data.map(function(item){
                                return {
                                    id: valueMode === 'text' ? item.text : item.id,
                                    text: item.text,
                                    areaId: item.areaId
                                };
                            });
                            return { results: results };
                        },
                        cache: true
                    }
                });

                // When a user is selected, store the appropriate value into a hidden input for submission
                if ($('#userNameHidden').length === 0) {
                    $('<input>').attr({ type: 'hidden', id: 'userNameHidden', name: 'userName', value: '' }).appendTo('#searchForm');
                }
                $select.on('select2:select', function(e) {
                    var data = e.params.data;
                    if (valueMode === 'text') $('#userNameHidden').val(data.text);
                    else $('#userNameHidden').val(data.id);
                });
                $select.on('select2:clear', function() { $('#userNameHidden').val(''); });
            })();

            $('#userName').on('focus', function () { $(this).select2('open'); });
            $('#userName').on('select2:open', function () { const sf = document.querySelector('.select2-container--open .select2-search__field'); if (sf) sf.focus(); });

            // Initialize Select2 for Area Filter
            if ($('#areaId').length > 0) {
                $('#areaId').select2({
                    placeholder: 'Todas las áreas',
                    width: '100%',
                    allowClear: true
                });
            }
            // Initialize Select2 for Revision Filter
            if ($('#statusId').length > 0) {
                $('#statusId').select2({
                    placeholder: 'Todos los estados',
                    width: '100%',
                    allowClear: true,
                    minimumResultsForSearch: Infinity // Ocultar buscador si son pocas opciones
                });
            }

            // bind clear function
            window.clearAllFilters = function () {
                const userName = document.getElementById('userName');
                const areaId = document.getElementById('areaId');
                const toDay = document.getElementById('toDay');
                const fromDay = document.getElementById('fromDay');
                const statusId = document.getElementById('statusId');

                if (userName) $(userName).val(null).trigger('change');
                if (areaId) $(areaId).val(null).trigger('change');
                if (toDay) toDay.value = '';
                if (fromDay) fromDay.value = '';
                if (statusId) statusId.value = '';

                document.getElementById('searchForm').submit();
            };
        });



        document.addEventListener('DOMContentLoaded', function () {
            const elements = document.querySelectorAll('.fade-in, .slide-in-left');
            elements.forEach(element => {
                element.style.opacity = '0';
                element.style.transform = element.classList.contains('slide-in-left')
                    ? 'translateY(20px)'
                    : 'translateY(20px)';
            });

            setTimeout(() => {
                elements.forEach((element, index) => {
                    setTimeout(() => {
                        element.style.transition = 'all 0.6s ease-out';
                        element.style.opacity = '1';
                        element.style.transform = 'translate(0, 0)';
                    }, index * 150);
                });
            }, 100);
        });
    </script>
}