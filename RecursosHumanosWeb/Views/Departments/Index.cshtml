@model X.PagedList.IPagedList<RecursosHumanosWeb.Models.Department>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Gestión de Departamentos";
}

<div class="index-container">
    @Html.AntiForgeryToken()
    <div class="page-header-v2 fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-sitemap"></i>
                Gestión de Departamentos
            </h1>
            <p class="page-subtitle">Administra los departamentos de la estructura organizacional</p>
        </div>
        <div class="header-actions">
            <a asp-action="Create" class="btn btn-create" aria-label="Crear nuevo departamento">
                <i class="fas fa-plus"></i>
                Crear Departamento
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success rounded-4 border-0 shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@successMessage
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
        </div>
    }

    <div class="filters-section slide-in-left">
        <div class="card filter-card-premium">
            <div class="filter-header-premium">
                <i class="fas fa-filter fa-lg"></i>
                <h5 class="m-0 fw-bold">Panel de Búsqueda</h5>
            </div>
            <div class="filter-body-premium">
                <form method="get" asp-action="Index">
                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Departamento</label>
                                <input name="descriptionFilter" value="@ViewBag.DescriptionFilter" class="form-control filter-input-pill" placeholder="Buscar por nombre" />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Estado en la aplicación</label>
                                <select name="statusFilter" class="form-control filter-input-pill form-select">
                                    <option value="">Todos los estados</option>
                                    <option value="true" selected="@(ViewBag.StatusFilter is true ? "selected" : null)">Activo</option>
                                    <option value="false" selected="@(ViewBag.StatusFilter is false ? "selected" : null)">Inactivo</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-4 pt-3 border-top gap-3">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold text-secondary border">
                            <i class="fas fa-undo me-2"></i>Limpiar
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                            <i class="fas fa-search me-2"></i>Aplicar Filtros
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-container fade-in">
            <div class="table-inner overflow-x-auto">
                <table class="data-table" aria-label="Tabla de departamentos">
                    <thead><tr><th class="text-center">ID</th><th>Departamento</th><th class="text-center">Estado</th><th class="text-center">Creación</th><th class="text-center">Acciones</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.Id</td>
                            <td><strong>@item.Description</strong></td>
                            <td class="text-center"><span class="v2-badge v2-badge-@(item.Status ? "success" : "danger")"><span class="v2-badge-dot"></span>@(item.Status ? "Activo" : "Inactivo")</span></td>
                            <td class="text-center">@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center"><div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Editar departamento"><i class="fas fa-edit"></i></a>
                                @if (item.Status)
                                {
                                    <a href="#" class="action-btn btn-delete" data-action="DeleteAjax" data-controller="Departments" data-id="@item.Id" title="Eliminar lógicamente" aria-label="Eliminar departamento"><i class="fas fa-trash"></i></a>
                                }
                            </div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="pagination-container-v2 fade-in">
            <div class="pagination-info-v2"><i class="fas fa-sitemap me-2 opacity-50"></i>Mostrando <span class="fw-bold">@Model.FirstItemOnPage</span> - <span class="fw-bold">@Model.LastItemOnPage</span> de <span class="fw-bold">@Model.TotalItemCount</span> departamentos</div>
            <div class="v2-pagination">
                @Html.PagedListPager(
                    Model,
                    page => Url.Action("Index", new { page, descriptionFilter = ViewBag.DescriptionFilter, statusFilter = ViewBag.StatusFilter }),
                    new PagedListRenderOptions
                    {
                        DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                        DisplayLinkToLastPage = PagedListDisplayMode.Always,
                        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                        DisplayLinkToNextPage = PagedListDisplayMode.Always,
                        DisplayLinkToIndividualPages = true,
                        MaximumPageNumbersToDisplay = 5,
                        DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                        UlElementClasses = new[] { "pagination" },
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
            </div>
        </div>
    }
    else
    {
        <div class="empty-state fade-in"><div class="empty-icon"><i class="fas fa-sitemap"></i></div><h3>No hay departamentos registrados</h3><p class="text-muted">Intenta ajustar los filtros de búsqueda.</p></div>
    }
</div>
