@model RecursosHumanosWeb.Models.ViewModels.SearchCutoffViewModel
@using System.Security.Claims
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Gestión de Periodos";
}

@section Styles {
    <!-- Corte Index uses global components from v2-site.css -->
}

<div class="index-container">
    <!-- Header Section -->
    <div class="page-header-v2 fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-calendar-alt"></i>
                Gestión de Periodos
            </h1>
            <p class="page-subtitle">Administra los períodos laborales del sistema</p>
        </div>
        <div class="header-actions">
            <authorize-section policy="RHOrAdmin">
                <a asp-action="Create" class="btn btn-create" aria-label="Crear nuevo periodo">
                    <i class="fas fa-plus"></i>
                    Crear Periodo
                </a>
            </authorize-section>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="filters-section slide-in-left">
        <div class="card filter-card-premium">
            <div class="filter-header-premium">
                <i class="fas fa-filter fa-lg"></i>
                <h5 class="m-0 fw-bold" style="letter-spacing: 0.5px;">Panel de Búsqueda</h5>
            </div>
            <div class="filter-body-premium">
                <form id="searchForm" method="get" asp-action="Index">
                    @Html.AntiForgeryToken()
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="filter-group">
                                <label class="fw-bold text-success small text-uppercase mb-2 ms-2">Vigencia Desde</label>
                                <div class="input-with-icon">
                                    <i class="fas fa-calendar-alt"></i>
                                    <input type="date" id="dateFrom" name="dateFrom" class="form-control filter-input-pill" value="@(ViewBag.DateFrom != null ? ((DateTime)ViewBag.DateFrom).ToString("yyyy-MM-dd") : "")" />
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="filter-group">
                                <label class="fw-bold text-danger small text-uppercase mb-2 ms-2">Vigencia Hasta</label>
                                <div class="input-with-icon">
                                    <i class="fas fa-calendar-check"></i>
                                    <input type="date" id="dateTo" name="dateTo" class="form-control filter-input-pill" value="@(ViewBag.DateTo != null ? ((DateTime)ViewBag.DateTo).ToString("yyyy-MM-dd") : "")" />
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Estatus del Período</label>
                                    <select id="statusId" name="statusId" class="form-control filter-input-pill form-select">
                                        <option value="" selected="@(ViewBag.StatusId == null ? "selected" : null)">Todos los estatus</option>
                                        @foreach (var st in (IEnumerable<RecursosHumanosWeb.Models.CutoffStatusType>)ViewBag.Statuses)
                                        {
                                            var icon = st.Color switch
                                            {
                                                "success" => "🟢",
                                                "secondary" => "🔒",
                                                "danger" => "🚫",
                                                _ => ""
                                            };
                                            <option value="@st.Id" selected="@(ViewBag.StatusId == st.Id ? "selected" : null)">@icon @st.Description</option>
                                        }
                                    </select>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top gap-3">
                        <button type="button" onclick="clearAllFilters()" class="btn btn-light rounded-pill px-4 fw-bold text-secondary border hover-shadow" style="transition: all 0.2s;">
                            <i class="fas fa-undo me-2"></i> Limpiar
                        </button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" 
                                style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); border: none;">
                            <i class="fas fa-search me-2"></i> Aplicar Filtros
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.Cutoffs.Any())
    {
        <!-- Table Section -->
        <div class="table-container fade-in">
            <div class="table-inner">
                <div class="overflow-x-auto">
                    <table id="cutoffsTable" class="data-table" style="width:100%; border: none; overflow: hidden; padding: 0;" aria-label="Tabla de periodos">
                        <thead>
                            <tr>
                                <th class="text-center">ID</th>
                                <th class="text-center">Inicia</th>
                                <th class="text-center">Termina</th>
                                <th class="text-center">Creación</th>
                                <th class="text-center">Modificación</th>
                                <th class="text-center">Estatus</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Cutoffs)
                            {
                                var createdBy = Model.Users.FirstOrDefault(u => u.Id == item.CreatedByUserId)?.Name ?? "-";
                                var updatedBy = Model.Users.FirstOrDefault(u => u.Id == item.UpdatedByUserId)?.Name ?? "-";
                                <tr>
                                    <td class="text-center">@item.Id</td>
                                    <td class="text-center"><strong>@(item.StartDate.ToString("dd/MM/yyyy") ?? "-")</strong></td>
                                    <td class="text-center"><strong>@(item.EndDate.ToString("dd/MM/yyyy") ?? "-")</strong></td>
                                    <td class="text-center">
                                        <div style="color: var(--text-medium); font-weight: 500;">
                                            <div style="font-size: 0.875rem;">@item.CreatedAt.ToString("dd/MM/yyyy")</div>
                                                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem;">@item.CreatedAt.ToString("h:mm tt")</div>
                                            </div>
                                        </td>
                                    <td class="text-center">
                                        @if (item.UpdatedAt.HasValue)
                                        {
                                            <div style="color: var(--text-medium); font-weight: 500;">
                                                <div style="font-size: 0.875rem;">@item.UpdatedAt.Value.ToString("dd/MM/yyyy")</div>
                                                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem;">@item.UpdatedAt.Value.ToString("h:mm tt")</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="font-style: italic; color: var(--text-muted);">Sin modificar</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="v2-badge v2-badge-@item.StatusColor">
                                            <span class="v2-badge-dot"></span>
                                            @item.StatusDescription
                                        </div>
                                    </td>
                            
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            @if (User.HasClaim("UserType", "1"))
                                            {
                                                if (item.CutoffStatusTypeId == 1)
                                                {
                                                    <a href="#" class="action-btn btn-warning" title="Cerrar Periodo" aria-label="Cerrar periodo" 
                                                       data-action="CloseAjax" data-controller="Cutoff" data-id="@item.Id">
                                                        <i class="fas fa-lock"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button class="action-btn opacity-50" disabled title="Este periodo ya no se puede modificar" style="cursor: not-allowed;">
                                                        <i class="fas fa-lock"></i>
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <button class="action-btn opacity-50" disabled title="Solo el administrador puede cerrar periodos" style="cursor: not-allowed;">
                                                    <i class="fas fa-ban"></i>
                                                </button>
                                            }

                                            <a asp-action="Details" asp-route-id="@item.Id" class="action-btn btn-view" title="Ver detalles" aria-label="Ver detalles del periodo">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th class="text-center">ID</th>
                                <th class="text-center">Inicia</th>
                                <th class="text-center">Termina</th>
                                <th class="text-center">Creación</th>
                                <th class="text-center">Modificación</th>
                                <th class="text-center">Estatus</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    
    <!-- Shared Pagination (Now visible for both mobile and desktop) -->
    <div class="pagination-container-v2 fade-in">
        <div class="pagination-info-v2">
            <i class="fas fa-calendar-check me-2 opacity-50"></i>
            Mostrando <span class="fw-bold">@Model.Cutoffs.FirstItemOnPage</span> - <span class="fw-bold">@Model.Cutoffs.LastItemOnPage</span> de <span class="fw-bold">@Model.Cutoffs.TotalItemCount</span> periodos
        </div>

        <div class="v2-pagination">
            @Html.PagedListPager(
                Model.Cutoffs,
                page => Url.Action("Index", new
                {
                    page,
                    dateFrom = Context.Request.Query["dateFrom"],
                    dateTo = Context.Request.Query["dateTo"],
                    statusId = Context.Request.Query["statusId"],
                    pageSize = Context.Request.Query["pageSize"]
                }),
                new PagedListRenderOptions
                {
                    DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                    DisplayLinkToLastPage = PagedListDisplayMode.Always,
                    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                    DisplayLinkToNextPage = PagedListDisplayMode.Always,
                    DisplayLinkToIndividualPages = true,
                    MaximumPageNumbersToDisplay = 5,
                    DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                    UlElementClasses = new[] { "pagination" },
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" }
                })
        </div>
    </div>

    <!-- Empty State -->
    @if (!Model.Cutoffs.Any())
    {
        <div class="empty-state fade-in">
            <div class="empty-icon">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <h3 class="mt-3">No hay periodos registrados</h3>
            <p class="text-muted">Intenta ajustar los filtros de búsqueda</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function(){
            // Inicializar select2 en el select de usuarios para búsqueda remota
            $(document).ready(function(){
                // Initialize Status Filter with premium styles
                $('#statusId').select2({
                    placeholder: 'Todos los estatus',
                    width: '100%',
                    allowClear: true,
                    minimumResultsForSearch: Infinity // Hide search box
                });
            });
        })();
        function clearAllFilters() {
            // Limpiar inputs estándar
            $('#dateFrom').val('');
            $('#dateTo').val('');
            
            // Limpiar Select2 (requiere val(null) y trigger('change'))
            $('#statusId').val(null).trigger('change');
            
            // Opcional: Notificar al usuario antes de recargar
            const toastMessage = '✅ Filtros limpiados';
            if (typeof showToast === 'function') {
                showToast(toastMessage, 'success');
            } else {
                showNotification(toastMessage, 'success');
            }

            // Pequeño delay para que el usuario vea la notificación antes de recargar
            setTimeout(() => {
                document.getElementById('searchForm').submit();
            }, 300);
        }

        function showNotification(message, type = 'info') {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                },
                customClass: {
                    popup: 'swal-popup-custom',
                    title: 'swal-title-custom'
                }
            });
            Toast.fire({ icon: type, title: message });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const elements = document.querySelectorAll('.fade-in, .slide-in-left');
            elements.forEach(element => {
                element.style.opacity = '0';
                element.style.transform = element.classList.contains('slide-in-left')
                    ? 'translateY(20px)'
                    : 'translateY(20px)';
            });

            setTimeout(() => {
                elements.forEach((element, index) => {
                    setTimeout(() => {
                        element.style.transition = 'all 0.6s ease-out';
                        element.style.opacity = '1';
                        element.style.transform = 'translate(0, 0)';
                    }, index * 150);
                });
            }, 100);
        });
    </script>
}