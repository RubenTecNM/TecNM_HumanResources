@model RecursosHumanosWeb.Models.Cutoff
@{
    ViewData["Title"] = "Editar Periodo";
}

<div class="details-container fade-in">
    <!-- Header separado -->
    <div class="permission-header">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-edit"></i>
                Editar Periodo #@Model.Id
            </h1>
            <p class="page-subtitle">Actualice los límites temporales del periodo laboral</p>
        </div>
        <div class="header-decoration">
            <div class="floating-icon">
                <i class="fas fa-calendar-check"></i>
            </div>
        </div>
    </div>

    <!-- Card de Edición Premium -->
    <div class="card details-card animate__animated animate__fadeInUp rounded-3">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" id="editPeriodoForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                
                <div class="row justify-content-center">
                    <div class="col-12 col-lg-10">
                        <h3 class="section-title h5 text-dark d-flex align-items-center gap-2 mb-4">
                            <i class="fas fa-clock text-primary"></i>
                            Configuración del Periodo
                        </h3>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="StartDate" class="form-label fw-bold text-secondary">Fecha de Inicio</label>
                                    <div class="input-group input-group-lg shadow-sm">
                                        <span class="input-group-text bg-white border-end-0 text-primary">
                                            <i class="fas fa-calendar-day"></i>
                                        </span>
                                        <input asp-for="StartDate" class="form-control border-start-0 ps-0" type="date" />
                                    </div>
                                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="EndDate" class="form-label fw-bold text-secondary">Fecha de Término</label>
                                    <div class="input-group input-group-lg shadow-sm">
                                        <span class="input-group-text bg-white border-end-0 text-info">
                                            <i class="fas fa-hourglass-end"></i>
                                        </span>
                                        <input asp-for="EndDate" class="form-control border-start-0 ps-0" type="date" />
                                    </div>
                                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Campos ocultos técnicos si es necesario mantenerlos -->
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="CreatedByUserId" />
                        <input type="hidden" asp-for="CutoffStatusTypeId" />

                        <div class="mt-4 p-3 border-start border-info border-3 bg-light rounded-end">
                            <p class="small text-secondary mb-0">
                                <i class="fas fa-info-circle text-info me-1"></i> 
                                Al modificar las fechas, asegúrese de que el nuevo rango no afecte periodos adyacentes.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Footer de Acción -->
                <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                        <i class="fas fa-arrow-left me-2"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-lg hover-scale">
                        <i class="fas fa-check-circle me-2"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
