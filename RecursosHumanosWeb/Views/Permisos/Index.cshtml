@using X.PagedList.Mvc.Core
@model RecursosHumanosWeb.Models.ViewModels.SearchPermissionsViewModel

@{
    ViewData["Title"] = "Gestión de Permisos";
    int currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
    bool isRH = User.HasClaim("TipoUsuario", "3");
    bool isAdministrador = User.HasClaim("TipoUsuario", "1");
    int currentCourtId = ViewBag.CurrentCourtId ?? 0;
}

@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />

    <link href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css" rel="stylesheet" />
    <style>
        /* Mobile-specific adjustments utilizing Site.css variables without external file */
        @@media (max-width: 992px) {
            .table-container { display: none !important; }
            .mobile-view-container { display: flex; flex-direction: column; gap: 1rem; }
            
            .mobile-card-header {
                cursor: pointer;
                transition: background-color 0.2s ease;
            }
            .mobile-card-header:hover { background-color: var(--surface-alt); }
            
            .rotate-icon { transition: transform 0.3s ease; }
            .expanded .rotate-icon { transform: rotate(180deg); }
            
            .expandable-content {
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }
            .expanded .expandable-content {
                max-height: 500px; /* limit for transition */
                border-top: 1px solid var(--border-light);
            }
        }
        @@media (min-width: 993px) {
            .mobile-view-container { display: none !important; }
        }
    </style>
}

<div class="index-container">
    @Html.AntiForgeryToken()
    <div class="permission-header fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-file-alt"></i>
                Gestión de Permisos
            </h1>
            <p class="page-subtitle">Administra los permisos solicitados</p>
        </div>
        <div class="header-decoration">
            <div class="header-actions">
                <a asp-action="Create" class="btn btn-create" aria-label="Crear nuevo permiso">
                    <i class="fas fa-plus"></i>
                    Crear Permiso
                </a>
            </div>
        </div>
    </div>
    
     <div class="filters-section slide-in-left">
        <div class="card filter-card-premium">
            <div class="filter-header-premium">
                <i class="fas fa-filter fa-lg"></i>
                <h5 class="m-0 fw-bold" style="letter-spacing: 0.5px;">Panel de Búsqueda</h5>
            </div>
            <div class="filter-body-premium">
                <form id="searchForm" method="get" asp-action="Index">
                    <div class="row g-4">
                        <authorize-section policy="AutorizadorOrAbove">
                            <div class="col-md-3">
                                <div class="filter-group">
                                    <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Colaborador</label>
                                    <select id="nombreUsuario" name="nombreUsuario" class="form-control user-autocomplete w-100">
                                        <option value="">Todos los empleados</option>
                                    </select>
                                </div>
                            </div>
                        </authorize-section>
                        <authorize-section policy="RHOrAdmin">
                            <div class="col-md-3">
                                <div class="filter-group">
                                    <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Área Operativa</label>
                                    <select id="idArea" name="idArea" class="form-control filter-input-pill form-select">
                                        <option value="">Todas las áreas</option>
                                        @foreach (var area in Model.Areas)
                                        {
                                            <option value="@area.Id" selected="@(Model.SelectedArea == area.Id ? "selected" : null)">
                                                @area.Descripcion
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </authorize-section>
                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-success small text-uppercase mb-2 ms-2">Desde el</label>
                                <input type="date" id="delDia" name="delDia" class="form-control filter-input-pill" value="@ViewBag.DelDia" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-danger small text-uppercase mb-2 ms-2">Hasta el</label>
                                <input type="date" id="alDia" name="alDia" class="form-control filter-input-pill" value="@ViewBag.AlDia" />
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-4 pt-3 border-top gap-3">
                        <button type="button" onclick="clearAllFilters()" class="btn btn-light rounded-pill px-4 fw-bold text-secondary border hover-shadow" style="transition: all 0.2s;">
                            <i class="fas fa-undo me-2"></i> Limpiar
                        </button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" 
                                style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); border: none;">
                            <i class="fas fa-search me-2"></i> Aplicar Filtros
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.Permisos.Any())
    {
        <!-- MOBILE CARD VIEW (Visible < 992px) -->
        <div class="mobile-view-container fade-in">
            @foreach (var item in Model.Permisos)
            {
                var uniqueId = "mob-" + item.Id;
                
                // Cloudflare-inspired varied palette (High contrast, distinct tokens)
                // 0: Indigo (Standard)
                // 1: Emerald (Success/Fresh)
                // 2: Amber (Attention)
                // 3: Rose (Urgent/Distinct)
                // 4: Sky (Calm)
                var colorIndex = item.Id % 5;
                var boxGradient = "";
                var accentColor = "";
                
                switch (colorIndex) {
                    case 0: // Indigo
                        boxGradient = "linear-gradient(135deg, #6366f1, #4338ca)";
                        accentColor = "#4338ca";
                        break;
                    case 1: // Emerald
                        boxGradient = "linear-gradient(135deg, #10b981, #059669)";
                        accentColor = "#059669";
                        break;
                    case 2: // Amber
                        boxGradient = "linear-gradient(135deg, #f59e0b, #d97706)";
                        accentColor = "#d97706";
                        break;
                    case 3: // Rose
                        boxGradient = "linear-gradient(135deg, #f43f5e, #e11d48)";
                        accentColor = "#e11d48";
                        break;
                    case 4: // Sky
                        boxGradient = "linear-gradient(135deg, #0ea5e9, #0284c7)";
                        accentColor = "#0284c7";
                        break;
                }

                <div class="card shadow-sm border-0 mb-3 mobile-card" id="card-@uniqueId" style="border-radius: 12px; overflow: hidden; transition: all 0.2s ease;">
                    <!-- Clickable Header - Cleaner, White Background, Color Accents -->
                    <div class="mobile-card-header p-3 d-flex align-items-center justify-content-between bg-white position-relative" 
                        onclick="toggleMobileCard('@uniqueId')"
                        style="border-left: 4px solid @accentColor;">
                        
                        <div class="d-flex align-items-center gap-3 flex-grow-1">
                            <!-- ID Box (User Initial) -->
                            <div class="rounded-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                                style="width: 48px; height: 48px; background: @boxGradient; font-size: 1.25rem; flex-shrink: 0;">
                                @(item.Nombre?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            
                            <!-- Info -->
                            <div class="flex-grow-1" style="min-width: 0;">
                                <h6 class="mb-0 fw-bold text-dark text-truncate" style="font-size: 1rem;">
                                    @(item.Nombre ?? "Usuario")
                                </h6>
                                <div class="d-flex align-items-center mt-1 flex-wrap gap-2">
                                    <small class="text-muted" style="font-size: 0.8rem;">Solicitud #@item.Id</small>
                                    
                                    <!-- Status Badge (Pill style matching reference) -->
                                    <span class="badge rounded-pill border d-none d-sm-inline-flex align-items-center px-2 py-0" 
                                        style="@(item.Revisado ? "background-color: #ecfdf5; color: #059669; border-color: #a7f3d0 !important;" : "background-color: #fffbeb; color: #d97706; border-color: #fde68a !important;") font-weight: 600; height: 22px;">
                                        <i class="fas @(item.Revisado ? "fa-check" : "fa-clock") me-1" style="font-size: 0.7rem;"></i>
                                        @(item.Revisado ? "REVISADO" : "PENDIENTE")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Chevron -->
                        <div class="ms-3 text-muted">
                            <i class="fas fa-chevron-down rotate-icon" style="transition: transform 0.3s ease;"></i>
                        </div>
                    </div>

                    <!-- Expandable Content -->
                    <div class="expandable-content bg-light" id="body-@uniqueId" style="border-top: 1px solid var(--border-light);">
                        <div class="p-3">
                            <!-- XS Screen Status -->
                            <div class="d-block d-sm-none mb-3">
                                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 @(item.Revisado ? "bg-success-subtle border border-success-subtle" : "bg-warning-subtle border border-warning-subtle")">
                                    <span class="fw-semibold @(item.Revisado ? "text-success" : "text-warning")">Estado:</span>
                                    <span class="badge rounded-pill @(item.Revisado ? "bg-success" : "bg-warning text-dark")">
                                        @(item.Revisado ? "Revisado" : "Pendiente")
                                    </span>
                                </div>
                            </div>

                            <!-- Dates Grid -->
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="p-2 bg-white border border-light rounded-3 shadow-sm h-100">
                                        <small class="d-block text-muted mb-1" style="font-size: 0.7rem;">
                                            <i class="fas fa-calendar-alt me-1"></i> Creación
                                        </small>
                                        <span class="fw-semibold text-dark small">
                                            @(item.FechaCreacion != default ? item.FechaCreacion.ToString("dd MMM yyyy") : "-")
                                        </span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 bg-white border border-light rounded-3 shadow-sm h-100">
                                        <small class="d-block text-muted mb-1" style="font-size: 0.7rem;">
                                            <i class="fas fa-sync-alt me-1"></i> Modificación
                                        </small>
                                        <span class="fw-semibold text-dark small">
                                            @(item.FechaModificacion != default ? item.FechaModificacion?.ToString("dd MMM yyyy") : "-")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="row g-2">
                                @{
                                    bool isOwner = item.IdUsuarioSolicita == currentUserId;
                                    bool inActiveCourt = item.IdCorte == currentCourtId;
                                    bool canEdit = (isAdministrador || isRH || isOwner) && inActiveCourt;
                                    bool canDelete = (isAdministrador || isRH || isOwner) && (!item.Revisado || inActiveCourt);
                                }

                                <authorize-section policy="AutorizadorOnly">
                                    @if (!item.Revisado && inActiveCourt)
                                    {
                                        <div class="col-12">
                                            <a asp-action="Review" asp-route-id="@item.Id" class="btn btn-sm btn-success w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm text-white" style="background: var(--gradient-glass);">
                                                <i class="fas fa-check"></i> Revisar Solicitud
                                            </a>
                                        </div>
                                    }
                                    <div class="col-12">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-success w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm text-white">
                                            <i class="fas fa-eye"></i> Ver Detalle
                                        </a>
                                    </div>
                                </authorize-section>

                                <authorize-section policy="!AutorizadorOnly">
                                    @if (canEdit)
                                    {
                                        <div class="col-4">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm text-white">
                                                <i class="fas fa-pen"></i> Editar
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-4">
                                            <button class="btn btn-sm btn-secondary w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm text-white opacity-50" disabled title="No se puede editar fuera del corte vigente">
                                                <i class="fas fa-lock"></i>
                                            </button>
                                        </div>
                                    }

                                    <div class="col-4">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-success w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm text-white">
                                            <i class="fas fa-eye"></i> Ver
                                        </a>
                                    </div>

                                    @if (canDelete)
                                    {
                                        <div class="col-4">
                                            <a href="#" class="btn btn-sm btn-danger w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm text-white"
                                            data-action="DeleteAjax" 
                                            data-controller="Permisos" 
                                            data-id="@item.Id">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-4">
                                            <button class="btn btn-sm btn-secondary w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm text-white opacity-50" disabled title="No se puede eliminar un permiso revisado de un corte cerrado">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    }
                                </authorize-section>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- DESKTOP TABLE VIEW (Hidden < 992px via CSS) -->
        <div class="table-container fade-in">
            <div class="card">
                <div class="table-inner">
                    <div class="overflow-x-auto">
                        <table id="permisosTable" class="data-table" style="width:100%; border: none; overflow: hidden; padding: 0;" aria-label="Tabla de permisos">
                            <thead>
                                <tr>
                                    <th class="text-center">ID</th>
                                    <th class="text-center">Solicitante</th>
                                    <th class="text-center">Revisado</th>
                                    <th class="text-center">Creación</th>
                                    <th class="text-center">Modificación</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Permisos)
                                {
                                    <tr>
                                        <td class="text-center" data-label="ID">@item.Id</td>
                                        <td data-label="Solicitante"><strong>@(item.Nombre ?? "-")</strong></td>
                                        <td class="text-center" data-label="Revisado">
                                            <span class="badge-soft @(item.Revisado ? "badge-success-soft" : "badge-danger-soft")">
                                                @(item.Revisado ? "Sí" : "No")
                                            </span>
                                        </td>
                                        <td class="text-center" data-label="Creación">
                                            @if (item.FechaCreacion != default)
                                            {
                                                <div style="color: var(--text-medium); font-weight: 500;">
                                                    <div style="font-size: 0.875rem;">@item.FechaCreacion.ToString("dd/MM/yyyy")</div>
                                                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem;">@item.FechaCreacion.ToString("h:mm tt")</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="font-style: italic; color: var(--text-muted);">Sin crear</div>
                                            }
                                        </td>
                                        <td class="text-center" data-label="Modificación">
                                            @if (item.FechaModificacion != default)
                                            {
                                                <div style="color: var(--text-medium); font-weight: 500;">
                                                    <div style="font-size: 0.875rem;">@item.FechaModificacion?.ToString("dd/MM/yyyy")</div>
                                                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem;">@item.FechaModificacion?.ToString("h:mm tt")</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="font-style: italic; color: var(--text-muted);">Sin modificar</div>
                                            }
                                        </td>
                                        <!-- Dentro del <td> de Acciones -->
                                        <td class="text-center" data-label="Acciones">
                                            <div class="flex justify-center gap-2">
                                                @* LÓGICA DE BOTONES SEGÚN ROL Y ESTADO *@
                                                
                                                <authorize-section policy="AutorizadorOnly">
                                                    @if (!item.Revisado)
                                                    {
                                                        <a asp-action="Review" asp-route-id="@item.Id" class="action-btn btn-approve" title="Revisar y autorizar permiso" aria-label="Revisar permiso" style="background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);">
                                                            <i class="fas fa-user-check"></i>
                                                        </a>
                                                    }
                                                </authorize-section>
                                                 <authorize-section policy="!AutorizadorOnly">
                                                    @{
                                                        bool isOwnerDesktop = item.IdUsuarioSolicita == currentUserId;
                                                        bool inActiveCourtDesktop = item.IdCorte == currentCourtId;
                                                        bool canEditDesktop = (isAdministrador || isRH || isOwnerDesktop) && inActiveCourtDesktop;
                                                        bool canDeleteDesktop = (isAdministrador || isRH || isOwnerDesktop) && (!item.Revisado || inActiveCourtDesktop);
                                                    }

                                                    @if (canEditDesktop)
                                                    {
                                                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Editar permiso" aria-label="Editar permiso">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button class="action-btn btn-secondary opacity-50" disabled title="No se puede editar fuera del corte vigente" style="cursor: not-allowed; border: none; background: #e2e8f0; color: #64748b;">
                                                            <i class="fas fa-lock"></i>
                                                        </button>
                                                    }

                                                    @if (canDeleteDesktop)
                                                    {
                                                        <a href="#" class="action-btn btn-delete" data-action="DeleteAjax" data-controller="Permisos" data-id="@item.Id" title="Eliminar permiso" aria-label="Eliminar permiso">
                                                            <i class="fas fa-trash"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button class="action-btn btn-secondary opacity-50" disabled title="No se puede eliminar un permiso revisado de un corte cerrado" style="cursor: not-allowed; border: none; background: #e2e8f0; color: #64748b;">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    }
                                                </authorize-section>

                                                @* 4. VER DETALLES: Siempre visible para TODOS *@
                                                <a asp-action="Details" asp-route-id="@item.Id" class="action-btn btn-view" title="Ver detalles" aria-label="Ver detalles del permiso">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="text-center">ID</th>
                                    <th class="text-center">Solicitante</th>
                                    <th class="text-center">Revisado</th>
                                    <th class="text-center">Creación</th>
                                    <th class="text-center">Modificación</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    }

    <!-- SHARED PAGINATION (Visible in both views) -->
    @if (Model.Permisos.Any())
    {
        <div class="pagination-container mt-4 fade-in">
            <div class="pagination-info text-muted small mb-2 text-center text-md-start">
                Mostrando @Model.Permisos.FirstItemOnPage - @Model.Permisos.LastItemOnPage de @Model.Permisos.TotalItemCount permisos
            </div>

            <div class="d-flex justify-content-center justify-content-md-end">
                @Html.PagedListPager(
                Model.Permisos,
                                page => Url.Action("Index", new
                                {
                                    page,
                                    sortOrder = ViewBag.CurrentSort,
                                    nombreFilter = ViewBag.NombreFilter,
                                    correoFilter = ViewBag.CorreoFilter,
                                    departamentoFilter = ViewBag.DepartamentoFilter,
                                    estadoFilter = ViewBag.EstadoFilter
                                }),
                                new PagedListRenderOptions
                                {
                                    DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                                    DisplayLinkToLastPage = PagedListDisplayMode.Always,
                                    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                                    DisplayLinkToNextPage = PagedListDisplayMode.Always,
                                    DisplayLinkToIndividualPages = true,
                                    MaximumPageNumbersToDisplay = 5,
                                    DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                                    UlElementClasses = new[] { "pagination", "pagination-sm", "m-0" },
                                    LiElementClasses = new[] { "page-item" },
                                    PageClasses = new[] { "page-link" }
                                })
            </div>
        </div>
    }

    @if (!Model.Permisos.Any())
    {
        <div class="empty-state fade-in">
            <div class="empty-icon">
                <i class="fas fa-file-alt"></i>
            </div>
            <h3>No hay permisos registrados</h3>
            <p class="text-muted">Intenta ajustar los filtros de búsqueda</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function(){
            // Mobile Card Expand/Collapse Logic (Accordion)
            window.toggleMobileCard = function(id) {
                const selectedCard = document.getElementById('card-' + id);
                
                // 1. Close ALL other open cards first (Auto-closing behavior)
                document.querySelectorAll('.mobile-card.expanded').forEach(card => {
                    // Skip the one we just clicked if it was already open (so let it toggle normally)
                    if (card.id !== 'card-' + id) {
                        card.classList.remove('expanded');
                    }
                });

                // 2. Toggle the selected card
                if (selectedCard.classList.contains('expanded')) {
                    selectedCard.classList.remove('expanded');
                } else {
                    selectedCard.classList.add('expanded');
                }
            };

            $(document).ready(function(){
                // Inicializar select2 para filtro de usuarios en Permisos Index
                (function(){
                    var $select = $('#nombreUsuario');
                    var valueMode = $select.data('user-value') || 'text';
                    $select.select2({
                        placeholder: '-- Seleccionar Usuario --',
                        minimumInputLength: 2,
                        allowClear: true,
                        ajax: {
                            url: '/Usuarios/SearchUsers',
                            dataType: 'json',
                            delay: 250,
                            data: function (params) { return { term: params.term }; },
                            processResults: function (data) {
                                var results = data.map(function(item){
                                    return {
                                        id: valueMode === 'text' ? item.text : item.id,
                                        text: item.text,
                                        areaId: item.areaId
                                    };
                                });
                                return { results: results };
                            },
                            cache: true
                        }
                    });

                    // When a user is selected, store the appropriate value into a hidden input for submission
                    if ($('#nombreUsuarioHidden').length === 0) {
                        $('<input>').attr({ type: 'hidden', id: 'nombreUsuarioHidden', name: 'nombreUsuario', value: '' }).appendTo('#searchForm');
                    }
                    $select.on('select2:select', function(e) {
                        var data = e.params.data;
                        if (valueMode === 'text') $('#nombreUsuarioHidden').val(data.text);
                        else $('#nombreUsuarioHidden').val(data.id);
                    });
                    $select.on('select2:clear', function() { $('#nombreUsuarioHidden').val(''); });
                })();

                $('#nombreUsuario').on('focus', function () { $(this).select2('open'); });
                $('#nombreUsuario').on('select2:open', function () { const sf = document.querySelector('.select2-container--open .select2-search__field'); if (sf) sf.focus(); });

                // Initialize Select2 for Area Filter
                if ($('#idArea').length > 0) {
                    $('#idArea').select2({
                        placeholder: 'Todas las áreas',
                        width: '100%',
                        allowClear: true
                    });
                }

                // bind clear function
                window.clearAllFilters = function () {
                    const nombreUsuario = document.getElementById('nombreUsuario');
                    const idArea = document.getElementById('idArea');
                    const delDia = document.getElementById('delDia');
                    const alDia = document.getElementById('alDia');

                    if (nombreUsuario) $(nombreUsuario).val(null).trigger('change');
                    if (idArea) idArea.value = '';
                    if (delDia) delDia.value = '';
                    if (alDia) alDia.value = '';

                    document.getElementById('searchForm').submit();
                };
            });
        })();

        document.addEventListener('DOMContentLoaded', function () {
            const elements = document.querySelectorAll('.fade-in, .slide-in-left');
            elements.forEach(element => {
                element.style.opacity = '0';
                element.style.transform = element.classList.contains('slide-in-left')
                    ? 'translateY(20px)'
                    : 'translateY(20px)';
            });

            setTimeout(() => {
                elements.forEach((element, index) => {
                    setTimeout(() => {
                        element.style.transition = 'all 0.6s ease-out';
                        element.style.opacity = '1';
                        element.style.transform = 'translate(0, 0)';
                    }, index * 150);
                });
            }, 100);
        });
    </script>
}