@using X.PagedList.Mvc.Core
@using X.PagedList
@model IPagedList<RecursosHumanosWeb.Models.DTOs.AuditoriaDTO>

@{
    ViewData["Title"] = "Bitácora de Auditoría";
    var tablas = ViewBag.IdTablaList as List<RecursosHumanosWeb.Models.Tabla>;
}

@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <style>
        .json-viewer {
            background-color: #f8f9fa;
            border-radius: 4px;
            padding: 10px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.85rem;
            max-height: 300px;
            overflow-y: auto;
            white-space: pre-wrap;
        }
        /* Origen Badges */
        .badge-origin {
            font-weight: 500;
            padding: 0.35em 0.65em;
            border-radius: 50rem;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.75rem;
        }
        .badge-origin i { font-size: 0.8rem; }
        
        .origin-web { background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
        .origin-api { background-color: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
        .origin-system { background-color: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff; }
        .origin-job { background-color: #ffedd5; color: #c2410c; border: 1px solid #fed7aa; }
        .origin-ldap { background-color: #cffafe; color: #0e7490; border: 1px solid #a5f3fc; }
        .origin-migration { background-color: #fce7f3; color: #be185d; border: 1px solid #fbcfe8; }
        .origin-default { background-color: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }

        /* Mobile-specific adjustments utilizing Site.css variables without external file */
        @@media (max-width: 992px) {
            .table-container { display: none !important; }
            .mobile-view-container { display: flex; flex-direction: column; gap: 1rem; }
            
            .mobile-card-header {
                cursor: pointer;
                transition: background-color 0.2s ease;
            }
            .mobile-card-header:hover { background-color: var(--surface-alt); }
            
            .rotate-icon { transition: transform 0.3s ease; }
            .expanded .rotate-icon { transform: rotate(180deg); }
            
            .expandable-content {
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }
            .expanded .expandable-content {
                max-height: 500px; /* limit for transition */
                border-top: 1px solid var(--border-light);
            }
        }
        @@media (min-width: 993px) {
            .mobile-view-container { display: none !important; }
        }
    </style>
    <link href="~/css/site.css" rel="stylesheet" />

}

<div class="index-container">
    <div class="permission-header fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-history"></i>
                Auditoría del Sistema
            </h1>
            <p class="page-subtitle">Rastreo de cambios y operaciones en la base de datos</p>
        </div>
        <div class="header-decoration">
            <div class="floating-icon">
                <i class="fas fa-clipboard-list"></i>
            </div>
        </div>
    </div>

    <div class="filters-section slide-in-left">
        <div class="card filter-card-premium">
            <div class="filter-header-premium">
                <i class="fas fa-filter fa-lg"></i>
                <h5 class="m-0 fw-bold" style="letter-spacing: 0.5px;">Panel de Búsqueda</h5>
            </div>
            <div class="filter-body-premium">
                <form id="searchForm" method="get" asp-action="Index">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Tabla o Entidad</label>
                                <select id="idTabla" name="idTabla" class="form-control filter-input-pill form-select">
                                    <option value="">Todas las tablas</option>
                                    @foreach (var tabla in tablas)
                                    {
                                        <option value="@tabla.Id" selected="@(ViewBag.IdTabla == tabla.Id ? "selected" : null)">
                                            @tabla.Descripcion
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="filter-group">
                                <label class="fw-bold text-success small text-uppercase mb-2 ms-2">Desde el</label>
                                <input type="date" id="fechaDesde" name="fechaDesde" class="form-control filter-input-pill" value="@(ViewBag.FechaDesde?.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="filter-group">
                                <label class="fw-bold text-danger small text-uppercase mb-2 ms-2">Hasta el</label>
                                <input type="date" id="fechaHasta" name="fechaHasta" class="form-control filter-input-pill" value="@(ViewBag.FechaHasta?.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-4 pt-3 border-top gap-3">
                        <button type="button" onclick="clearAllFilters()" class="btn btn-light rounded-pill px-4 fw-bold text-secondary border hover-shadow" style="transition: all 0.2s;">
                            <i class="fas fa-undo me-2"></i> Limpiar
                        </button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" 
                                style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); border: none;">
                            <i class="fas fa-search me-2"></i> Aplicar Filtros
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- MOBILE CARD VIEW (Visible < 992px) -->
        <div class="mobile-view-container fade-in">
            @foreach (var item in Model)
            {
                var uniqueId = "mob-" + item.IdRegistro; 
                var badgeClass = item.Accion.Contains("POST") ? "background-color: #ecfdf5; color: #059669; border-color: #a7f3d0 !important;" : 
                                item.Accion.Contains("PUT") ? "background-color: #fffbeb; color: #d97706; border-color: #fde68a !important;" :
                                item.Accion.Contains("DELETE") ? "background-color: #fef2f2; color: #ef4444; border-color: #fecaca !important;" : 
                                "background-color: #eff6ff; color: #3b82f6; border-color: #bfdbfe !important;";
                
                var iconClass = item.Accion.Contains("POST") ? "fa-plus" : 
                                item.Accion.Contains("PUT") ? "fa-pen" :
                                item.Accion.Contains("DELETE") ? "fa-trash" : "fa-info";

                // Origin Logic
                var originClass = "origin-default";
                var originIcon = "fa-question";
                var originText = item.TipoOrigenDesc ?? "Desconocido";

                if (originText.Contains("Web")) { originClass = "origin-web"; originIcon = "fa-user"; }
                else if (originText.Contains("API")) { originClass = "origin-api"; originIcon = "fa-key"; }
                else if (originText.Contains("Sistema")) { originClass = "origin-system"; originIcon = "fa-robot"; }
                else if (originText.Contains("Job")) { originClass = "origin-job"; originIcon = "fa-clock"; }
                else if (originText.Contains("LDAP")) { originClass = "origin-ldap"; originIcon = "fa-sync"; }

                // Cloudflare-inspired varied palette
                var colorIndex = (item.IdRegistro % 5);
                var boxGradient = "";
                var accentColor = "";
                
                switch (colorIndex) {
                    case 0: // Indigo
                        boxGradient = "linear-gradient(135deg, #6366f1, #4338ca)";
                        accentColor = "#4338ca";
                        break;
                    case 1: // Emerald
                        boxGradient = "linear-gradient(135deg, #10b981, #059669)";
                        accentColor = "#059669";
                        break;
                    case 2: // Amber
                        boxGradient = "linear-gradient(135deg, #f59e0b, #d97706)";
                        accentColor = "#d97706";
                        break;
                    case 3: // Rose
                        boxGradient = "linear-gradient(135deg, #f43f5e, #e11d48)";
                        accentColor = "#e11d48";
                        break;
                    case 4: // Sky
                        boxGradient = "linear-gradient(135deg, #0ea5e9, #0284c7)";
                        accentColor = "#0284c7";
                        break;
                }

                <div class="card shadow-sm border-0 mb-3 mobile-card" id="card-@uniqueId" style="border-radius: 12px; overflow: hidden; transition: all 0.2s ease;">
                    <!-- Clickable Header -->
                    <div class="mobile-card-header p-3 d-flex align-items-center justify-content-between bg-white position-relative" 
                        onclick="toggleMobileCard('@uniqueId')"
                        style="border-left: 4px solid @accentColor;">
                        
                        <div class="d-flex align-items-center gap-3 flex-grow-1">
                            <!-- ID Box (Initial of Table) -->
                            <div class="rounded-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                                style="width: 48px; height: 48px; background: @boxGradient; font-size: 1.25rem; flex-shrink: 0;">
                                @(item.Tabla.Length > 0 ? item.Tabla.Substring(0, 1).ToUpper() : "A")
                            </div>
                            
                            <!-- Info -->
                            <div class="flex-grow-1" style="min-width: 0;">
                                <h6 class="mb-0 fw-bold text-dark text-truncate" style="font-size: 1rem;">
                                    @item.Tabla
                                </h6>
                                <div class="d-flex align-items-center mt-1 flex-wrap gap-2">
                                    <span class="badge-origin @originClass py-0" style="height: 22px;">
                                        <i class="fas @originIcon" style="font-size: 0.7rem;"></i> @originText
                                    </span>
                                    
                                    <!-- Status Badge (Action) -->
                                    <span class="badge rounded-pill border d-none d-sm-inline-flex align-items-center px-2 py-0" 
                                        style="@badgeClass font-weight: 600; height: 22px;">
                                        @item.Accion
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Chevron -->
                        <div class="ms-3 text-muted">
                            <i class="fas fa-chevron-down rotate-icon" style="transition: transform 0.3s ease;"></i>
                        </div>
                    </div>

                    <!-- Expandable Content -->
                    <div class="expandable-content bg-light" id="body-@uniqueId" style="border-top: 1px solid var(--border-light);">
                        <div class="p-3">
                            <!-- Details Grid -->
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="p-2 bg-white border border-light rounded-3 shadow-sm h-100">
                                        <small class="d-block text-muted mb-1" style="font-size: 0.7rem;">
                                            <i class="fas fa-calendar-alt me-1"></i> Fecha
                                        </small>
                                        <span class="fw-semibold text-dark small">
                                            @item.FechaCreacion.ToString("dd MMM yyyy")
                                        </span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 bg-white border border-light rounded-3 shadow-sm h-100">
                                        <small class="d-block text-muted mb-1" style="font-size: 0.7rem;">
                                            <i class="fas fa-user me-1"></i> Usuario
                                        </small>
                                        <span class="fw-semibold text-dark small">
                                            @item.Usuario
                                        </span>
                                    </div>
                                </div>
                                @if(!string.IsNullOrEmpty(item.ApiKeyDesc) && item.ApiKeyDesc != "N/A") {
                                <div class="col-12">
                                    <div class="p-2 bg-white border border-light rounded-3 shadow-sm">
                                        <small class="d-block text-muted mb-1" style="font-size: 0.7rem;">
                                            <i class="fas fa-key me-1"></i> Detalle Origen
                                        </small>
                                        <span class="fw-semibold text-dark small">
                                            @item.ApiKeyDesc
                                        </span>
                                    </div>
                                </div>
                                }
                            </div>

                            <!-- Action Buttons -->
                            <div class="row g-2">
                                <div class="col-12">
                                    <button type="button" class="btn btn-sm btn-success w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm text-white"
                                            onclick="showAuditDetails(@item.Id)">
                                        <i class="fas fa-eye"></i> Ver Datos Anteriores
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="table-container fade-in mb-4">
            <div class="table-inner">
                <div class="overflow-x-auto">
                    <table class="data-table" style="width:100%; border: none; overflow: hidden; padding: 0;">
                        <thead>
                            <tr>
                                <th class="text-center">ID</th>
                                <th class="text-center">Fecha</th>
                                <th class="text-center">Tabla</th>
                                <th class="text-center">Acción</th>
                                <th class="text-center">Origen</th>
                                <th class="text-center">Usuario</th>
                                <th class="text-center">Detalles</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var badgeClass = item.Accion.Contains("POST") ? "badge-success-soft" :
                                                item.Accion.Contains("PUT") ? "badge-warning-soft" :
                                                item.Accion.Contains("DELETE") ? "badge-danger-soft" : "badge-info-soft";
                                
                                var originClass = "origin-default";
                                var originIcon = "fa-question";
                                var originText = item.TipoOrigenDesc ?? "Desconocido";

                                if (originText.Contains("Web")) { originClass = "origin-web"; originIcon = "fa-user"; }
                                else if (originText.Contains("API")) { originClass = "origin-api"; originIcon = "fa-key"; }
                                else if (originText.Contains("Sistema")) { originClass = "origin-system"; originIcon = "fa-robot"; }
                                else if (originText.Contains("Job")) { originClass = "origin-job"; originIcon = "fa-clock"; }
                                else if (originText.Contains("LDAP")) { originClass = "origin-ldap"; originIcon = "fa-sync"; }

                                <tr>
                                    <td class="text-center">@item.IdRegistro</td>
                                    <td class="text-center">
                                        <div style="color: var(--text-medium); font-weight: 500;">
                                            <div style="font-size: 0.875rem;">@item.FechaCreacion.ToString("dd/MM/yyyy")</div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);">@item.FechaCreacion.ToString("h:mm tt")</div>
                                        </div>
                                    </td>
                                    <td class="text-center"><strong>@item.Tabla</strong></td>
                                    <td class="text-center">
                                        <span class="badge-soft @badgeClass">@item.Accion</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge-origin @originClass">
                                            <i class="fas @originIcon"></i> @originText
                                        </span>
                                        @if(!string.IsNullOrEmpty(item.ApiKeyDesc) && item.ApiKeyDesc != "N/A" && item.ApiKeyDesc != "Directo/Interno")
                                        {
                                            <div class="mt-1"><small class="text-muted" style="font-size: 0.7rem;">@item.ApiKeyDesc</small></div>
                                        }
                                    </td>
                                    <td>@item.Usuario</td>
                                    <td class="text-center">
                                        <button type="button" class="action-btn btn-view" onclick="showAuditDetails(@item.Id)" title="Ver Datos Anteriores">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th class="text-center">ID</th>
                                <th class="text-center">Fecha</th>
                                <th class="text-center">Tabla</th>
                                <th class="text-center">Acción</th>
                                <th class="text-center">Origen</th>
                                <th class="text-center">Usuario</th>
                                <th class="text-center">Detalles</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="empty-state fade-in">
            <div class="empty-icon">
                <i class="fas fa-history"></i>
            </div>
            <h3>No hay registros de auditoría</h3>
            <p class="text-muted">Intenta ajustar los filtros de búsqueda</p>
        </div>
    }
    
    @if (Model.Any())
    {
        <div class="pagination-container fade-in">
            <div class="pagination-info">
                Página @Model.PageNumber de @Model.PageCount (@Model.TotalItemCount registros)
            </div>
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, fechaDesde = ViewBag.FechaDesde, fechaHasta = ViewBag.FechaHasta, idTabla = ViewBag.IdTabla }), 
            new PagedListRenderOptions {
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" },
                UlElementClasses = new[] { "pagination justify-content-center" }
            })
        </div>
    }
</div>

<!-- Modal para Detalles -->
<div class="modal fade" id="auditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="fas fa-search-plus mr-2"></i> Detalle del Cambio Histórico</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div id="auditDetailsContent" class="modal-body">
                <div class="text-center p-4">
                    <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>
                    <p class="mt-2">Cargando datos históricos...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showAuditDetails(id) {
            $('#auditModal').modal('show');
            $('#auditDetailsContent').load('/Auditoria/Details/' + id);
        }

        window.clearAllFilters = function () {
            document.getElementById('fechaDesde').value = '';
            document.getElementById('fechaHasta').value = '';
            document.getElementById('idTabla').value = '';
            document.getElementById('searchForm').submit();
        };

        document.addEventListener('DOMContentLoaded', function () {
            const elements = document.querySelectorAll('.fade-in, .slide-in-left');
            elements.forEach(element => {
                element.style.opacity = '0';
                element.style.transform = 'translateY(20px)';
            });

            setTimeout(() => {
                elements.forEach((element, index) => {
                    setTimeout(() => {
                        element.style.transition = 'all 0.6s ease-out';
                        element.style.opacity = '1';
                        element.style.transform = 'translate(0, 0)';
                    }, index * 100);
                });
            }, 50);

            // Initialize Select2 for Table Filter
            $('#idTabla').select2({
                placeholder: 'Todas las tablas',
                width: '100%',
                allowClear: true
            });
        });
    </script>
}
