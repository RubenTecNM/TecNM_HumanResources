<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecursosHumanosWeb</title>
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/RecursosHumanosWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Background animado minimalista -->
    <!-- Modern Web Background -->
    <div class="modern-bg">
        <div class="gradient-overlay"></div>
        <div class="dot-mesh"></div>
        <div class="glow-spots">
            <div class="glow glow-1"></div>
            <div class="glow glow-2"></div>
        </div>
        <div class="wave-container">
            <svg class="wave wave-1" viewBox="0 0 1200 600" preserveAspectRatio="none">
                <path d="M0,300 Q300,250 600,300 T1200,300" />
            </svg>
            <svg class="wave wave-2" viewBox="0 0 1200 600" preserveAspectRatio="none">
                <path d="M0,320 Q300,370 600,320 T1200,320" />
            </svg>
        </div>
        <div class="particles" id="particlesContainer"></div>
    </div>

    @{
        var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
        var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString();
    }

    @if (isAuthenticated)
    {
        <!-- Mobile Side Drawer (Offcanvas) -->
        <div class="offcanvas offcanvas-start mobile-drawer" tabindex="-1" id="mobileDrawer" aria-labelledby="mobileDrawerLabel">
            <div class="offcanvas-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="user-avatar-circle shadow-sm" style="width: 48px; height: 48px; border: 2px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.2);">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div>
                        <h5 class="offcanvas-title fw-bold" id="mobileDrawerLabel" style="color: white !important;">@User.Identity?.Name</h5>
                        <span class="small" style="color: rgba(255,255,255,0.8) !important;">Gestión de RRHH</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-0">
                <ul class="drawer-menu">
                    <li class="drawer-section">Navegación</li>
                    <li>
                        <a asp-controller="Permisos" asp-action="Index" class="drawer-link @(currentCtrl == "Permisos" ? "active" : "")">
                            <i class="fas fa-file-contract"></i> Permisos
                        </a>
                    </li>
                    <authorize-section policy="RHOrAdmin">
                        <li>
                            <a asp-controller="Cortes" asp-action="Index" class="drawer-link @(currentCtrl == "Cortes" ? "active" : "")">
                                <i class="fas fa-calendar-check"></i> Cortes
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Usuarios" asp-action="Index" class="drawer-link @(currentCtrl == "Usuarios" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <i class="fas fa-users-cog"></i> Usuarios
                            </a>
                        </li>
                    </authorize-section>

                    <authorize-section policy="AdminOnly">
                        <li class="drawer-section">Administración</li>
                        <li>
                            <a asp-controller="Auditoria" asp-action="Index" class="drawer-link @(currentCtrl == "Auditoria" ? "active" : "")">
                                <i class="fas fa-history"></i> Auditoría
                            </a>
                        </li>
                        <li>
                            <a asp-controller="ApiKeys" asp-action="Index" class="drawer-link @(currentCtrl == "ApiKeys" ? "active" : "")">
                                <i class="fas fa-key"></i> API Keys
                            </a>
                        </li>
                    </authorize-section>
                    
                    <li class="drawer-section">Cuenta</li>
                    <li>
                        <a asp-controller="Usuarios" asp-action="Details" asp-route-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" class="drawer-link @(currentCtrl == "Usuarios" && ViewContext.RouteData.Values["Action"]?.ToString() == "Details" ? "active" : "")">
                            <i class="fas fa-user-circle"></i> Mi Perfil
                        </a>
                    </li>
                    <li class="mt-4 px-3">
                        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutFormMobile">
                            <button type="submit" class="btn w-100 rounded-pill py-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" 
                                    style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border: none;">
                                <i class="fas fa-power-off"></i> Cerrar Sesión
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>

        <aside class="navbar-side">
            <div class="navbar-side__brand" style="display: flex; justify-content: center; padding: 1rem 0; border-bottom: 1px solid rgba(0,0,0,0.05); margin-bottom: 0.5rem;">
                <a asp-controller="Home" asp-action="Index" style="color: var(--primary-medium); font-size: 1.5rem; text-decoration: none;">
                    <i class="fas fa-layer-group"></i>
                </a>
            </div>
            <ul class="navbar-side__menu">
                
                <li class="navbar-side__item @(currentCtrl == "Permisos" ? "active" : "")">
                    <a asp-controller="Permisos" asp-action="Index" class="navbar-side__link">
                        <i class="fas fa-file-contract"></i>
                        <span>Permisos</span>
                    </a>
                </li>

                <authorize-section policy="RHOrAdmin">
                    <li class="navbar-side__item @(currentCtrl == "Cortes" ? "active" : "")">
                        <a asp-controller="Cortes" asp-action="Index" class="navbar-side__link">
                            <i class="fas fa-calendar-check"></i>
                            <span>Cortes</span>
                        </a>
                    </li>
                    <li class="navbar-side__item @(currentCtrl == "Usuarios" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <a asp-controller="Usuarios" asp-action="Index" class="navbar-side__link">
                            <i class="fas fa-users-cog"></i>
                            <span>Usuarios</span>
                        </a>
                    </li>
                </authorize-section>

                <authorize-section policy="AdminOnly">
                    <li class="navbar-side__item d-none d-lg-block @(currentCtrl == "Auditoria" ? "active" : "")">
                        <a asp-controller="Auditoria" asp-action="Index" class="navbar-side__link">
                            <i class="fas fa-history"></i>
                            <span>Auditoría</span>
                        </a>
                    </li>
                    <li class="navbar-side__item d-none d-lg-block @(currentCtrl == "ApiKeys" ? "active" : "")">
                        <a asp-controller="ApiKeys" asp-action="Index" class="navbar-side__link">
                            <i class="fas fa-key"></i>
                            <span>API Keys</span>
                        </a>
                    </li>
                </authorize-section>

                <!-- Hamburger Trigger (Visible only on mobile) -->
                <li class="navbar-side__item d-lg-none">
                    <a href="javascript:void(0)" class="navbar-side__link" data-bs-toggle="offcanvas" data-bs-target="#mobileDrawer">
                        <i class="fas fa-bars"></i>
                        <span>Más</span>
                    </a>
                </li>
            </ul>

            <div class="navbar-side__footer d-none d-lg-block">
                <div class="navbar-side__menu">
                    <!-- Avatar/Profile Link -->
                    <li class="navbar-side__item @(currentCtrl == "Usuarios" && ViewContext.RouteData.Values["Action"]?.ToString() == "Details" ? "active" : "")">
                        <a asp-controller="Usuarios" asp-action="Details" asp-route-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" class="navbar-side__link">
                            <div class="user-avatar-circle" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span>Mi Perfil</span>
                        </a>
                    </li>
                    <!-- Logout -->
                    <li class="navbar-side__item">
                        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" style="display:none;"></form>
                        <a href="javascript:document.getElementById('logoutForm').submit()" class="navbar-side__link text-danger">
                            <i class="fas fa-power-off"></i>
                            <span>Cerrar Sesión</span>
                        </a>
                    </li>
                </div>
            </div>
        </aside>
    }

    <div class="container @(isAuthenticated ? "main-content-shifted" : "mt-4")">
        <main role="main" class="main-content">
            @if (TempData["ErrorAlert"] != null)
            {
                <div data-error-alert='@TempData["ErrorAlert"]' style="display:none;"></div>
            }
            @if (TempData["SuccessAlert"] != null)
            {
                <div data-success-alert='@TempData["SuccessAlert"]' style="display:none;"></div>
            }
            
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/es.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/cleave.js@1.6.0/dist/cleave.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if ('scrollRestoration' in history) {
                history.scrollRestoration = 'manual';
            }
            window.scrollTo(0, 0);

            AOS.init({ duration: 800, once: true });
            createStarField();

            // Lógica para el botón de 100K (Mantenida)
            const generateBtn = document.getElementById('generateTestDataBtn');
            if (generateBtn) {
                generateBtn.onclick = async () => {
                    const confirm = await Swal.fire({
                        title: '¿Generar 100,000 registros?',
                        text: "Esta acción llenará la base de datos para pruebas de rendimiento.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#10B981',
                        confirmButtonText: 'Sí, generar'
                    });

                    if (confirm.isConfirmed) {
                        Swal.fire({ title: 'Procesando...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                        try {
                            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                            const response = await fetch('/Permisos/GenerateTestData', {
                                method: 'POST',
                                headers: { 'RequestVerificationToken': token }
                            });
                            const data = await response.json();
                            Swal.fire(data.success ? 'Éxito' : 'Error', data.message, data.success ? 'success' : 'error');
                            if(data.success) location.reload();
                        } catch (e) {
                            Swal.fire('Error', 'Hubo un problema de conexión', 'error');
                        }
                    }
                }
            }

            // Prevenir animación del drawer durante resize
            let resizeTimer;
            window.addEventListener('resize', function() {
                const mobileDrawer = document.getElementById('mobileDrawer');
                if (mobileDrawer) {
                    mobileDrawer.classList.add('resizing');
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(function() {
                        mobileDrawer.classList.remove('resizing');
                    }, 100);
                }
            });
        });

        // Optimized particle generation - reduced count
        function createParticles() {
            const container = document.getElementById('particlesContainer');
            if (!container) return; // Guard clause
            const particleCount = 15; // Optimized for performance
            const fragment = document.createDocumentFragment();

            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.top = Math.random() * 100 + '%';
                particle.style.animationDelay = (Math.random() * 18) + 's';
                particle.style.animationDuration = (15 + Math.random() * 6) + 's';
                fragment.appendChild(particle);
            }

            container.appendChild(fragment);
        }

        // Initialize particles on load
        document.addEventListener('DOMContentLoaded', createParticles);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>