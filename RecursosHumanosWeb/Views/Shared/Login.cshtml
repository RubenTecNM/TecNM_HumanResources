@model RecursosHumanosWeb.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

@section Styles {
    <link rel="stylesheet" href="~/cssv2/views/Account/login.css" asp-append-version="true" />
}

<div class="index-container">
    <!-- Page Header (Premium V2 / Cloudflare Style) -->
    <div class="page-header-v2 fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-shield-alt"></i>
                Control de Acceso
            </h1>
            <p class="page-subtitle">Ingrese sus credenciales para acceder al sistema institucional</p>
        </div>
    </div>

    <!-- Formulario (Premium Layout) -->
    <div class="filters-section slide-in-left">
        <div class="card filter-card-premium shadow-lg border-0">
            <div class="filter-header-premium">
                <i class="fas fa-lock fa-lg"></i>
                <h5 class="m-0 fw-bold" style="letter-spacing: 0.5px; text-transform: uppercase;">Autenticaci&oacute;n</h5>
            </div>

            <div class="filter-body-premium p-3 p-sm-4">
                <form asp-action="Login" asp-controller="Account" method="post" id="loginForm" autocomplete="off">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ReturnUrl)

                    <div class="row g-3">
                        <!-- Email -->
                        <div class="col-12 col-md-6">
                            <div class="filter-group">
                                <!-- Solo un emoji, sin FontAwesome en label -->
                                <label asp-for="Email" class="fw-bold text-muted small text-uppercase mb-2 ms-1 d-block">
                                    &#128231; Correo Electr&oacute;nico
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3" style="border: 2px solid #ced4da; border-right: none;">
                                        <i class="fas fa-at text-primary"></i>
                                    </span>
                                    <input asp-for="Email" 
                                           class="form-control border-start-0 rounded-end-pill py-2 shadow-sm" 
                                           placeholder="usuario@@monclova.tecnm.mx" 
                                           required 
                                           style="height: 52px; border: 2px solid #ced4da; border-left: none;" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small ms-1 fw-semibold"></span>
                            </div>
                        </div>

                        <!-- Contrasena -->
                        <div class="col-12 col-md-6">
                            <div class="filter-group">
                                <!-- Solo un emoji, sin FontAwesome en label -->
                                <label asp-for="Password" class="fw-bold text-muted small text-uppercase mb-2 ms-1 d-block">
                                    &#128274; Contrase&ntilde;a
                                </label>
                                <div class="position-relative">
                                    <input asp-for="Password" 
                                           type="password" 
                                           class="form-control rounded-pill pe-5 shadow-sm" 
                                           id="password-input" 
                                           placeholder="••••••••" 
                                           required 
                                           style="height: 52px; border: 2px solid #ced4da;" />
                                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="toggle-password">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small ms-1 fw-semibold"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Acciones Verticales en Movil -->
                    <div class="d-flex flex-column gap-3 mt-4 mt-sm-5">
                        <button type="submit" class="btn btn-primary rounded-pill w-100 fw-bold shadow-sm" id="loginBtn"
                                style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); border: none; height: 52px;">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Acceder al Sistema
                        </button>
                        
                        <div class="text-center">
                            <a href="@Url.Action("RequestToken", "ResetPassword")" class="text-primary fw-bold text-decoration-none small hover-link">
                                &iquest;Olvidaste tu contrase&ntilde;a?
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes icon-pulse-soft {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.7; }
    }
    .hover-link:hover {
        text-decoration: underline !important;
        opacity: 0.8;
    }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const togglePassword = document.getElementById('toggle-password');
            const passwordInput = document.getElementById('password-input');
            
            if (togglePassword && passwordInput) {
                togglePassword.addEventListener('click', function() {
                    const icon = this.querySelector('i');
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    icon.classList.toggle('fa-eye');
                    icon.classList.toggle('fa-eye-slash');
                });
            }

            // Animacion
            const elements = document.querySelectorAll('.fade-in, .slide-in-left');
            elements.forEach(element => {
                element.style.opacity = '0';
                element.style.transform = 'translateY(20px)';
            });
            setTimeout(() => {
                elements.forEach((element, index) => {
                    setTimeout(() => {
                        element.style.transition = 'all 0.6s ease-out';
                        element.style.opacity = '1';
                        element.style.transform = 'translate(0, 0)';
                    }, index * 100);
                });
            }, 100);
        });
    </script>
}
