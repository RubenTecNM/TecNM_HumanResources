@model RecursosHumanosWeb.Models.ViewModels.ApiKeyCreateViewModel
@{
    ViewData["Title"] = "Editar API Key";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <!-- ApiKey Edit uses global components from v2-site.css -->
}

<div class="index-container fade-in">
    <div class="permission-header">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-edit"></i>
                Editar API Key #@Model.Id
            </h1>
            <p class="page-subtitle">Modifique la configuración de la clave de acceso</p>
        </div>
        <div class="header-decoration">
            <div class="floating-icon">
                <i class="fas fa-key"></i>
            </div>
        </div>
    </div>

    <div class="card details-card shadow-lg rounded-3 overflow-hidden mb-5">
        <div class="card-body p-0 bg-white">
            <form asp-action="Edit" method="post" class="permission-form" id="apiKeyForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Key" />
                <input type="hidden" asp-for="CreatedAt" />

                <!-- Sección 1: Información de la Key -->
                <div class="form-section">
                    <div class="section-header">
                        <h3><i class="fas fa-info-circle"></i> Información de la Key</h3>
                        <span class="section-indicator">1</span>
                    </div>
                    
                    <div class="form-group mb-4">
                        <label class="form-label">Key API (Solo lectura)</label>
                        <div class="input-wrapper d-flex gap-2">
                            <i class="fas fa-key input-icon"></i>
                            <input type="text" id="apiKeyValue" class="form-control-v2 border-primary-soft bg-light fw-bold text-primary flex-grow-1" 
                                   value="@Model.Key" readonly style="font-family: monospace;" />
                            <button type="button" class="btn btn-primary rounded-pill px-3" onclick="copyApiKey()" title="Copiar clave">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                        <div class="mt-2 text-muted small">
                            <i class="fas fa-info-circle"></i> La clave API no puede ser modificada.
                        </div>
                    </div>
                </div>

                <!-- Sección 2: Usuario Titular -->
                <div class="form-section">
                    <div class="section-header">
                        <h3><i class="fas fa-user-shield"></i> Usuario Titular</h3>
                        <span class="section-indicator">2</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OwnerUserId" class="form-label">Usuario asociado a la clave</label>
                        <div class="input-wrapper">
                            <i class="fas fa-user input-icon"></i>
                            <select asp-for="OwnerUserId" class="form-control-v2 form-select select2-v2" id="idUsuarioTitular"
                                    asp-items="@(ViewData["User"] as SelectList)">
                                <option value="">Seleccione el usuario titular</option>
                            </select>
                        </div>
                        <span asp-validation-for="OwnerUserId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Sección 3: Permisos de Acceso -->
                <div class="form-section">
                    <div class="section-header">
                        <h3><i class="fas fa-database"></i> Permisos de Acceso</h3>
                        <span class="section-indicator">3</span>
                    </div>

                    @if (ViewBag.DatabaseTables != null && ViewBag.ApiPermissions != null)
                    {
                        var tablas = ViewBag.DatabaseTables as List<RecursosHumanosWeb.Models.DatabaseTable> ?? new List<RecursosHumanosWeb.Models.DatabaseTable>();
                        var apiPermisos = ViewBag.ApiPermissions as List<RecursosHumanosWeb.Models.ApiPermission> ?? new List<RecursosHumanosWeb.Models.ApiPermission>();
                        var permisosActuales = ViewBag.CurrentPermissions as Dictionary<int, List<int>> ?? new Dictionary<int, List<int>>();

                        <p class="text-muted small mb-4">Actualice las operaciones permitidas para cada entidad.</p>

                        int tableIndex = 0;
                        foreach (var tabla in tablas)
                        {
                            var permisosTabla = permisosActuales.ContainsKey(tabla.Id) ? permisosActuales[tabla.Id] : new List<int>();

                            <div class="card p-3 mb-4 bg-light border-0 shadow-sm rounded-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="m-0 fw-bold text-dark">
                                        <i class="fas fa-table text-primary me-2"></i> @tabla.Description
                                    </h5>
                                    <span class="badge bg-white text-primary border px-3 py-2 rounded-pill small">ID #@tabla.Id</span>
                                </div>

                                <input type="hidden" name="Assignments[@tableIndex].TableId" value="@tabla.Id" />

                                <div class="row g-3">
                                    @foreach (var permiso in apiPermisos)
                                    {
                                        var iconClass = permiso.Description switch
                                        {
                                            "Leer" => "fa-eye",
                                            "Escribir" => "fa-plus",
                                            "Actualizar" => "fa-edit",
                                            "Eliminar" => "fa-trash-alt",
                                            _ => "fa-cog"
                                        };
                                        var isChecked = permisosTabla.Contains(permiso.Id);

                                        <div class="col-md-3">
                                            <div class="form-check p-0">
                                                <label class="d-flex align-items-center gap-2 p-2 rounded-3 hover-bg-white border transition-all cursor-pointer w-100 mb-0" 
                                                       style="background: white;">
                                                    <input type="checkbox" 
                                                           name="Assignments[@tableIndex].IdsApiPermissionsSeleccionados" 
                                                           value="@permiso.Id"
                                                           class="form-check-input m-0"
                                                           @(isChecked ? "checked" : "")
                                                           style="width: 18px; height: 18px;">
                                                    <span class="small fw-semibold">
                                                        <i class="fas @iconClass me-1 opacity-75"></i> @permiso.Description
                                                    </span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            tableIndex++;
                        }
                    }
                </div>

                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold text-secondary border">
                        <i class="fas fa-arrow-left me-2"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill shadow-sm fw-bold">
                        <i class="fas fa-save me-2"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        function copyApiKey() {
            const apiKeyValue = document.getElementById('apiKeyValue').value;
            navigator.clipboard.writeText(apiKeyValue).then(function() {
                if (typeof showToast === 'function') showToast('✅ Key API copiada al portapapeles', 'success');
                else {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Copiado!',
                        text: 'La clave API ha sido copiada al portapapeles',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            });
        }

        $(document).ready(function () {
            // Inicializar Select2
            $('.user-select').select2({
                placeholder: "Seleccione un usuario",
                allowClear: true
            });

            // Animaciones de entrada
            const sections = document.querySelectorAll('.form-section');
            sections.forEach((section, index) => {
                section.style.opacity = '0';
                section.style.transform = 'translateY(20px)';

                setTimeout(() => {
                    section.style.transition = 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
                    section.style.opacity = '1';
                    section.style.transform = 'translateY(0)';
                }, 100 * (index + 1));
            });

            // Hover effects en checkboxes
            $('.permission-checkbox-item').hover(
                function() {
                    $(this).css({
                        'border-color': 'var(--primary-strong)',
                        'box-shadow': '0 4px 12px rgba(59, 130, 246, 0.15)',
                        'transform': 'translateY(-2px)'
                    });
                },
                function() {
                    if (!$(this).find('input[type="checkbox"]').is(':checked')) {
                        $(this).css({
                            'border-color': '#e2e8f0',
                            'box-shadow': 'none',
                            'transform': 'translateY(0)'
                        });
                    }
                }
            );

            // Marcar checkbox al hacer clic en el contenedor
            $('.permission-checkbox-item').click(function(e) {
                if (e.target.tagName !== 'INPUT') {
                    var checkbox = $(this).find('input[type="checkbox"]');
                    checkbox.prop('checked', !checkbox.prop('checked')).trigger('change');
                }
            });

            // Estilo cuando está checked
            $('input[type="checkbox"]').change(function() {
                var container = $(this).closest('.permission-checkbox-item');
                if ($(this).is(':checked')) {
                    container.css({
                        'background': 'linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(37, 99, 235, 0.05) 100%)',
                        'border-color': 'var(--primary-strong)',
                        'box-shadow': '0 4px 12px rgba(59, 130, 246, 0.15)'
                    });
                } else {
                    container.css({
                        'background': 'white',
                        'border-color': '#e2e8f0',
                        'box-shadow': 'none'
                    });
                }
            });
        });
    </script>
}