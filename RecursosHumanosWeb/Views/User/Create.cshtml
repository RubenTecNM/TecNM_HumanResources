@model RecursosHumanosWeb.Models.ViewModels.User.UserCreateViewModel

@{
    ViewData["Title"] = "Crear Usuario";
    var userTypes = ViewData["UserTypeId"] as SelectList;
    var areas = ViewData["AreaId"] as SelectList;
    var departments = ViewData["DepartmentId"] as SelectList;
    var positions = ViewData["PositionId"] as SelectList;
}

@section Styles {
}

<div class="index-container fade-in">
    <div class="permission-header">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-user-plus"></i> 
                Crear Nuevo Usuario
            </h1>
            <p class="page-subtitle">Complete los campos para agregar un nuevo usuario al sistema</p>
        </div>
        <div class="header-decoration">
            <div class="floating-icon">
                <i class="fas fa-clipboard-check"></i>
            </div>
        </div>
    </div>

    <div class="card details-card shadow-lg rounded-3 overflow-hidden mb-5">
        <div class="card-body p-0 bg-white">
            <form asp-action="Create" method="post" class="create-usuario-form">
                @Html.AntiForgeryToken()

                <!-- Sección: Información Personal -->
                <div class="form-section">
                    <div class="section-header">
                        <h3><i class="fas fa-user"></i> Información Personal</h3>
                        <span class="section-indicator">1</span>
                    </div>
                    
                    <div class="row g-4">
                        <div class="col-md-6 form-group">
                            <label asp-for="Name" class="form-label">Nombre Completo</label>
                            <div class="input-wrapper">
                                <i class="fas fa-id-card input-icon"></i>
                                <input asp-for="Name" class="form-control-v2" placeholder="Ingrese el nombre completo" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6 form-group">
                            <label asp-for="Email" class="form-label">Correo Electrónico</label>
                            <div class="input-wrapper">
                                <i class="fas fa-envelope input-icon"></i>
                                <input asp-for="Email" class="form-control-v2" type="email" placeholder="ejemplo@monclova.tecnm.mx" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12 form-group">
                            <label asp-for="Password" class="form-label">Contraseña</label>
                            <div class="input-wrapper">
                                <i class="fas fa-lock input-icon"></i>
                                <input asp-for="Password" class="form-control-v2 pe-5" type="password" id="passwordInput" placeholder="Mínimo 6 caracteres" />
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="togglePassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="progress mt-2 rounded-pill" style="height: 6px; background: #e2e8f0;">
                                <div id="password-strength" class="progress-bar transition-all" role="progressbar" style="width: 0%; border-radius: 50px;"></div>
                            </div>
                            <small class="form-text text-muted">
                                <i class="fas fa-info-circle"></i> La contraseña será encriptada (SHA-256) antes de almacenarse.
                            </small>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Sección: Información Organizacional -->
                <div class="form-section">
                    <div class="section-header">
                        <h3><i class="fas fa-building"></i> Información Organizacional</h3>
                        <span class="section-indicator">2</span>
                    </div>
                    
                    <div class="row g-4">
                        <div class="col-md-6 form-group">
                            <label asp-for="UserTypeId" class="form-label">Tipo de Usuario</label>
                            <div class="input-wrapper">
                                <i class="fas fa-user-tag input-icon"></i>
                                <select asp-for="UserTypeId" class="form-control-v2 form-select" asp-items="userTypes">
                                    <option value="">-- Seleccione un tipo --</option>
                                </select>
                            </div>
                            <span asp-validation-for="UserTypeId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="AreaId" class="form-label">Área</label>
                            <div class="input-wrapper">
                                <i class="fas fa-map-marker-alt input-icon"></i>
                                <select asp-for="AreaId" class="form-control-v2 form-select" asp-items="areas">
                                    <option value="">-- Seleccione un área --</option>
                                </select>
                            </div>
                            <span asp-validation-for="AreaId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="DepartmentId" class="form-label">Departamento</label>
                            <div class="input-wrapper">
                                <i class="fas fa-sitemap input-icon"></i>
                                <select asp-for="DepartmentId" class="form-control-v2 form-select" asp-items="departments">
                                    <option value="">-- Seleccione un departamento --</option>
                                </select>
                            </div>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="PositionId" class="form-label">Puesto</label>
                            <div class="input-wrapper">
                                <i class="fas fa-briefcase input-icon"></i>
                                <select asp-for="PositionId" class="form-control-v2 form-select" asp-items="positions">
                                    <option value="">-- Seleccione un puesto --</option>
                                </select>
                            </div>
                            <span asp-validation-for="PositionId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold text-secondary border">
                        <i class="fas fa-arrow-left me-2"></i> Volver
                    </a>
                    <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill shadow-sm fw-bold">
                        <i class="fas fa-save me-2"></i> Crear Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/Users/create.js" asp-append-version="true"></script>
}