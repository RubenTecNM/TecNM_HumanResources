@model RecursosHumanosWeb.Models.Permiso
@using System.IO
@using System.Globalization
@using RecursosHumanosWeb.Models.Enums
@{
    ViewData["Title"] = "Detalles del Permiso";

    var culture = new CultureInfo("es-MX");

    string FormatHora12(DateTime fecha) => fecha.ToString("hh:mm tt", culture).ToUpper();
    string FormatFechaCompleta(DateTime fecha) => fecha.ToString("dd 'de' MMMM 'del' yyyy", culture);

    var typeConfigurations = new Dictionary<int, Dictionary<string, (bool show, string label)>>
    {
        [1] = new Dictionary<string, (bool, string)> {
            ["Fecha1"] = (true,  "En el d&iacute;a"), ["Fecha2"] = (false, "Al d&iacute;a"),
            ["Hora1"]  = (true,  "Hora de llegada"),  ["Hora2"]  = (false, "Hora salida")
        },
        [2] = new Dictionary<string, (bool, string)> {
            ["Fecha1"] = (true, "Del d&iacute;a"),    ["Fecha2"] = (true, "Por el d&iacute;a"),
            ["Hora1"]  = (true, "Hora entrada"),       ["Hora2"]  = (true, "Hora salida")
        },
        [3] = new Dictionary<string, (bool, string)> {
            ["Fecha1"] = (true,  "Del d&iacute;a"),   ["Fecha2"] = (true,  "Al d&iacute;a"),
            ["Hora1"]  = (false, "Hora entrada"),      ["Hora2"]  = (false, "Hora salida")
        },
        [4] = new Dictionary<string, (bool, string)> {
            ["Fecha1"] = (true, "Del d&iacute;a"),    ["Fecha2"] = (true, "Al d&iacute;a"),
            ["Hora1"]  = (true, "Hora entrada"),       ["Hora2"]  = (true, "Hora salida")
        }
    };

    var  config   = typeConfigurations.ContainsKey(Model.IdTipoPermiso) ? typeConfigurations[Model.IdTipoPermiso] : null;
    bool showDias = config != null && config["Fecha2"].show && Model.Fecha2.HasValue && Model.Dias.HasValue && Model.Dias.Value > 1;
    string hora1  = config != null && config["Hora1"].show && Model.Fecha1 != null  ? FormatHora12(Model.Fecha1.Value) : null!;
    string hora2  = config != null && config["Hora2"].show && Model.Fecha2.HasValue ? FormatHora12(Model.Fecha2.Value) : null!;

    string? evidenceUrl  = null;
    string? evidencePath = null;
    bool    evidenceExists = false;
    if (!string.IsNullOrEmpty(Model.Evidencia))
    {
        var raw = Model.Evidencia.Replace('\\', '/').Trim();
        if (!raw.StartsWith("/") && !raw.Contains("/")) raw = "/Evidences/" + raw;
        evidenceUrl    = raw;
        evidencePath   = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", raw.TrimStart('/'));
        evidenceExists = System.IO.File.Exists(evidencePath);
    }

    int  currentUserType = ViewBag.CurrentUserType ?? 0;
    bool isRHOrAdmin     = currentUserType == (int)TipoUsuarioEnum.Administrador;
    bool isApprover      = ViewBag.IsApprover ?? false;
    bool canReview       = (Model.IdEstadoPermiso == 1) && (isRHOrAdmin || (isApprover && Model.IdCorte == (int?)ViewBag.CurrentCourtId));

    string solicitanteNombre = Model.IdUsuarioSolicitaNavigation?.Nombre ?? "Usuario";

    string tipoLabel = Model.IdTipoPermiso switch { 1 => "Retardo", 2 => "Turno por Turno", 3 => "Falta", 4 => "Cambio de Horario", _ => "Permiso" };
    string tipoIcon  = Model.IdTipoPermiso switch { 1 => "fa-clock", 2 => "fa-sync-alt", 3 => "fa-calendar-times", 4 => "fa-exchange-alt", _ => "fa-tag" };
}

@section Styles {
    <link rel="stylesheet" href="~/cssv2/views/permisos/details.css" asp-append-version="true" />
}

<div class="details-page-wrapper">
    <div class="card details-card overflow-hidden shadow-lg">

        @* ── HEADER ── *@
        <div class="details-header-v2 text-white px-4 px-md-5 py-4 text-start">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-4">
                @* Info (Left) *@
                <div class="d-flex align-items-center gap-3 flex-grow-1">
                    <div class="details-avatar shadow-sm">
                        <i class="fas @tipoIcon"></i>
                    </div>
                    <div>
                        <h2 class="h4 fw-bold mb-1">ID #@Model.Id &mdash; @tipoLabel</h2>
                        <p class="mb-0 d-flex align-items-center gap-2" style="color:rgba(255,255,255,0.85);">
                            <i class="fas fa-user-circle small"></i>
                            Solicitante: <span class="fw-semibold">@solicitanteNombre</span>
                        </p>
                    </div>
                </div>

                @* Status (Right) *@
                <div class="status-container">
                    <div class="status-glass rounded-pill shadow-sm px-4 py-2 border border-white border-opacity-25">
                        @if (Model.IdEstadoPermiso == 1)      { <span class="status-dot dot-closed"></span><span class="small text-uppercase fw-bold">Pendiente</span> }
                        else if (Model.IdEstadoPermiso == 2)  { <span class="status-dot dot-active"></span><span class="small text-uppercase fw-bold">Aprobado</span> }
                        else if (Model.IdEstadoPermiso == 3)  { <span class="status-dot dot-invalid"></span><span class="small text-uppercase fw-bold">Invalidado</span> }
                        else                                   { <span class="status-dot dot-danger"></span><span class="small text-uppercase fw-bold">Rechazado</span> }
                    </div>
                </div>
            </div>
        </div>

        @* ── BODY ── *@
        <div class="card-body p-4 p-md-5 bg-white">
            <div class="row g-4">

                @* — Izquierda: Información del Permiso — *@
                <div class="col-12 col-lg-6">
                    <h3 class="section-title h6 fw-bold text-dark text-uppercase mb-3 d-flex align-items-center gap-2">
                        <i class="fas fa-info-circle text-primary"></i> Información del Permiso
                    </h3>

                    <div class="row g-3">
                        @* Periodo de Corte *@
                        <div class="col-12 col-md-6">
                            <div class="info-card info-card-indigo p-3 rounded-3 h-100">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="icon-circle indigo-circle"><i class="fas fa-hashtag small"></i></div>
                                    <span class="small fw-medium text-secondary text-uppercase">Periodo de Corte</span>
                                </div>
                                <div class="d-flex align-items-center gap-2 ms-5">
                                    <span class="h6 fw-semibold text-dark mb-0">#@Model.IdCorte</span>
                                    <div class="v2-badge @(Model.IdCorteNavigation?.IdEstadoCorte == 1 ? "v2-badge-success" : "v2-badge-secondary")">
                                        <span class="v2-badge-dot"></span>
                                        @(Model.IdCorteNavigation?.IdEstadoCorte == 1 ? "Abierto" : "Cerrado")
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Tipo de Permiso *@
                        <div class="col-12 col-md-6">
                            <div class="info-card info-card-purple p-3 rounded-3 h-100">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="icon-circle purple-circle"><i class="fas @tipoIcon small"></i></div>
                                    <span class="small fw-medium text-secondary text-uppercase">Tipo de Permiso</span>
                                </div>
                                <p class="h6 fw-semibold text-dark mb-0 ms-5">@tipoLabel</p>
                            </div>
                        </div>

                        @* Goce de Sueldo *@
                        <div class="@(showDias ? "col-12 col-md-6" : "col-12")">
                            <div class="info-card @(Model.Goce ? "info-card-green" : "info-card-red") p-3 rounded-3 h-100">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="icon-circle @(Model.Goce ? "green-circle" : "red-circle")"><i class="fas fa-money-bill-wave small"></i></div>
                                    <span class="small fw-medium text-secondary text-uppercase">Goce de Sueldo</span>
                                </div>
                                <p class="h6 fw-semibold mb-0 ms-5 @(Model.Goce ? "text-success" : "text-danger")">
                                    @(Model.Goce ? "Con Goce" : "Sin Goce")
                                </p>
                            </div>
                        </div>

                        @* Días Totales (Movido a la izquierda para simetría) *@
                        @if (showDias)
                        {
                            <div class="col-12 col-md-6">
                                <div class="info-card info-card-indigo p-3 rounded-3 h-100" style="background: rgba(16, 185, 129, 0.04); border-color: rgba(16, 185, 129, 0.12);">
                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        <div class="icon-circle green-circle"><i class="fas fa-calendar-check small"></i></div>
                                        <span class="small fw-medium text-secondary text-uppercase">D&iacute;as Solicitados</span>
                                    </div>
                                    <p class="h6 fw-semibold text-dark mb-0 ms-5">@Model.Dias @(Model.Dias == 1 ? "Día" : "Días")</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* — Derecha: Fechas y Horarios — *@
                <div class="col-12 col-lg-6">
                    <h3 class="section-title h6 fw-bold text-dark text-uppercase mb-3 d-flex align-items-center gap-2">
                        <i class="fas fa-calendar-alt text-primary"></i> Fechas y Horarios
                    </h3>

                    <div class="row g-3">
                        @if (config != null && config["Fecha1"].show && Model.Fecha1 != null)
                        {
                            <div class="col-12 col-md-6">
                                <div class="info-card info-card-indigo p-3 rounded-3 h-100">
                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        <div class="icon-circle indigo-circle"><i class="fas fa-calendar-alt small"></i></div>
                                        <span class="small fw-medium text-secondary text-uppercase">@Html.Raw(config["Fecha1"].label)</span>
                                    </div>
                                    <p class="h6 fw-semibold text-dark mb-0 ms-5">@FormatFechaCompleta(Model.Fecha1.Value)</p>
                                </div>
                            </div>
                        }
                        @if (config != null && config["Hora1"].show && !string.IsNullOrEmpty(hora1))
                        {
                            <div class="col-12 col-md-6">
                                <div class="info-card info-card-indigo p-3 rounded-3 h-100">
                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        <div class="icon-circle indigo-circle"><i class="fas fa-clock small"></i></div>
                                        <span class="small fw-medium text-secondary text-uppercase">@Html.Raw(config["Hora1"].label)</span>
                                    </div>
                                    <p class="h6 fw-semibold text-dark mb-0 ms-5">@hora1</p>
                                </div>
                            </div>
                        }
                        @if (config != null && config["Fecha2"].show && Model.Fecha2.HasValue)
                        {
                            <div class="col-12 col-md-6">
                                <div class="info-card info-card-indigo p-3 rounded-3 h-100">
                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        <div class="icon-circle indigo-circle"><i class="fas fa-calendar-check small"></i></div>
                                        <span class="small fw-medium text-secondary text-uppercase">@Html.Raw(config["Fecha2"].label)</span>
                                    </div>
                                    <p class="h6 fw-semibold text-dark mb-0 ms-5">@FormatFechaCompleta(Model.Fecha2.Value)</p>
                                </div>
                            </div>
                        }
                        @if (config != null && config["Hora2"].show && !string.IsNullOrEmpty(hora2))
                        {
                            <div class="col-12 col-md-6">
                                <div class="info-card info-card-indigo p-3 rounded-3 h-100">
                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        <div class="icon-circle indigo-circle"><i class="fas fa-history small"></i></div>
                                        <span class="small fw-medium text-secondary text-uppercase">@Html.Raw(config["Hora2"].label)</span>
                                    </div>
                                    <p class="h6 fw-semibold text-dark mb-0 ms-5">@hora2</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* — Motivo (ancho completo) — *@
                <div class="col-12">
                    <div class="p-3 border-start border-secondary border-3 bg-light rounded-end">
                        <p class="small text-secondary text-uppercase mb-2" style="font-size:.7rem;">
                            <i class="fas fa-comment-dots me-1"></i> Motivo de Ausencia
                        </p>
                        <p class="small fw-medium text-dark mb-2" style="white-space:pre-wrap;line-height:1.7;">@Model.Motivo</p>
                        <p class="mb-0 text-end" style="font-size:.7rem;color:var(--text-light);">@((Model.Motivo?.Length ?? 0)) / 255 caracteres</p>
                    </div>
                </div>

                @* — Evidencia (ancho completo) — *@
                @if (!string.IsNullOrEmpty(Model.Evidencia))
                {
                    <div class="col-12">
                        <h3 class="section-title h6 fw-bold text-dark text-uppercase mb-3 d-flex align-items-center gap-2">
                            <i class="fas fa-paperclip text-primary"></i> Evidencia Documental
                        </h3>
                        <div class="rounded-3 overflow-hidden border border-soft">
                            @if (evidenceExists)
                            {
                                <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold"><i class="fas fa-file-pdf me-2 text-danger"></i>@System.IO.Path.GetFileName(evidenceUrl)</span>
                                    <a href="@evidenceUrl" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3">
                                        <i class="fas fa-external-link-alt me-1"></i> Abrir PDF
                                    </a>
                                </div>
                                <iframe src="@evidenceUrl" class="w-100 border-0" style="height:500px;"></iframe>
                            }
                            else
                            {
                                <div class="p-5 text-center bg-light">
                                    <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width:52px;height:52px;">
                                        <i class="fas fa-exclamation-triangle fs-5"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark">Archivo no encontrado</h6>
                                    <p class="text-muted small mb-0">@System.IO.Path.GetFileName(Model.Evidencia)</p>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* — Bitácora de Registro — *@
                <div class="col-12 border-top pt-4">
                    <h3 class="h6 fw-bold text-secondary text-uppercase mb-3">Bit&aacute;cora de Registro</h3>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <div class="audit-card bg-light rounded-3 p-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="audit-icon bg-success text-white"><i class="fas fa-calendar-plus"></i></div>
                                    <div>
                                        <p class="small text-secondary mb-0">Fecha Solicitud</p>
                                        <p class="fw-bold text-dark mb-0 small">@Model.FechaCreacion.ToString("dd/MM/yyyy hh:mm tt", culture).ToUpper()</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="audit-card bg-light rounded-3 p-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="audit-icon bg-primary text-white"><i class="fas fa-user-plus"></i></div>
                                    <div>
                                        <p class="small text-secondary mb-0">Creado por</p>
                                        <p class="fw-bold text-dark mb-0 small">@(Model.IdUsuarioCreaNavigation?.Nombre ?? "Sistema")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (Model.IdEstadoPermiso == 2)
                        {
                            <div class="col-12 col-md-4">
                                <div class="audit-card bg-light rounded-3 p-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="audit-icon bg-warning text-white"><i class="fas fa-user-check"></i></div>
                                        <div>
                                            <p class="small text-success fw-bold mb-0">Autorizado por</p>
                                            <p class="fw-bold text-dark mb-0 small">@(Model.IdUsuarioAutorizaNavigation?.Nombre ?? "N/A")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

        @* ── FOOTER ── *@
        <div class="card-footer py-3 px-4 px-md-5 bg-light border-top d-flex justify-content-between align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                <i class="fas fa-arrow-left me-2"></i> Volver al Listado
            </a>
            <div class="d-flex gap-3">
                @if (canReview == false && Model.IdCorte == (int?)ViewBag.CurrentCourtId && Model.IdEstadoPermiso == 1 && (int?)ViewBag.CurrentUserId == Model.IdUsuarioSolicita)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="v2-btn btn-primary shadow-sm">
                        <i class="fas fa-edit"></i> Editar Solicitud
                    </a>
                }
                @if (canReview)
                {
                    <button type="button" class="v2-btn btn-success shadow-sm" onclick="document.getElementById('reviewFormInline')?.scrollIntoView({behavior:'smooth'})">
                        <i class="fas fa-check-double"></i> Revisar Ahora
                    </button>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const reviewForm = document.getElementById('reviewFormInline');
            const goceOptions = document.querySelectorAll('.goce-option');
            if (!reviewForm) return;
            function updateUi() {
                const sel = document.querySelector('input[name="Goce"]:checked');
                goceOptions.forEach(o => o.classList.remove('active'));
                if (sel) sel.closest('.goce-option').classList.add('active');
            }
            goceOptions.forEach(o => o.addEventListener('click', () => {
                const r = document.getElementById(o.dataset.value === 'true' ? 'goceTrue' : 'goceFalse');
                if (r) { r.checked = true; updateUi(); }
            }));
            updateUi();
            reviewForm.addEventListener('submit', async e => {
                e.preventDefault();
                const sel = document.querySelector('input[name="Goce"]:checked');
                if (!sel) { Swal.fire('Atenci&oacute;n', 'Determine el goce de sueldo.', 'warning'); return; }
                const goceVal = sel.value === 'true';
                const conf = await Swal.fire({
                    title: '&iquest;Confirmar?',
                    html: `Ser&aacute; marcada como <strong>${goceVal ? 'CON GOCE' : 'SIN GOCE'}</strong> de sueldo.`,
                    icon: 'question', showCancelButton: true,
                    confirmButtonText: 'S&iacute;, Autorizar', cancelButtonText: 'Cancelar',
                    confirmButtonColor: goceVal ? '#10b981' : '#f59e0b'
                });
                if (!conf.isConfirmed) return;
                const btn = document.getElementById('submitReviewBtn');
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Procesando...';
                try {
                    const res = await fetch(reviewForm.action, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                        body: new FormData(reviewForm)
                    });
                    const data = await res.json();
                    if (typeof handleAlertResponse === 'function') await handleAlertResponse(data);
                    else window.location.href = data.redirectUrl || '/Permiso/Index';
                } catch (err) {
                    Swal.fire('Error', err.message, 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-double me-2"></i> Finalizar y Autorizar';
                }
            });
        });
    </script>
}
