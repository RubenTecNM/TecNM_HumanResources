@model RecursosHumanosWeb.Models.Permiso
@using System.IO
@using System.Globalization
@{
    ViewData["Title"] = "Detalles del Permiso";

    var culture = new CultureInfo("es-MX");

    string FormatHora12(DateTime fecha)
    {
        return fecha.ToString("hh:mm tt", culture).ToUpper();
    }

    string FormatFechaCompleta(DateTime fecha)
    {
        return fecha.ToString("dd 'de' MMMM 'del' yyyy", culture);
    }

    var typeConfigurations = new Dictionary<int, Dictionary<string, (bool show, string label)>>
    {
        [2] = new Dictionary<string, (bool, string)>
        {
            ["Fecha1"] = (true, "Del día"),
            ["Fecha2"] = (true, "Al día"),
            ["Hora1"] = (false, "Hora entrada"),
            ["Hora2"] = (false, "Hora salida")
        },
        [3] = new Dictionary<string, (bool, string)>
        {
            ["Fecha1"] = (true, "En el día"),
            ["Fecha2"] = (false, "Al día"),
            ["Hora1"] = (true, "Hora de llegada"),
            ["Hora2"] = (false, "Hora salida")
        },
        [4] = new Dictionary<string, (bool, string)>
        {
            ["Fecha1"] = (true, "Del día"),
            ["Fecha2"] = (true, "Al día"),
            ["Hora1"] = (true, "Hora entrada"),
            ["Hora2"] = (true, "Hora salida")
        },
        [5] = new Dictionary<string, (bool, string)>
        {
            ["Fecha1"] = (true, "Del día"),
            ["Fecha2"] = (true, "Por el día"),
            ["Hora1"] = (true, "Hora entrada"),
            ["Hora2"] = (true, "Hora salida")
        }
    };

    var config = typeConfigurations.ContainsKey(Model.IdTipoPermiso) ? typeConfigurations[Model.IdTipoPermiso] : null;
    bool showDias = config != null && config["Fecha2"].show && Model.Fecha2.HasValue && Model.Dias.HasValue && Model.Dias.Value > 1;

    string hora1 = config != null && config["Hora1"].show && Model.Fecha1 != null ? FormatHora12(Model.Fecha1.Value) : null!;
    string hora2 = config != null && config["Hora2"].show && Model.Fecha2.HasValue ? FormatHora12(Model.Fecha2.Value) : null!;

    // Normalize evidence path: support filenames stored alone or web-relative paths like '/Evidences/xxx.pdf'
    string? evidenceUrl = null;
    string? evidencePath = null;
    bool evidenceExists = false;
    if (!string.IsNullOrEmpty(Model.Evidencia))
    {
        var raw = Model.Evidencia.Replace('\\', '/').Trim();
        // If stored as bare filename, assume it's under /Evidences/
        if (!raw.StartsWith("/") && !raw.Contains("/"))
        {
            raw = "/Evidences/" + raw;
        }
        evidenceUrl = raw;
        // Build physical path carefully
        var relativePath = raw.TrimStart('/');
        evidencePath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", relativePath);
        evidenceExists = System.IO.File.Exists(evidencePath);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .details-container { max-width: 100% !important; width: 100% !important; padding: 2rem !important; }
        .card-body { background-color: #ffffff !important; color: #1e293b !important; }
        .info-card { background-color: #f8fafc !important; }
        .section-title { color: #1e293b !important; border-bottom-color: #e2e8f0 !important; }
        .text-dark { color: #1e293b !important; }
        .text-secondary { color: #64748b !important; }
    </style>
}


<div class="details-container">
    <div class="card details-card shadow-lg rounded-3 overflow-hidden">
        
        <div class="details-header-gradient text-white px-4 px-md-5 py-4">
            <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="details-avatar rounded-circle d-flex align-items-center justify-content-center text-white fs-3 fw-bold">
                        <i class="fas fa-file-contract"></i>
                    </div>
                    <div>
                        <h2 class="h4 fw-semibold mb-1">Permiso #@Model.Id</h2>
                        <p class="mb-0 d-flex align-items-center gap-2" style="color: #dbeafe; opacity: 0.9;">
                             @(Model.IdUsuarioSolicitaNavigation?.Nombre ?? "Solicitante")
                        </p>
                    </div>
                </div>
                <div class="status-glass rounded-pill shadow-sm">
                    <span class="status-dot @(Model.Revisado ? "dot-active" : "dot-closed")"></span>
                    <span class="small text-uppercase">
                         @(Model.Revisado ? "REVISADO" : "PENDIENTE")
                    </span>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5 bg-white">
            <div class="row g-4">
                
                <div class="col-12">
                    <h3 class="section-title h5 text-dark d-flex align-items-center gap-2 mb-4">
                        <i class="fas fa-info-circle text-primary"></i>
                        Información del Permiso
                    </h3>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="info-card p-3 rounded-3">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="icon-circle purple-circle" style="background: rgba(139, 92, 246, 0.1); color: #8B5CF6; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-tag small"></i>
                                    </div>
                                    <span class="small fw-bold text-dark text-uppercase">Tipo de Permiso</span>
                                </div>
                                <div class="ms-md-5">
                                    <div class="permission-types readonly-mode">
                                        <div class="permission-type-card @(Model.IdTipoPermiso == 2 ? "selected active" : "")">
                                            <div class="type-label">
                                                <div class="type-icon"><i class="fas fa-calendar-times"></i></div>
                                                <h4>Falta</h4>
                                                <p>Ausencia</p>
                                            </div>
                                        </div>
                                        <div class="permission-type-card @(Model.IdTipoPermiso == 3 ? "selected active" : "")">
                                            <div class="type-label">
                                                <div class="type-icon"><i class="fas fa-clock"></i></div>
                                                <h4>Retardo</h4>
                                                <p>Llegada tarde</p>
                                            </div>
                                        </div>
                                        <div class="permission-type-card @(Model.IdTipoPermiso == 4 ? "selected active" : "")">
                                            <div class="type-label">
                                                <div class="type-icon"><i class="fas fa-exchange-alt"></i></div>
                                                <h4>Horario</h4>
                                                <p>Cambio horario</p>
                                            </div>
                                        </div>
                                        <div class="permission-type-card @(Model.IdTipoPermiso == 5 ? "selected active" : "")">
                                            <div class="type-label">
                                                <div class="type-icon"><i class="fas fa-sync-alt"></i></div>
                                                <h4>Turno</h4>
                                                <p>Cambio turno</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="info-card p-3 rounded-3 h-100">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="icon-circle orange-circle" style="background: rgba(245, 158, 11, 0.1); color: #F59E0B; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-check-circle small"></i>
                                    </div>
                                    <span class="small fw-medium text-secondary text-uppercase">Estado</span>
                                </div>
                                <p class="h6 fw-semibold mb-0 ms-5 @(Model.Revisado ? "text-success" : "text-warning")">
                                    @(Model.Revisado ? "✓ Revisado y Aprobado" : "⏳ Pendiente de Aprobación")
                                </p>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="info-card p-3 rounded-3 h-100">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="icon-circle text-info" style="background: rgba(6, 182, 212, 0.1); color: #06B6D4; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-hashtag small"></i>
                                    </div>
                                    <span class="small fw-medium text-secondary text-uppercase">ID Periodo</span>
                                </div>
                                <p class="h6 fw-semibold mb-0 ms-5 text-dark">
                                    #@Model.IdCorte
                                </p>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="info-card p-3 rounded-3 h-100">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="icon-circle indigo-circle" style="background: rgba(79, 70, 229, 0.1); color: #4F46E5; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-money-bill-wave small"></i>
                                    </div>
                                    <span class="small fw-medium text-secondary text-uppercase">Goce de Sueldo</span>
                                </div>
                                <p class="h6 fw-semibold mb-0 ms-5 @(Model.Goce ? "text-success" : "text-danger")">
                                    @(Model.Goce ? "✓ Con Goce de Sueldo" : "✗ Sin Goce de Sueldo")
                                </p>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-card p-3 rounded-3">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="icon-circle text-primary" style="background: rgba(37, 99, 235, 0.1); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-comment-dots small"></i>
                                    </div>
                                    <span class="small fw-medium text-secondary text-uppercase">Motivo</span>
                                </div>
                                <p class="h6 fw-normal text-dark mb-0 ms-5" style="white-space: pre-wrap;">@Model.Motivo</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <h3 class="section-title h5 text-dark d-flex align-items-center gap-2 mb-4">
                        <i class="fas fa-calendar-alt text-primary"></i>
                        Fechas y Horarios
                    </h3>
                    <div class="row g-3">
                        @if (config != null && config["Fecha1"].show && Model.Fecha1 != null)
                        {
                            <div class="col-md-6">
                                <div class="p-3 border-start border-primary border-3 bg-light rounded-end h-100">
                                    <p class="small text-secondary text-uppercase mb-1" style="font-size: 0.7rem;">@config["Fecha1"].label</p>
                                    <p class="small fw-bold text-dark mb-0">
                                        <i class="fas fa-calendar-day text-primary me-1"></i> @FormatFechaCompleta(Model.Fecha1.Value)
                                    </p>
                                </div>
                            </div>
                        }
                        @if (config != null && config["Hora1"].show && !string.IsNullOrEmpty(hora1))
                        {
                            <div class="col-md-6">
                                <div class="p-3 border-start border-info border-3 bg-light rounded-end h-100">
                                    <p class="small text-secondary text-uppercase mb-1" style="font-size: 0.7rem;">@config["Hora1"].label</p>
                                    <p class="small fw-bold text-dark mb-0">
                                        <i class="fas fa-clock text-info me-1"></i> @hora1
                                    </p>
                                </div>
                            </div>
                        }
                        @if (config != null && config["Fecha2"].show && Model.Fecha2.HasValue)
                        {
                            <div class="col-md-6">
                                <div class="p-3 border-start border-primary border-3 bg-light rounded-end h-100">
                                    <p class="small text-secondary text-uppercase mb-1" style="font-size: 0.7rem;">@config["Fecha2"].label</p>
                                    <p class="small fw-bold text-dark mb-0">
                                        <i class="fas fa-calendar-day text-primary me-1"></i> @FormatFechaCompleta(Model.Fecha2.Value)
                                    </p>
                                </div>
                            </div>
                        }
                        @if (config != null && config["Hora2"].show && !string.IsNullOrEmpty(hora2))
                        {
                            <div class="col-md-6">
                                <div class="p-3 border-start border-info border-3 bg-light rounded-end h-100">
                                    <p class="small text-secondary text-uppercase mb-1" style="font-size: 0.7rem;">@config["Hora2"].label</p>
                                    <p class="small fw-bold text-dark mb-0">
                                        <i class="fas fa-clock text-info me-1"></i> @hora2
                                    </p>
                                </div>
                            </div>
                        }
                        @if (showDias)
                        {
                            <div class="col-12">
                                <div class="p-3 border-start border-success border-3 bg-light rounded-end">
                                    <p class="small text-secondary text-uppercase mb-1" style="font-size: 0.7rem;">Días Solicitados</p>
                                    <p class="small fw-bold text-dark mb-0">
                                        <i class="fas fa-calendar-check text-success me-1"></i> @Model.Dias @(Model.Dias == 1 ? "día" : "días")
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Evidencia))
                {
                    <div class="col-12 mt-5">
                        <h3 class="h5 fw-semibold text-dark mb-4">Evidencia Adjunta</h3>
                        <div class="audit-card bg-light rounded-3 p-0 overflow-hidden shadow-sm" style="border: 1px solid var(--border-color);">
                            @if (evidenceExists)
                            {
                                <div class="p-3 bg-primary text-white d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold"><i class="fas fa-file-pdf me-2"></i> @System.IO.Path.GetFileName(evidenceUrl)</span>
                                    <a href="@evidenceUrl" target="_blank" class="btn btn-sm btn-light py-0"><i class="fas fa-external-link-alt"></i></a>
                                </div>
                                <iframe src="@evidenceUrl" style="width: 100%; height: 500px; border: none;"></iframe>
                            }
                            else
                            {
                                <div class="p-4 text-center text-danger">
                                    <i class="fas fa-exclamation-triangle fs-2 mb-2"></i>
                                    <p class="mb-0 fw-bold">Archivo no encontrado: @System.IO.Path.GetFileName(Model.Evidencia)</p>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="col-12 mt-5 pt-4 border-top">
                    <h3 class="h5 fw-semibold text-dark mb-4">Auditoría de Solicitud</h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="audit-card bg-light rounded-3 p-3 h-100">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="audit-icon bg-success text-white" style="width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-plus small"></i>
                                    </div>
                                    <div>
                                        <p class="small text-secondary mb-0">Fecha Creación</p>
                                        <p class="fw-bold text-dark mb-0">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (Model.IdUsuarioSolicitaNavigation != null)
                        {
                            <div class="col-md-4">
                                <div class="audit-card bg-light rounded-3 p-3 h-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="audit-icon bg-primary text-white" style="width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-user small"></i>
                                        </div>
                                        <div>
                                            <p class="small text-secondary mb-0">Solicitado por</p>
                                            <p class="fw-bold text-dark mb-0">@Model.IdUsuarioSolicitaNavigation.Nombre</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (Model.IdUsuarioModificaNavigation != null)
                        {
                            <div class="col-md-4">
                                <div class="audit-card bg-light rounded-3 p-3 h-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="audit-icon bg-warning text-white" style="width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-user-edit small"></i>
                                        </div>
                                        <div>
                                            <p class="small text-secondary mb-0">Última Modificación por</p>
                                            <p class="fw-bold text-dark mb-0">@Model.IdUsuarioModificaNavigation.Nombre</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer pt-4 pb-3 px-4 px-md-5 bg-light border-top d-flex justify-content-end align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i> Regresar
            </a>
            @if (Model.IdCorte == (int?)ViewBag.CurrentCourtId && !Model.Revisado)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4">
                    <i class="fas fa-edit me-2"></i> Editar
                </a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animación de entrada para las secciones
            const cards = document.querySelectorAll('.info-card, .p-3.border-start');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(10px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.4s ease-out';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, 50 * (index + 1));
            });
        });
    </script>
}
