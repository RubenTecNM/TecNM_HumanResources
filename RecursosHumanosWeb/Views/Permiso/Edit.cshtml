@model RecursosHumanosWeb.Models.ViewModels.PermissionsCreateViewModel
@{
    ViewData["Title"] = "Modificar Permiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/cssv2/views/permisos/create.css" asp-append-version="true" />
}

<div class="permission-request-container">
    <div class="page-header-v2 fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-edit"></i>
                Modificar Permiso
            </h1>
            <p class="page-subtitle">Actualice los detalles de su solicitud</p>
        </div>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="permission-form ajax-form" id="editPermissionForm"
          data-tipo-permiso="@Model.IdTipoPermiso">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IdUsuarioSolicita" />
        <input type="hidden" asp-for="IdTipoPermiso" />
        <input type="hidden" asp-for="Fecha1" />
        <input type="hidden" asp-for="Fecha2" />

        <div class="form-sections">
            <!-- Sección: Tipo de Permiso (Ahora EDITABLE) -->
            <div class="form-section">
                <div class="section-header">
                    <h3><i class="fas fa-list-ul"></i> Tipo de Permiso</h3>
                    <span class="section-indicator">1</span>
                </div>
                <div class="permission-types readonly-mode">
                    @if (Model.IdTipoPermiso == 1)
                    {
                        <div class="permission-type-card selected" data-type="1">
                            <input type="radio" id="retardo" name="IdTipoPermiso" value="1" asp-for="IdTipoPermiso" disabled checked>
                            <label for="retardo" class="type-label">
                                <div class="type-icon">
                                    <i class="fas fa-clock"></i>
                                </div>
                                <h4>Retardo</h4>
                                <p>Llegada tarde en un día específico</p>
                            </label>
                        </div>
                    }
                    @if (Model.IdTipoPermiso == 2)
                    {
                        <div class="permission-type-card selected" data-type="2">
                            <input type="radio" id="turnoPorTurno" name="IdTipoPermiso" value="2" asp-for="IdTipoPermiso" disabled checked>
                            <label for="turnoPorTurno" class="type-label">
                                <div class="type-icon">
                                    <i class="fas fa-sync-alt"></i>
                                </div>
                                <h4>Turno por Turno</h4>
                                <p>Intercambio de turnos con compañero</p>
                            </label>
                        </div>
                    }
                    @if (Model.IdTipoPermiso == 3)
                    {
                        <div class="permission-type-card selected" data-type="3">
                            <input type="radio" id="falta" name="IdTipoPermiso" value="3" asp-for="IdTipoPermiso" disabled checked>
                            <label for="falta" class="type-label">
                                <div class="type-icon">
                                    <i class="fas fa-calendar-times"></i>
                                </div>
                                <h4>Falta</h4>
                                <p>Ausencia por uno o varios días</p>
                            </label>
                        </div>
                    }
                    @if (Model.IdTipoPermiso == 4)
                    {
                        <div class="permission-type-card selected" data-type="4">
                            <input type="radio" id="cambioHorario" name="IdTipoPermiso" value="4" asp-for="IdTipoPermiso" disabled checked>
                            <label for="cambioHorario" class="type-label">
                                <div class="type-icon">
                                    <i class="fas fa-exchange-alt"></i>
                                </div>
                                <h4>Cambio de Horario</h4>
                                <p>Modificar horario de trabajo</p>
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="IdTipoPermiso" class="text-danger validation-message"></span>
            </div>

            <!-- Sección: Fechas y Horarios -->
            <div class="form-section" id="datetime-section">
                <div class="section-header">
                    <h3><i class="fas fa-calendar-alt"></i> Fechas y Horarios</h3>
                    <span class="section-indicator">2</span>
                </div>
                <div class="datetime-grid">
                    <div class="form-group" id="fecha1Date-group">
                        <label asp-for="Fecha1Date" class="form-label">
                            <span id="fecha1Date-label">Fecha de inicio</span>
                            <span class="required">*</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-calendar input-icon"></i>
                            <input asp-for="Fecha1Date" type="date" class="form-control" placeholder="DD/MM/YYYY" asp-format="{0:yyyy-MM-dd}" />
                        </div>
                        <span asp-validation-for="Fecha1Date" class="text-danger validation-message"></span>
                    </div>
                    <div class="form-group" id="fecha2Date-group">
                        <label asp-for="Fecha2Date" class="form-label">
                            <span id="fecha2Date-label">Fecha de fin</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-calendar input-icon"></i>
                            <input asp-for="Fecha2Date" type="date" class="form-control" placeholder="DD/MM/YYYY" asp-format="{0:yyyy-MM-dd}" />
                        </div>
                        <span asp-validation-for="Fecha2Date" class="text-danger validation-message"></span>
                    </div>
                    <div class="form-group" id="hora1Time-group">
                        <label asp-for="Hora1Time" class="form-label">
                            <span id="hora1Time-label">Hora de entrada</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-clock input-icon"></i>
                            <input asp-for="Hora1Time" type="time" class="form-control" placeholder="HH:MM AM/PM" />
                        </div>
                        <span asp-validation-for="Hora1Time" class="text-danger validation-message"></span>
                    </div>
                    <div class="form-group" id="hora2Time-group">
                        <label asp-for="Hora2Time" class="form-label">
                            <span id="hora2Time-label">Hora de salida</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-clock input-icon"></i>
                            <input asp-for="Hora2Time" type="time" class="form-control" placeholder="HH:MM AM/PM" />
                        </div>
                        <span asp-validation-for="Hora2Time" class="text-danger validation-message"></span>
                    </div>
                </div>
            </div>

            <!-- Sección: Motivo -->
            <div class="form-section" id="reason-section">
                <div class="section-header">
                    <h3><i class="fas fa-comment-alt"></i> Motivo del Permiso</h3>
                    <span class="section-indicator">3</span>
                </div>
                <div class="form-group">
                    <label asp-for="Motivo" class="form-label">
                        Explique detalladamente el motivo de su solicitud
                        <span class="required">*</span>
                    </label>
                    <div class="textarea-wrapper">
                        <textarea asp-for="Motivo" class="form-control-v2" rows="4" placeholder="Ej: Cita médica en el IMSS o Trámite personal..." maxlength="255"></textarea>
                        <div class="char-counter">
                            <span id="char-count">0</span>/255 caracteres
                        </div>
                    </div>
                    <span asp-validation-for="Motivo" class="text-danger small"></span>
                </div>
            </div>

            <!-- Sección: Evidencia -->
            <div class="form-section" id="evidence-section">
                <div class="section-header">
                    <h3><i class="fas fa-paperclip"></i> Documentación de Soporte</h3>
                    <span class="section-indicator">4</span>
                </div>
                <div class="form-group">
                    <label asp-for="EvidenceFile" class="form-label">
                        Adjuntar documento PDF (opcional)
                    </label>
                    <div class="file-upload-area" id="fileUploadArea">
                        <input asp-for="EvidenceFile" type="file" accept=".pdf" class="file-input" id="evidenceFile">
                        <div class="file-upload-content" id="fileUploadContent" style="@(!string.IsNullOrEmpty(Model.Evidencia) ? "display:none;" : "")">
                            <div class="file-upload-icon"><i class="fas fa-cloud-upload-alt"></i></div>
                            <p class="file-upload-text">Subir PDF</p>
                            <p class="file-upload-hint">Haz clic o arrastra un archivo PDF aquí</p>
                        </div>
                        <div class="file-preview" id="filePreview" style="@(string.IsNullOrEmpty(Model.Evidencia) ? "display:none;" : "")">
                            <div class="file-info">
                                <i class="fas fa-file-pdf file-icon"></i>
                                <span class="file-name" id="fileName">@(string.IsNullOrEmpty(Model.Evidencia) ? "" : System.IO.Path.GetFileName(Model.Evidencia))</span>
                            </div>
                            <button type="button" class="remove-file" id="removeFile" title="Eliminar archivo">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <input asp-for="Evidencia" type="hidden" />
                    @if (!string.IsNullOrEmpty(Model.Evidencia))
                    {
                        <div class="mt-3 p-3 bg-light rounded-4 border-start border-success border-4 d-flex align-items-center gap-3">
                            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold text-success small">Documento Existente</div>
                                <a href="@Model.Evidencia" target="_blank" class="text-decoration-none small fw-semibold">
                                    <i class="fas fa-external-link-alt me-1"></i> Ver documento actual
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Botones de Acción -->
        <div class="form-actions">
            <div class="actions-content justify-content-end">
                <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm" id="submitBtn">
                    <i class="fas fa-save me-2"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/Permisos/edit.js" asp-append-version="true"></script>
}