@model RecursosHumanosWeb.Models.Permiso
@using System.IO
@using System.Globalization
@using RecursosHumanosWeb.Models.Enums
@{
    ViewData["Title"] = "Autorizar Permiso";
    var culture = new CultureInfo("es-MX");

    string FormatHora12(DateTime fecha) => fecha.ToString("hh:mm tt", culture).ToUpper();
    string FormatFechaCompleta(DateTime fecha) => fecha.ToString("dd 'de' MMMM 'del' yyyy", culture);

    var typeConfigurations = new Dictionary<int, Dictionary<string, (bool show, string label)>>
    {
        [1] = new Dictionary<string, (bool, string)> { ["Fecha1"] = (true, "En el día"), ["Fecha2"] = (false, "Al día"), ["Hora1"] = (true, "Hora de llegada"), ["Hora2"] = (false, "Hora salida") },
        [2] = new Dictionary<string, (bool, string)> { ["Fecha1"] = (true, "Del día"), ["Fecha2"] = (true, "Por el día"), ["Hora1"] = (true, "Hora entrada"), ["Hora2"] = (true, "Hora salida") },
        [3] = new Dictionary<string, (bool, string)> { ["Fecha1"] = (true, "Del día"), ["Fecha2"] = (true, "Al día"), ["Hora1"] = (false, "Hora entrada"), ["Hora2"] = (false, "Hora salida") },
        [4] = new Dictionary<string, (bool, string)> { ["Fecha1"] = (true, "Del día"), ["Fecha2"] = (true, "Al día"), ["Hora1"] = (true, "Hora entrada"), ["Hora2"] = (true, "Hora salida") }
    };

    var config = typeConfigurations.ContainsKey(Model.IdTipoPermiso) ? typeConfigurations[Model.IdTipoPermiso] : null;
    bool showDias = config != null && config["Fecha2"].show && Model.Fecha2.HasValue && Model.Dias.HasValue && Model.Dias.Value > 1;

    string? evidenceUrl = !string.IsNullOrEmpty(Model.Evidencia) ? Model.Evidencia.Replace('\\', '/').Trim() : null;
    if (evidenceUrl != null && !evidenceUrl.StartsWith("/") && !evidenceUrl.Contains("/")) evidenceUrl = "/Evidences/" + evidenceUrl;

    bool isRHOrAdmin = (ViewBag.CurrentUserType ?? 0) == (int)TipoUsuarioEnum.Administrador;
    bool isApprover = ViewBag.IsApprover ?? false;
    bool canReview = (Model.IdEstadoPermiso == 1) && (isRHOrAdmin || (isApprover && Model.IdCorte == (int?)ViewBag.CurrentCourtId));

    string solicitanteNombre = Model.IdUsuarioSolicitaNavigation?.Nombre ?? "Usuario";
    string inicial = !string.IsNullOrEmpty(solicitanteNombre) ? solicitanteNombre.Substring(0, 1).ToUpper() : "U";
}

@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Permisos/review.css" asp-append-version="true" />
    <style>
        .details-container { padding: 2rem !important; }
        .goce-decision-integrated {
            margin-top: 2rem;
            padding: 2.5rem;
            border-radius: 1.5rem;
            background: #f8fafc;
            border: 2px dashed #3b82f6;
            animation: fadeIn 0.8s ease-out;
        }
        .permission-type-card.active { border: 2px solid #3b82f6; background: rgba(59, 130, 246, 0.05); }
    </style>
}

<div class="details-container">
    <div class="card details-card shadow-lg rounded-3 overflow-hidden border-0">
        <div class="details-header-gradient text-white px-4 py-4" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);">
            <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="details-avatar rounded-circle d-flex align-items-center justify-content-center text-white fs-3 fw-bold" style="width: 60px; height: 60px; background: rgba(255,255,255,0.1); border: 2px solid rgba(255,255,255,0.2);">
                        @inicial
                    </div>
                    <div>
                        <h2 class="h4 fw-semibold mb-1">Autorizaci&oacute;n de Permiso #@Model.Id</h2>
                        <p class="mb-0 d-flex align-items-center gap-2" style="color: #dbeafe; opacity: 0.9;">
                             <i class="fas fa-user-check"></i> Revisando solicitud de: @solicitanteNombre
                        </p>
                    </div>
                </div>
                <div class="status-glass rounded-pill px-3 py-2 d-flex align-items-center shadow-sm" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.2);">
                    <span class="status-dot" style="background-color: #f59e0b; box-shadow: 0 0 10px #f59e0b; height: 10px; width: 10px; border-radius: 50%; display: inline-block; margin-right: 10px;"></span> 
                    <span class="small text-uppercase fw-bold">PENDIENTE DE REVISI&Oacute;N</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5 bg-white">
            <div class="row g-5">
                <div class="col-12 col-lg-6">
                    <h3 class="section-title h5 text-dark border-bottom pb-2 mb-4"><i class="fas fa-file-alt text-primary me-2"></i>Resumen de Solicitud</h3>
                    <div class="p-4 bg-light rounded-3 mb-4">
                        <p class="small text-secondary text-uppercase fw-bold mb-1">Motivo</p>
                        <p class="text-dark mb-0" style="white-space: pre-wrap;">@Model.Motivo</p>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 border rounded shadow-sm bg-white h-100">
                                <p class="small text-secondary text-uppercase mb-1" style="font-size: 0.7rem;">Tipo</p>
                                <p class="small fw-bold mb-0"><i class="fas fa-tag text-primary me-2"></i>@Model.IdTipoPermisoNavigation?.Descripcion</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 border rounded shadow-sm bg-white h-100">
                                <p class="small text-secondary text-uppercase mb-1" style="font-size: 0.7rem;">Área</p>
                                <p class="small fw-bold mb-0"><i class="fas fa-building text-primary me-2"></i>@(Model.IdUsuarioSolicitaNavigation?.IdAreaNavigation?.Descripcion ?? "N/A")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <h3 class="section-title h5 text-dark border-bottom pb-2 mb-4"><i class="fas fa-calendar-check text-primary me-2"></i>Vigencia</h3>
                    <div class="detail-grid d-flex flex-column gap-3">
                        <div class="p-3 border-start border-primary border-3 bg-light rounded-end">
                            <p class="small text-secondary text-uppercase mb-1" style="font-size: 0.7rem;">Desde</p>
                            <p class="fw-bold text-dark mb-0">@FormatFechaCompleta(Model.Fecha1.Value) @(config != null && config["Hora1"].show ? "- " + FormatHora12(Model.Fecha1.Value) : "")</p>
                        </div>
                        @if (Model.Fecha2.HasValue)
                        {
                            <div class="p-3 border-start border-primary border-3 bg-light rounded-end">
                                <p class="small text-secondary text-uppercase mb-1" style="font-size: 0.7rem;">Hasta</p>
                                <p class="fw-bold text-dark mb-0">@FormatFechaCompleta(Model.Fecha2.Value) @(config != null && config["Hora2"].show ? "- " + FormatHora12(Model.Fecha2.Value) : "")</p>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(evidenceUrl))
                {
                    <div class="col-12">
                        <h3 class="h5 fw-semibold text-dark mb-4 border-bottom pb-2"><i class="fas fa-paperclip text-primary me-2"></i>Evidencia</h3>
                        <iframe src="@evidenceUrl" style="width: 100%; height: 400px; border: 1px solid #e2e8f0; border-radius: 12px;"></iframe>
                    </div>
                }

                @if (canReview)
                {
                    <div class="col-12 goce-decision-integrated shadow-sm">
                        <div class="text-center mb-5">
                            <h3 class="fw-bold h4"><i class="fas fa-user-shield me-2 text-primary"></i> M&oacute;dulo de Autorizaci&oacute;n</h3>
                            <p class="text-muted small">Determine el goce de sueldo para autorizar formalmente esta solicitud.</p>
                        </div>
                        
                        <form asp-action="Review" method="post" id="reviewFormInline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="@Model.Id" />
                            
                            <div class="goce-options d-flex gap-4 justify-content-center flex-wrap">
                                <div class="goce-option" data-value="true" style="min-width: 250px;">
                                    <input type="radio" name="Goce" id="goceTrue" value="true" checked style="display:none;">
                                    <div class="option-content p-4 rounded-4 text-center border-2 bg-white shadow-sm transition-all h-100" style="cursor:pointer; border: 2px solid #e2e8f0;">
                                        <div class="option-icon bg-success text-white mx-auto mb-3" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-check fa-lg"></i>
                                        </div>
                                        <h5 class="fw-bold mb-1">CON GOCE</h5>
                                        <p class="small text-muted mb-0">El tiempo se pagar&aacute; normal</p>
                                    </div>
                                </div>

                                <div class="goce-option" data-value="false" style="min-width: 250px;">
                                    <input type="radio" name="Goce" id="goceFalse" value="false" style="display:none;">
                                    <div class="option-content p-4 rounded-4 text-center border-2 bg-white shadow-sm transition-all h-100" style="cursor:pointer; border: 2px solid #e2e8f0;">
                                        <div class="option-icon bg-warning text-white mx-auto mb-3" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-times fa-lg"></i>
                                        </div>
                                        <h5 class="fw-bold mb-1">SIN GOCE</h5>
                                        <p class="small text-muted mb-0">Se descontar&aacute; del salario</p>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center mt-5">
                                <button type="submit" id="submitReviewBtn" class="btn btn-success btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg">
                                    <i class="fas fa-check-double me-2"></i> Finalizar y Autorizar Permiso
                                </button>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i> No tiene los permisos necesarios o el periodo est&aacute; cerrado para realizar esta acci&oacute;n.
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card-footer py-4 px-5 bg-light d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                <i class="fas fa-arrow-left me-2"></i> Cancelar
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const goceOptions = document.querySelectorAll('.goce-option');
            
            function updateUi() {
                const selected = document.querySelector('input[name="Goce"]:checked');
                goceOptions.forEach(opt => {
                    const content = opt.querySelector('.option-content');
                    content.style.borderColor = '#e2e8f0';
                    content.style.background = '#ffffff';
                    content.style.transform = 'scale(1)';
                });
                if (selected) {
                    const content = selected.closest('.goce-option').querySelector('.option-content');
                    content.style.borderColor = '#3b82f6';
                    content.style.background = 'rgba(59, 130, 246, 0.05)';
                    content.style.transform = 'scale(1.02)';
                }
            }
            
            goceOptions.forEach(opt => {
                opt.addEventListener('click', () => {
                    const val = opt.dataset.value;
                    const radio = document.getElementById(val === 'true' ? 'goceTrue' : 'goceFalse');
                    if (radio) { radio.checked = true; updateUi(); }
                });
            });
            
            updateUi();

            const reviewForm = document.getElementById('reviewFormInline');
            if (reviewForm) {
                reviewForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const selected = document.querySelector('input[name="Goce"]:checked');
                    if (!selected) return;
                    
                    const goceVal = selected.value === 'true';
                    const confirm = await Swal.fire({
                        title: '¿Confirmar Autorización?',
                        html: `La solicitud será marcada como autorizada <strong>${goceVal ? 'CON GOCE' : 'SIN GOCE'}</strong> de sueldo.`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Sí, Autorizar',
                        cancelButtonText: 'Cancelar'
                    });
                    
                    if (!confirm.isConfirmed) return;
                    
                    const btn = document.getElementById('submitReviewBtn');
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Procesando...';
                    
                    try {
                        const formData = new FormData(reviewForm);
                        const response = await fetch(reviewForm.action, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                            body: formData
                        });
                        const data = await response.json();
                        if (typeof handleAlertResponse === 'function') { 
                            await handleAlertResponse(data); 
                        } else {
                            window.location.href = data.redirectUrl || '/Permiso/Index';
                        }
                    } catch (err) {
                        Swal.fire('Error', err.message, 'error');
                        btn.disabled = false;
                        btn.innerHTML = 'Finalizar y Autorizar Permiso';
                    }
                });
            }
        });
    </script>
}
