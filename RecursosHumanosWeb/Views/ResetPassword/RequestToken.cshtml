@model RecursosHumanosWeb.Models.ViewModels.ResetPassword.RequestTokenViewModel
@{
    ViewData["Title"] = "Solicitar Token";
}

<div class="index-container">
    <!-- Page Header (Premium Style) -->
    <div class="permission-header fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-key"></i>
                Recuperar Contrase&ntilde;a
            </h1>
            <p class="page-subtitle">Ingresa tu correo electr&oacute;nico institucional para restablecer tu acceso</p>
        </div>
    </div>

    <!-- Mensaje de respuesta -->
    @if (ViewBag.Message != null)
    {
        <div class="filters-section fade-in">
            <div class="alert alert-info shadow-sm rounded-4 border-0" style="background: rgba(59, 130, 246, 0.1); color: #1e40af;">
                <i class="fas fa-info-circle me-2"></i>
                @ViewBag.Message
            </div>
        </div>
    }

    <!-- Formulario (Cloudflare-Inspired Card) -->
    <div class="filters-section slide-in-left">
        <div class="card filter-card-premium shadow-lg border-0">
            <div class="filter-header-premium d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 overflow-hidden">
                    <i class="fas fa-envelope-open-text fa-lg"></i>
                    <h5 class="m-0 fw-bold text-truncate" style="letter-spacing: 0.5px; text-transform: uppercase;">Solicitud</h5>
                </div>
                <!-- Icono animado -->
                <div class="status-glass rounded-pill d-flex align-items-center gap-2 px-2 px-sm-3 py-1 flex-shrink-0" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(4px);">
                    <span class="status-dot dot-active" style="animation: icon-pulse-soft 2s infinite ease-in-out;"></span>
                    <span class="small uppercase tracking-wide fw-bold d-none d-sm-inline" style="font-size: 0.7rem;">Seguro</span>
                    <span class="small fw-bold d-inline d-sm-none" style="font-size: 0.6rem;">SSL</span>
                </div>
            </div>

            <div class="filter-body-premium p-3 p-sm-4">
                <form asp-action="RequestToken" method="post" class="ajax-form" id="requestTokenForm" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <!-- Campo Email -->
                    <div class="form-group mb-4">
                        <label asp-for="Email" class="fw-bold text-muted small text-uppercase mb-2 ms-2 d-block">
                            &#128231; Correo Electr&oacute;nico
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3" style="border: 2px solid #ced4da; border-right: none;">
                                <i class="fas fa-envelope text-primary"></i>
                            </span>
                            <input asp-for="Email"
                                   class="form-control border-start-0 rounded-end-pill py-2 shadow-sm"
                                   type="email"
                                   placeholder="usuario@@monclova.tecnm.mx"
                                   required
                                   autocomplete="email" 
                                   style="height: 52px; border: 2px solid #ced4da; border-left: none;"/>
                        </div>
                        <span asp-validation-for="Email" class="text-danger mt-2 d-block ms-2" style="font-weight: 600; font-size: 0.85rem;"></span>
                    </div>

                    <!-- Botones de accion -->
                    <div class="d-flex flex-column gap-3 mt-4">
                        <button type="submit" class="btn btn-primary rounded-pill w-100 fw-bold shadow-sm"
                                style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); border: none; height: 52px;">
                            <i class="fas fa-paper-plane me-2"></i>
                            Enviar Token
                        </button>
                        <div class="text-center">
                            <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold text-decoration-none small hover-link d-inline-flex align-items-center">
                                <i class="fas fa-arrow-left me-2"></i>
                                Volver al Login
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes icon-pulse-soft {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.7; }
    }
    .hover-link:hover {
        text-decoration: underline !important;
        opacity: 0.8;
    }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const elements = document.querySelectorAll('.fade-in, .slide-in-left');
            elements.forEach(element => {
                element.style.opacity = '0';
                element.style.transform = 'translateY(20px)';
            });

            setTimeout(() => {
                elements.forEach((element, index) => {
                    setTimeout(() => {
                        element.style.transition = 'all 0.6s ease-out';
                        element.style.opacity = '1';
                        element.style.transform = 'translate(0, 0)';
                    }, index * 100);
                });
            }, 100);
        });
    </script>
}
