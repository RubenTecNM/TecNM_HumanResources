@model RecursosHumanosWeb.Models.ViewModels.ResetPassword.ConfirmTokenViewModel
@{
    ViewData["Title"] = "Confirmar Token";
}

<div class="index-container">
    <!-- Page Header (Premium Style) -->
    <div class="permission-header fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-user-check"></i>
                Confirmar Identidad
            </h1>
            <p class="page-subtitle">Ingresa el token que recibiste en tu correo electr&oacute;nico institucional</p>
        </div>
    </div>

    <!-- Formulario (Cloudflare-Inspired Card) -->
    <div class="filters-section slide-in-left">
        <div class="card filter-card-premium shadow-lg border-0">
            <div class="filter-header-premium d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 overflow-hidden">
                    <i class="fas fa-shield-alt fa-lg"></i>
                    <h5 class="m-0 fw-bold text-truncate" style="letter-spacing: 0.5px; text-transform: uppercase;">Validaci&oacute;n</h5>
                </div>
                <div class="status-glass rounded-pill d-flex align-items-center gap-2 px-2 px-sm-3 py-1 flex-shrink-0" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(4px);">
                    <span class="status-dot dot-active" style="animation: icon-pulse-soft 2s infinite ease-in-out;"></span>
                    <span class="small uppercase tracking-wide fw-bold d-none d-sm-inline" style="font-size: 0.7rem;">Verificando</span>
                    <span class="small fw-bold d-inline d-sm-none" style="font-size: 0.6rem;">SSL</span>
                </div>
            </div>

            <div class="filter-body-premium p-3 p-sm-4">
                <form asp-action="ConfirmToken" method="post" class="ajax-form" id="confirmTokenForm" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <!-- Campo Email -->
                        <div class="col-12 col-md-6">
                            <div class="filter-group">
                                <label asp-for="Email" class="fw-bold text-muted small text-uppercase mb-2 ms-2 d-block">
                                    &#128231; Correo Electr&oacute;nico
                                </label>
                                <input asp-for="Email" class="form-control rounded-pill bg-light" value="@Model.Email" readonly style="height: 52px; border: 2px solid #ced4da;" />
                                <span asp-validation-for="Email" class="text-danger small ms-2 fw-semibold"></span>
                            </div>
                        </div>

                        <!-- Campo Token -->
                        <div class="col-12 col-md-6">
                            <div class="filter-group">
                                <label asp-for="Token" class="fw-bold text-muted small text-uppercase mb-2 ms-2 d-block">
                                    &#128274; Token de Seguridad
                                </label>
                                <input asp-for="Token" 
                                       class="form-control rounded-pill shadow-sm border-primary" 
                                       placeholder="Pega tu token aqu&iacute;" 
                                       required 
                                       style="height: 52px; border: 2px solid #ced4da;" />
                                <span asp-validation-for="Token" class="text-danger small ms-2 fw-semibold"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de accion -->
                    <div class="d-flex flex-column gap-3 mt-4 mt-sm-5">
                        <button type="submit" class="btn btn-primary rounded-pill w-100 fw-bold shadow-sm"
                                style="background: linear-gradient(135deg, #10B981 0%, #059669 100%); border: none; height: 52px;">
                            <i class="fas fa-check-circle me-2"></i>
                            Confirmar Token
                        </button>
                        <div class="text-center">
                            <a asp-action="RequestToken" class="text-primary fw-bold text-decoration-none small hover-link d-inline-flex align-items-center">
                                <i class="fas fa-redo me-2"></i>
                                Reenviar Correo
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes icon-pulse-soft {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.7; }
    }
    .hover-link:hover {
        text-decoration: underline !important;
        opacity: 0.8;
    }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/lib/sweetalert2/dist/sweetalert2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const elements = document.querySelectorAll('.fade-in, .slide-in-left');
            elements.forEach(element => {
                element.style.opacity = '0';
                element.style.transform = 'translateY(20px)';
            });

            setTimeout(() => {
                elements.forEach((element, index) => {
                    setTimeout(() => {
                        element.style.transition = 'all 0.6s ease-out';
                        element.style.opacity = '1';
                        element.style.transform = 'translate(0, 0)';
                    }, index * 100);
                });
            }, 100);
        });
    </script>
}
