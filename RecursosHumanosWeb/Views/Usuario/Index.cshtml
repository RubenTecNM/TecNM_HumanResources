@model UsuarioSearchViewModel
@using RecursosHumanosWeb.Models.ViewModels.Usuario
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

@section Styles {
    <!-- Usuario Index uses global components from v2-site.css -->
}

<div class="index-container">
    @Html.AntiForgeryToken()
    <!-- ... existing header and filters ... -->
    <div class="page-header-v2 fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-users"></i>
                Gestión de Usuarios
            </h1>
            <p class="page-subtitle">Administra y visualiza todos los usuarios del sistema</p>
        </div>
        <authorize-section policy="RHOrAdmin">
            <div class="header-actions">
                <a asp-controller="Usuario" asp-action="Create" class="btn btn-create" aria-label="Crear nuevo usuario">
                    <i class="fas fa-plus"></i>
                    Crear Usuario
                </a>
            </div>
        </authorize-section>
    </div>

    <div class="filters-section slide-in-left">


        <div class="card filter-card-premium">
            <div class="filter-header-premium">
                <i class="fas fa-filter fa-lg"></i>
                <h5 class="m-0 fw-bold" style="letter-spacing: 0.5px;">Panel de Búsqueda</h5>
            </div>
            <div class="filter-body-premium">
                <form id="searchForm" method="get" asp-action="Index">
                    @Html.AntiForgeryToken()
                    <div class="row g-4">
                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Colaborador</label>
                                <select id="nombreFilter" name="nombreFilter_display" class="form-control user-autocomplete w-100">
                                    <option value="">-- Buscar por nombre --</option>
                                </select>
                                <input type="hidden" id="nombreFilterHidden" name="nombreFilter" value="@ViewBag.NombreFilter" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Correo Electrónico</label>
                                <input id="correoFilter" name="correoFilter" class="form-control filter-input-pill" type="text"
                                       value="@ViewBag.CorreoFilter" placeholder="ejemplo@correo.com" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Departamento</label>
                                <select id="departamentoFilter" name="departamentoFilter" class="form-control filter-input-pill form-select">
                                    <option value="">Todos los departamentos</option>
                                    @foreach (var departamento in Model.Departamentos)
                                    {
                                        <option value="@departamento.Id" selected="@(ViewBag.DepartamentoFilter?.ToString() == departamento.Id.ToString() ? "selected" : null)">
                                            @departamento.Descripcion
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Estado</label>
                                <select id="estadoFilter" name="estadoFilter" class="form-control filter-input-pill form-select">
                                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.EstadoFilter?.ToString()) ? "selected" : null)">Todos los estados</option>
                                    <option value="true" selected="@(ViewBag.EstadoFilter is true ? "selected" : null)">Activo</option>
                                    <option value="false" selected="@(ViewBag.EstadoFilter is false ? "selected" : null)">Inactivo</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top gap-3">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold text-secondary border hover-shadow" style="transition: all 0.2s;">
                            <i class="fas fa-undo me-2"></i> Limpiar
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" 
                                style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); border: none;">
                            <i class="fas fa-search me-2"></i> Aplicar Filtros
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.UsuariosPaginados != null && Model.UsuariosPaginados.Any())
    {

        <div class="table-container fade-in">
            <div class="table-inner">
                <div class="overflow-x-auto">
                    <table class="data-table" style="width:100%; border: none; overflow: hidden; padding: 0;" aria-label="Tabla de usuarios">
                        <thead>
                            <tr>
                                <th class="text-center">ID</th>
                                <th class="text-center">Nombre</th>
                                <th class="text-center">Correo</th>
                                <th class="text-center">Departamento</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Fecha Creación</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.UsuariosPaginados)
                            {
                                <tr>
                                    <td class="text-center">@item.Id</td>
                                    <td><strong>@(item.Nombre ?? "-")</strong></td>
                                    <td>@(item.Correo ?? "-")</td>
                                    <td>@(item.IdDepartamentoNavigation?.Descripcion ?? "-")</td>
                                    <td class="text-center">
                                        <div class="v2-badge v2-badge-@(item.Estatus ? "success" : "danger")">
                                            <span class="v2-badge-dot"></span>
                                            @(item.Estatus ? "Activo" : "Inactivo")
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div style="color: var(--text-medium); font-weight: 500;">
                                            <div style="font-size: 0.875rem;">@item.FechaCreacion.ToString("dd/MM/yyyy")</div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem;">@item.FechaCreacion.ToString("h:mm tt")</div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="flex justify-center gap-2">
                                            <authorize-section policy="RHOrAdmin">
                                                <a asp-controller="Usuario" asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Editar" aria-label="Editar usuario">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="#" class="action-btn btn-delete" title="Eliminar" aria-label="Eliminar usuario" data-action="DeleteAjax" data-controller="Usuario" data-id="@item.Id">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="action-btn btn-view" title="Ver detalles" aria-label="Ver detalles del usuario">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </authorize-section>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th class="text-center">ID</th>
                                <th class="text-center">Nombre</th>
                                <th class="text-center">Correo</th>
                                <th class="text-center">Departamento</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Fecha Creación</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- Shared Pagination (Now visible for both mobile and desktop) -->
        <div class="pagination-container-v2 fade-in">
            <div class="pagination-info-v2">
                <i class="fas fa-users-cog me-2 opacity-50"></i>
                Mostrando <span class="fw-bold">@Model.UsuariosPaginados.FirstItemOnPage</span> - <span class="fw-bold">@Model.UsuariosPaginados.LastItemOnPage</span> de <span class="fw-bold">@Model.UsuariosPaginados.TotalItemCount</span> usuarios
            </div>

            <div class="v2-pagination">
                @Html.PagedListPager(
                    Model.UsuariosPaginados,
                    page => Url.Action("Index", new
                    {
                        page,
                        sortOrder = ViewBag.CurrentSort,
                        nombreFilter = ViewBag.NombreFilter,
                        correoFilter = ViewBag.CorreoFilter,
                        departamentoFilter = ViewBag.DepartamentoFilter,
                        estadoFilter = ViewBag.EstadoFilter
                    }),
                    new PagedListRenderOptions
                    {
                        DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                        DisplayLinkToLastPage = PagedListDisplayMode.Always,
                        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                        DisplayLinkToNextPage = PagedListDisplayMode.Always,
                        DisplayLinkToIndividualPages = true,
                        MaximumPageNumbersToDisplay = 5,
                        DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                        UlElementClasses = new[] { "pagination" },
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
            </div>
        </div>
    }
    else
    {
        <div class="empty-state fade-in">
            <div class="empty-icon">
                <i class="fas fa-users"></i>
            </div>
            <h3>No hay usuarios registrados</h3>
            <p class="text-muted">Intenta ajustar los filtros de búsqueda</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        (function(){
            $(document).ready(function(){
                (function(){
                    var $select = $('#nombreFilter');
                    var valueMode = $select.data('user-value') || 'text';
                    $select.select2({
                        placeholder: 'Filtrar por nombre...',
                        minimumInputLength: 2,
                        allowClear: true,
                        ajax: {
                        url: '@Url.Action("SearchUsers", "Usuario")',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) { return { term: params.term }; },
                        processResults: function (data) {
                            var results = data.map(function(item){
                                return {
                                    id: valueMode === 'text' ? item.text : item.id,
                                    text: item.text,
                                    areaId: item.areaId
                                };
                            });
                            return { results: results };
                        },
                        cache: true
                    }
                    });

                    // Ensure hidden field exists
                    if ($('#nombreFilterHidden').length === 0) {
                        $('<input>').attr({ type: 'hidden', id: 'nombreFilterHidden', name: 'nombreFilter', value: '@ViewBag.NombreFilter' }).appendTo('#searchForm');
                    }
                    $select.on('select2:select', function(e) {
                        var data = e.params.data;
                        if (valueMode === 'text') $('#nombreFilterHidden').val(data.text);
                        else $('#nombreFilterHidden').val(data.id);
                    });
                    $select.on('select2:clear', function() { $('#nombreFilterHidden').val(''); });
                })();

                // Initialize Department Filter
                $('#departamentoFilter').select2({
                    placeholder: 'Todos los departamentos',
                    width: '100%',
                    allowClear: true,
                    // Optional: customize dropdown css class if needed
                });

                // Initialize Status Filter (disable search for cleaner look)
                $('#estadoFilter').select2({
                    placeholder: 'Todos los estados',
                    width: '100%',
                    allowClear: true,
                    minimumResultsForSearch: Infinity // Hide search box
                });

                $('#nombreFilter').on('focus', function () { $(this).select2('open'); });
                $('#nombreFilter').on('select2:open', function () { const sf = document.querySelector('.select2-container--open .select2-search__field'); if (sf) sf.focus(); });
            });
        })();
        document.addEventListener('DOMContentLoaded', function () {
            const elements = document.querySelectorAll('.fade-in, .slide-in-left');
            elements.forEach(element => {
                element.style.opacity = '0';
                element.style.transform = element.classList.contains('slide-in-left')
                    ? 'translateY(20px)'
                    : 'translateY(20px)';
            });

            setTimeout(() => {
                elements.forEach((element, index) => {
                    setTimeout(() => {
                        element.style.transition = 'all 0.6s ease-out';
                        element.style.opacity = '1';
                        element.style.transform = 'translate(0, 0)';
                    }, index * 150);
                });
            }, 100);
        });
    </script>
}