@model UsuarioSearchViewModel
@using RecursosHumanosWeb.Models.ViewModels.Usuario
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />

    <style>
        /* Mobile-specific adjustments utilizing Site.css variables without external file */
        @@media (max-width: 992px) {
            .table-container { display: none !important; }
            .mobile-view-container { display: flex; flex-direction: column; gap: 1rem; }
            
            .mobile-card-header {
                cursor: pointer;
                transition: background-color 0.2s ease;
            }
            .mobile-card-header:hover { background-color: var(--surface-alt); }
            
            .rotate-icon { transition: transform 0.3s ease; }
            .expanded .rotate-icon { transform: rotate(180deg); }
            
            .expandable-content {
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }
            .expanded .expandable-content {
                max-height: 500px; /* limit for transition */
                border-top: 1px solid var(--border-light);
            }
        }
        @@media (min-width: 993px) {
            .mobile-view-container { display: none !important; }
        }
    </style>
}

<div class="index-container">
    @Html.AntiForgeryToken()
    <!-- ... existing header and filters ... -->
    <div class="permission-header fade-in">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-users"></i>
                Gestión de Usuarios
            </h1>
            <p class="page-subtitle">Administra y visualiza todos los usuarios del sistema</p>
        </div>
        @if (User.HasClaim("TipoUsuario", "1"))
        {
            <div class="header-actions">
                <a asp-controller="Usuario" asp-action="Create" class="btn btn-create" aria-label="Crear nuevo usuario">
                    <i class="fas fa-plus"></i>
                    Crear Usuario
                </a>
            </div>
        }
    </div>

    <div class="filters-section slide-in-left">


        <div class="card filter-card-premium">
            <div class="filter-header-premium">
                <i class="fas fa-filter fa-lg"></i>
                <h5 class="m-0 fw-bold" style="letter-spacing: 0.5px;">Panel de Búsqueda</h5>
            </div>
            <div class="filter-body-premium">
                <form id="searchForm" method="get" asp-action="Index">
                    @Html.AntiForgeryToken()
                    <div class="row g-4">
                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Colaborador</label>
                                <select id="nombreFilter" name="nombreFilter_display" class="form-control user-autocomplete w-100">
                                    <option value="">-- Buscar por nombre --</option>
                                </select>
                                <input type="hidden" id="nombreFilterHidden" name="nombreFilter" value="@ViewBag.NombreFilter" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Correo Electrónico</label>
                                <input id="correoFilter" name="correoFilter" class="form-control filter-input-pill" type="text"
                                       value="@ViewBag.CorreoFilter" placeholder="ejemplo@correo.com" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Departamento</label>
                                <select id="departamentoFilter" name="departamentoFilter" class="form-control filter-input-pill form-select">
                                    <option value="">Todos los departamentos</option>
                                    @foreach (var departamento in Model.Departamentos)
                                    {
                                        <option value="@departamento.Id" selected="@(ViewBag.DepartamentoFilter?.ToString() == departamento.Id.ToString() ? "selected" : null)">
                                            @departamento.Descripcion
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="fw-bold text-muted small text-uppercase mb-2 ms-2">Estado</label>
                                <select id="estadoFilter" name="estadoFilter" class="form-control filter-input-pill form-select">
                                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.EstadoFilter?.ToString()) ? "selected" : null)">Todos los estados</option>
                                    <option value="true" selected="@(ViewBag.EstadoFilter is true ? "selected" : null)">Activo</option>
                                    <option value="false" selected="@(ViewBag.EstadoFilter is false ? "selected" : null)">Inactivo</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top gap-3">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold text-secondary border hover-shadow" style="transition: all 0.2s;">
                            <i class="fas fa-undo me-2"></i> Limpiar
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" 
                                style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); border: none;">
                            <i class="fas fa-search me-2"></i> Aplicar Filtros
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.UsuariosPaginados != null && Model.UsuariosPaginados.Any())
    {
        <!-- MOBILE CARD VIEW (Visible < 992px) -->
        <div class="mobile-view-container fade-in">
            @foreach (var item in Model.UsuariosPaginados)
            {
                var uniqueId = "mob-" + item.Id;
                
                // Cloudflare-inspired varied palette
                var colorIndex = item.Id % 5;
                var boxGradient = "";
                var accentColor = "";
                
                switch (colorIndex) {
                    case 0: // Indigo
                        boxGradient = "linear-gradient(135deg, #6366f1, #4338ca)";
                        accentColor = "#4338ca";
                        break;
                    case 1: // Emerald
                        boxGradient = "linear-gradient(135deg, #10b981, #059669)";
                        accentColor = "#059669";
                        break;
                    case 2: // Amber
                        boxGradient = "linear-gradient(135deg, #f59e0b, #d97706)";
                        accentColor = "#d97706";
                        break;
                    case 3: // Rose
                        boxGradient = "linear-gradient(135deg, #f43f5e, #e11d48)";
                        accentColor = "#e11d48";
                        break;
                    case 4: // Sky
                        boxGradient = "linear-gradient(135deg, #0ea5e9, #0284c7)";
                        accentColor = "#0284c7";
                        break;
                }

                <div class="card shadow-sm border-0 mb-3 mobile-card" id="card-@uniqueId" style="border-radius: 12px; overflow: hidden; transition: all 0.2s ease;">
                    <!-- Clickable Header -->
                    <div class="mobile-card-header p-3 d-flex align-items-center justify-content-between bg-white position-relative" 
                        onclick="toggleMobileCard('@uniqueId')"
                        style="border-left: 4px solid @accentColor;">
                        
                        <div class="d-flex align-items-center gap-3 flex-grow-1">
                            <!-- ID Box (Initial) -->
                            <div class="rounded-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                                style="width: 48px; height: 48px; background: @boxGradient; font-size: 1.25rem; flex-shrink: 0;">
                                @(item.Nombre?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            
                            <!-- Info -->
                            <div class="flex-grow-1" style="min-width: 0;">
                                <h6 class="mb-0 fw-bold text-dark text-truncate" style="font-size: 1rem;">
                                    @(item.Nombre ?? "Usuario")
                                </h6>
                                <div class="d-flex align-items-center mt-1 flex-wrap gap-2">
                                    <small class="text-muted" style="font-size: 0.8rem;">ID: @item.Id</small>
                                    
                                    <!-- Status Badge -->
                                    <span class="badge rounded-pill border d-none d-sm-inline-flex align-items-center px-2 py-0" 
                                        style="@(item.Estatus ? "background-color: #ecfdf5; color: #059669; border-color: #a7f3d0 !important;" : "background-color: #fef2f2; color: #ef4444; border-color: #fecaca !important;") font-weight: 600; height: 22px;">
                                        <i class="fas @(item.Estatus ? "fa-check" : "fa-ban") me-1" style="font-size: 0.7rem;"></i>
                                        @(item.Estatus ? "ACTIVO" : "INACTIVO")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Chevron -->
                        <div class="ms-3 text-muted">
                            <i class="fas fa-chevron-down rotate-icon" style="transition: transform 0.3s ease;"></i>
                        </div>
                    </div>

                    <!-- Expandable Content -->
                    <div class="expandable-content bg-light" id="body-@uniqueId" style="border-top: 1px solid var(--border-light);">
                        <div class="p-3">
                            <!-- XS Screen Status -->
                            <div class="d-block d-sm-none mb-3">
                                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 @(item.Estatus ? "bg-success-subtle border border-success-subtle" : "bg-danger-subtle border border-danger-subtle")">
                                    <span class="fw-semibold @(item.Estatus ? "text-success" : "text-danger")">Estado:</span>
                                    <span class="badge rounded-pill @(item.Estatus ? "bg-success" : "bg-danger")">
                                        @(item.Estatus ? "Activo" : "Inactivo")
                                    </span>
                                </div>
                            </div>

                            <!-- Details Grid -->
                            <div class="row g-2 mb-3">
                                <div class="col-12">
                                    <div class="p-2 bg-white border border-light rounded-3 shadow-sm">
                                        <small class="d-block text-muted mb-1" style="font-size: 0.7rem;">
                                            <i class="fas fa-envelope me-1"></i> Correo
                                        </small>
                                        <span class="fw-semibold text-dark small text-break">
                                            @(item.Correo ?? "-")
                                        </span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 bg-white border border-light rounded-3 shadow-sm h-100">
                                        <small class="d-block text-muted mb-1" style="font-size: 0.7rem;">
                                            <i class="fas fa-building me-1"></i> Depto
                                        </small>
                                        <span class="fw-semibold text-dark small">
                                            @(item.IdDepartamentoNavigation?.Descripcion ?? "-")
                                        </span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 bg-white border border-light rounded-3 shadow-sm h-100">
                                        <small class="d-block text-muted mb-1" style="font-size: 0.7rem;">
                                            <i class="fas fa-calendar-alt me-1"></i> Registro
                                        </small>
                                        <span class="fw-semibold text-dark small">
                                            @item.FechaCreacion.ToString("dd MMM yyyy")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="row g-2">
                                <div class="col-12">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-success w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm text-white">
                                        <i class="fas fa-eye"></i> Ver Detalle
                                    </a>
                                </div>
                                @if (User.HasClaim("TipoUsuario", "1"))
                                {
                                    <div class="col-6">
                                        <a asp-controller="Usuario" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm text-white">
                                            <i class="fas fa-pen"></i> Editar
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a href="#" class="btn btn-sm btn-danger w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm text-white"
                                        data-action="DeleteAjax" 
                                        data-controller="Usuario" 
                                        data-id="@item.Id">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="table-container fade-in mb-4">
            <div class="table-inner">
                <div class="overflow-x-auto">
                    <table class="data-table" style="width:100%; border: none; overflow: hidden; padding: 0;" aria-label="Tabla de usuarios">
                        <thead>
                            <tr>
                                <th class="text-center">ID</th>
                                <th class="text-center">Nombre</th>
                                <th class="text-center">Correo</th>
                                <th class="text-center">Departamento</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Fecha Creación</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.UsuariosPaginados)
                            {
                                <tr>
                                    <td class="text-center">@item.Id</td>
                                    <td><strong>@(item.Nombre ?? "-")</strong></td>
                                    <td>@(item.Correo ?? "-")</td>
                                    <td>@(item.IdDepartamentoNavigation?.Descripcion ?? "-")</td>
                                    <td class="text-center">
                                        <span class="badge-soft @(item.Estatus ? "badge-success-soft" : "badge-danger-soft")">
                                            @(item.Estatus ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div style="color: var(--text-medium); font-weight: 500;">
                                            <div style="font-size: 0.875rem;">@item.FechaCreacion.ToString("dd/MM/yyyy")</div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem;">@item.FechaCreacion.ToString("h:mm tt")</div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="flex justify-center gap-2">
                                            @if (User.HasClaim("TipoUsuario", "1"))
                                            {
                                                <a asp-controller="Usuario" asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Editar" aria-label="Editar usuario">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="#" class="action-btn btn-delete" title="Eliminar" aria-label="Eliminar usuario" data-action="DeleteAjax" data-controller="Usuario" data-id="@item.Id">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            }
                                            <a asp-action="Details" asp-route-id="@item.Id" class="action-btn btn-view" title="Ver detalles" aria-label="Ver detalles del usuario">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th class="text-center">ID</th>
                                <th class="text-center">Nombre</th>
                                <th class="text-center">Correo</th>
                                <th class="text-center">Departamento</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Fecha Creación</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- Shared Pagination (Now visible for both mobile and desktop) -->
        <div class="pagination-container fade-in">
            <div class="pagination-info">
                Mostrando @Model.UsuariosPaginados.FirstItemOnPage - @Model.UsuariosPaginados.LastItemOnPage de @Model.UsuariosPaginados.TotalItemCount usuarios
            </div>

            @Html.PagedListPager(
            Model.UsuariosPaginados,
                        page => Url.Action("Index", new
                        {
                            page,
                            sortOrder = ViewBag.CurrentSort,
                            nombreFilter = ViewBag.NombreFilter,
                            correoFilter = ViewBag.CorreoFilter,
                            departamentoFilter = ViewBag.DepartamentoFilter,
                            estadoFilter = ViewBag.EstadoFilter
                        }),
                        new PagedListRenderOptions
                        {
                            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                            DisplayLinkToLastPage = PagedListDisplayMode.Always,
                            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                            DisplayLinkToNextPage = PagedListDisplayMode.Always,
                            DisplayLinkToIndividualPages = true,
                            MaximumPageNumbersToDisplay = 5,
                            DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                            UlElementClasses = new[] { "pagination" },
                            LiElementClasses = new[] { "page-item" },
                            PageClasses = new[] { "page-link" }
                        })
        </div>
    }
    else
    {
        <div class="empty-state fade-in">
            <div class="empty-icon">
                <i class="fas fa-users"></i>
            </div>
            <h3>No hay usuarios registrados</h3>
            <p class="text-muted">Intenta ajustar los filtros de búsqueda</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        (function(){
            $(document).ready(function(){
                (function(){
                    var $select = $('#nombreFilter');
                    var valueMode = $select.data('user-value') || 'text';
                    $select.select2({
                        placeholder: 'Filtrar por nombre...',
                        minimumInputLength: 2,
                        allowClear: true,
                        ajax: {
                        url: '@Url.Action("SearchUsers", "Usuario")',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) { return { term: params.term }; },
                        processResults: function (data) {
                            var results = data.map(function(item){
                                return {
                                    id: valueMode === 'text' ? item.text : item.id,
                                    text: item.text,
                                    areaId: item.areaId
                                };
                            });
                            return { results: results };
                        },
                        cache: true
                    }
                    });

                    // Ensure hidden field exists
                    if ($('#nombreFilterHidden').length === 0) {
                        $('<input>').attr({ type: 'hidden', id: 'nombreFilterHidden', name: 'nombreFilter', value: '@ViewBag.NombreFilter' }).appendTo('#searchForm');
                    }
                    $select.on('select2:select', function(e) {
                        var data = e.params.data;
                        if (valueMode === 'text') $('#nombreFilterHidden').val(data.text);
                        else $('#nombreFilterHidden').val(data.id);
                    });
                    $select.on('select2:clear', function() { $('#nombreFilterHidden').val(''); });
                })();

                // Initialize Department Filter
                $('#departamentoFilter').select2({
                    placeholder: 'Todos los departamentos',
                    width: '100%',
                    allowClear: true,
                    // Optional: customize dropdown css class if needed
                });

                // Initialize Status Filter (disable search for cleaner look)
                $('#estadoFilter').select2({
                    placeholder: 'Todos los estados',
                    width: '100%',
                    allowClear: true,
                    minimumResultsForSearch: Infinity // Hide search box
                });

                $('#nombreFilter').on('focus', function () { $(this).select2('open'); });
                $('#nombreFilter').on('select2:open', function () { const sf = document.querySelector('.select2-container--open .select2-search__field'); if (sf) sf.focus(); });
            });
        })();
        document.addEventListener('DOMContentLoaded', function () {
            const elements = document.querySelectorAll('.fade-in, .slide-in-left');
            elements.forEach(element => {
                element.style.opacity = '0';
                element.style.transform = element.classList.contains('slide-in-left')
                    ? 'translateY(20px)'
                    : 'translateY(20px)';
            });

            setTimeout(() => {
                elements.forEach((element, index) => {
                    setTimeout(() => {
                        element.style.transition = 'all 0.6s ease-out';
                        element.style.opacity = '1';
                        element.style.transform = 'translate(0, 0)';
                    }, index * 150);
                });
            }, 100);
        });
    </script>
}