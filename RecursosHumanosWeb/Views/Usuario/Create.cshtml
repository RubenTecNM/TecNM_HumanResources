@model RecursosHumanosWeb.Models.ViewModels.Usuario.UsuarioCreateViewModel

@{
    ViewData["Title"] = "Crear Usuario";
    var tiposUsuario = ViewData["IdTipoUsuario"] as SelectList;
    var areas = ViewData["IdArea"] as SelectList;
    var departamentos = ViewData["IdDepartamento"] as SelectList;
    var puestos = ViewData["IdPuesto"] as SelectList;
}

@section Styles {
}

<div class="container fade-in">
    <div class="permission-header">
        <div class="header-content">
            <h1 class="page-title text-gradient">
            <i class="fas fa-user-plus"></i> 
                Crear Nuevo Usuario
            </h1>
         <p class="page-subtitle">Complete los campos para agregar un nuevo usuario al sistema</p>
        </div>
         <div class="header-decoration">
            <div class="floating-icon">
                <i class="fas fa-clipboard-check"></i>
            </div>
        </div>
    </div>

    <div class="card shadow-sm" style="padding: 40px; margin-bottom: 70px;">
        <div class="card-body">
            <form asp-action="Create" method="post" class="create-usuario-form">
                @Html.AntiForgeryToken()

                <!-- Información Personal -->
                <div class="section-card">
                    <h4 class="section-title">
                        <i class="fas fa-user"></i> Información Personal
                    </h4>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Nombre" class="form-label">
                                <i class="fas fa-id-card text-primary"></i> Nombre Completo
                            </label>
                            <input asp-for="Nombre" class="form-control rounded-pill shadow-sm" placeholder="Ingrese el nombre completo" style="height: 52px; border: 2px solid #ced4da;" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Correo" class="form-label">
                                <i class="fas fa-envelope text-primary"></i> Correo Electrónico
                            </label>
                            <input asp-for="Correo" class="form-control rounded-pill shadow-sm" type="email" placeholder="ejemplo@monclova.tecnm.mx" style="height: 52px; border: 2px solid #ced4da;" />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 form-group mb-3">
                            <label asp-for="Clave" class="form-label">
                                <i class="fas fa-lock text-primary"></i> Contraseña
                            </label>
                            <div class="position-relative">
                                <input asp-for="Clave" 
                                       class="form-control rounded-pill pe-5 shadow-sm" 
                                       type="password" 
                                       id="passwordInput" 
                                       placeholder="Ingrese una contraseña segura (mínimo 6 caracteres)" 
                                       style="height: 52px; border: 2px solid #ced4da;" />
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="togglePassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="progress mt-2 rounded-pill" style="height: 6px; background: #e2e8f0;">
                                <div id="password-strength" class="progress-bar transition-all" role="progressbar" style="width: 0%; border-radius: 50px;"></div>
                            </div>
                            <small class="form-text text-muted" id="password-hint">
                                <i class="fas fa-info-circle"></i> La contraseña será encriptada usando SHA-256 antes de almacenarse.
                            </small>
                            <span asp-validation-for="Clave" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Información Organizacional -->
                <div class="section-card">
                    <h4 class="section-title">
                        <i class="fas fa-building"></i> Información Organizacional
                    </h4>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="IdTipoUsuario" class="form-label">
                                <i class="fas fa-user-tag text-primary"></i> Tipo de Usuario
                            </label>
                            <select asp-for="IdTipoUsuario" class="form-select rounded-pill shadow-sm" asp-items="tiposUsuario" style="height: 52px; border: 2px solid #ced4da;">
                                <option value="">-- Seleccione un tipo de usuario --</option>
                            </select>
                            <span asp-validation-for="IdTipoUsuario" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="IdArea" class="form-label">
                                <i class="fas fa-map-marker-alt text-primary"></i> Área
                            </label>
                            <select asp-for="IdArea" class="form-select rounded-pill shadow-sm" asp-items="areas" style="height: 52px; border: 2px solid #ced4da;">
                                <option value="">-- Seleccione un área --</option>
                            </select>
                            <span asp-validation-for="IdArea" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="IdDepartamento" class="form-label">
                                <i class="fas fa-sitemap text-primary"></i> Departamento
                            </label>
                            <select asp-for="IdDepartamento" class="form-select rounded-pill shadow-sm" asp-items="departamentos" style="height: 52px; border: 2px solid #ced4da;">
                                <option value="">-- Seleccione un departamento --</option>
                            </select>
                            <span asp-validation-for="IdDepartamento" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="IdPuesto" class="form-label">
                                <i class="fas fa-briefcase text-primary"></i> Puesto
                            </label>
                            <select asp-for="IdPuesto" class="form-select rounded-pill shadow-sm" asp-items="puestos" style="height: 52px; border: 2px solid #ced4da;">
                                <option value="">-- Seleccione un puesto --</option>
                            </select>
                            <span asp-validation-for="IdPuesto" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- API Keys section removed -->

                <!-- Botones de Acción -->
                <div class="form-group mt-4 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Crear Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/Usuarios/create.js" asp-append-version="true"></script>
}