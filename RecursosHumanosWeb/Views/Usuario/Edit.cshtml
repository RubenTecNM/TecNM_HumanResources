@model RecursosHumanosWeb.Models.ViewModels.Usuario.UsuarioUpdateViewModel

@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Ensure select lists exist
    ViewBag.IdTipoUsuario = ViewBag.IdTipoUsuario ?? new SelectList(new List<SelectListItem>());
    ViewBag.IdArea = ViewBag.IdArea ?? new SelectList(new List<SelectListItem>());
    ViewBag.IdDepartamento = ViewBag.IdDepartamento ?? new SelectList(new List<SelectListItem>());
    ViewBag.IdPuesto = ViewBag.IdPuesto ?? new SelectList(new List<SelectListItem>());
}

@section Styles {
    <!-- Los estilos bases vienen de site.css. No se requiere CSS específico adicional por el momento -->
}

<div class="container fade-in">
    <div class="permission-header">
        <div class="header-content">
            <h1 class="page-title text-gradient">
                <i class="fas fa-user-edit"></i>
                Editar Usuario
            </h1>
            <p class="page-subtitle">Actualice la información del usuario @Model.Nombre</p>
        </div>
        <div class="header-decoration">
            <div class="floating-icon">
                <i class="fas fa-user-cog"></i>
            </div>
        </div>
    </div>

    <div class="card shadow-sm" style="padding: 40px; margin-bottom: 70px;">
        <div class="card-body">
            <form asp-action="Edit" method="post" class="edit-usuario-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdUsuario" />
                <input type="hidden" asp-for="Estatus" />

                <!-- Información Personal -->
                <div class="section-card">
                    <h4 class="section-title">
                        <i class="fas fa-user"></i> Información Personal
                    </h4>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Nombre" class="form-label">
                                <i class="fas fa-id-card text-primary"></i> Nombre Completo
                            </label>
                            <input asp-for="Nombre" class="form-control rounded-pill shadow-sm" placeholder="Ingrese el nombre completo" style="height: 52px; border: 2px solid #ced4da;" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Correo" class="form-label">
                                <i class="fas fa-envelope text-primary"></i> Correo Electrónico
                            </label>
                            <input asp-for="Correo" type="email" class="form-control rounded-pill shadow-sm" placeholder="ejemplo@monclova.tecnm.mx" style="height: 52px; border: 2px solid #ced4da;" />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 form-group mb-3">
                            <label asp-for="Clave" class="form-label">
                                <i class="fas fa-lock text-primary"></i> Nueva Contraseña <span class="text-muted fw-normal small">(Opcional)</span>
                            </label>
                            <div class="position-relative">
                                <input asp-for="Clave" 
                                       class="form-control rounded-pill pe-5 shadow-sm" 
                                       type="password" 
                                       id="passwordInput" 
                                       placeholder="Dejar vacío para mantener la actual" 
                                       style="height: 52px; border: 2px solid #ced4da;" />
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="togglePassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="progress mt-2 rounded-pill" style="height: 6px; background: #e2e8f0;">
                                <div id="password-strength" class="progress-bar transition-all" role="progressbar" style="width: 0%; border-radius: 50px;"></div>
                            </div>
                            <small class="form-text text-muted" id="password-hint">
                                <i class="fas fa-info-circle"></i> Ingrese solo si desea cambiar la contraseña. Mínimo 6 caracteres.
                            </small>
                            <span asp-validation-for="Clave" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <hr class="my-4 text-muted opacity-25">

                <!-- Información Organizacional -->
                <div class="section-card">
                    <h4 class="section-title">
                        <i class="fas fa-building"></i> Información Organizacional
                    </h4>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="IdTipoUsuario" class="form-label">
                                <i class="fas fa-user-tag text-primary"></i> Tipo de Usuario
                            </label>
                            <select asp-for="IdTipoUsuario" class="form-select rounded-pill shadow-sm" asp-items="ViewBag.IdTipoUsuario" style="height: 52px; border: 2px solid #ced4da;">
                                <option value="">-- Seleccione un tipo --</option>
                            </select>
                            <span asp-validation-for="IdTipoUsuario" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="IdArea" class="form-label">
                                <i class="fas fa-map-marker-alt text-primary"></i> Área
                            </label>
                            <select asp-for="IdArea" class="form-select rounded-pill shadow-sm" asp-items="ViewBag.IdArea" style="height: 52px; border: 2px solid #ced4da;">
                                <option value="">-- Seleccione un área --</option>
                            </select>
                            <span asp-validation-for="IdArea" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="IdDepartamento" class="form-label">
                                <i class="fas fa-sitemap text-primary"></i> Departamento
                            </label>
                            <select asp-for="IdDepartamento" class="form-select rounded-pill shadow-sm" asp-items="ViewBag.IdDepartamento" style="height: 52px; border: 2px solid #ced4da;">
                                <option value="">-- Seleccione un departamento --</option>
                            </select>
                            <span asp-validation-for="IdDepartamento" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="IdPuesto" class="form-label">
                                <i class="fas fa-briefcase text-primary"></i> Puesto
                            </label>
                            <select asp-for="IdPuesto" class="form-select rounded-pill shadow-sm" asp-items="ViewBag.IdPuesto" style="height: 52px; border: 2px solid #ced4da;">
                                <option value="">-- Seleccione un puesto --</option>
                            </select>
                            <span asp-validation-for="IdPuesto" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Botones de Acción -->
                <div class="form-group mt-5 d-flex justify-content-end gap-3">
                    <a asp-action="Index" class="btn btn-light border">
                        <i class="fas fa-arrow-left"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/Usuarios/edit.js" asp-append-version="true"></script>
}
