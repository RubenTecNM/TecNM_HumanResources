@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="text-center p-5 shadow-lg rounded-4 bg-white border" style="max-width: 500px; border-top: 5px solid var(--danger-color) !important;">
        <div class="mb-4">
            <i class="fas fa-user-lock fa-5x text-danger animate__animated animate__shakeX"></i>
        </div>
        <h2 class="fw-bold text-dark mb-3">Acceso Restringido</h2>
        <p class="text-muted mb-4" style="font-size: 1.1rem;">
            Lo sentimos, pero el sistema no reconoce los permisos necesarios en tu cuenta para acceder a este apartado.
        </p>
        <div class="d-grid gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i> Volver atrás
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background: var(--gradient-primary); border: none;">
                <i class="fas fa-home me-2"></i> Ir al Inicio
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/dist/sweetalert2.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Swal.fire({
                title: 'No Autorizado',
                text: 'No cuentas con el acceso requerido para este módulo.',
                icon: 'error',
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'Entendido',
                background: '#ffffff',
                customClass: {
                    popup: 'rounded-4 shadow-lg',
                    confirmButton: 'rounded-pill px-4'
                }
            });
        });
    </script>
}
