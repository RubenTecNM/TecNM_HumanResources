{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HumanResourcesContext": "Server=localhost,1433;Database=HumanResourcesProduction;Encrypt=False;TrustServerCertificate=True;"
  },
  "SmtpSettings": {
    "EmailSender": "controlpermisos@monclova.tecnm.mx",
    "SmtpServer": "smtp.office365.com",
    "SmtpPort": 587,
    "EnableSsl": true
  },
  "ResetPassword": {
    "TokenLifetimeMinutes": 20
  },
  "Security": {
    "LoginAttempts": {
      "MaxAttempts": 5,
      "ResetWindowMinutes": 15,
      "LockoutMinutes": 15
    }
  },
  "Evidences": {
    "UploadsPath": ""
  },
  "BusinessRules": {
    "Pagination": {
      "DefaultPageSize": 10,
      "MaxPageSize": 100
    },
    "Uploads": {
      "MaxFileSizeMB": 5
    }
  }
}